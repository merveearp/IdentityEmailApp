@using Microsoft.AspNetCore.Identity
@model List<IdentityRole>

@{
    ViewData["Title"] = "Rol Listesi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="data-table-area">
    <div class="container">

        <div class="row">
            <div class="col-lg-12">

                <div class="data-table-list">

                    <div class="basic-tb-hd">
                        <h2>Rol Listesi</h2>
                        <p>
                            Sistemde tanımlı kullanıcı rollerini görüntüleyebilir ve yönetebilirsiniz.
                        </p>
                    </div>

                    <div class="text-right" style="margin-bottom:20px;">
                        <a asp-action="CreateRole"
                               class="btn btn-success notika-btn-success">

                            <i class="fa fa-plus"></i>
                            Yeni Rol Ekle

                        </a>
                    </div>

                    <div class="table-responsive">

                        <table class="table table-striped table-hover">

                            <thead>
                                <tr>
                                    <th style="width:80px;">#</th>
                                    <th>Rol Adı</th>
                                    <th style="width:220px;">İşlemler</th>
                                </tr>
                            </thead>

                            <tbody>

                                @if (Model != null && Model.Any())
                                {
                                    int count = 0;

                                    foreach (var item in Model)
                                    {
                                        count++;

                                        <tr>

                                            <td>@count</td>

                                            <td>
                                                @item.Name
                                            </td>

                                            <td>

                                                <a href="/Role/UpdateRole/@item.Id"
                                                       class="btn btn-warning btn-sm">

                                                    <i class="fa fa-edit"></i>
                                                    Düzenle

                                                </a>

                                                <a href=/Role/DeleteRole/@item.Id"
                                                       class="btn btn-danger btn-sm">

                                                    <i class="fa fa-trash"></i>
                                                    Sil

                                                </a>

                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3"
                                            class="text-center"
                                            style="padding:40px;">

                                            <i class="fa fa-info-circle"></i>
                                            Sistemde henüz herhangi bir rol bulunmamaktadır.

                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>
        </div>

    </div>
</div>