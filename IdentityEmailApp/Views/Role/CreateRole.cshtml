@using IdentityEmailApp.Models.RoleModels
@model CreateRoleViewModel

@{
    ViewData["Title"] = "Yeni Rol Oluştur";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="form-element-area">
    <div class="container">

        <div class="row">
            <div class="col-lg-10 col-md-10 col-sm-12 col-xs-12">

                <div class="form-element-list">

                    <div class="basic-tb-hd">
                        <h2>Yeni Rol Oluştur</h2>
                        <p>
                            Sisteme yeni bir kullanıcı rolü ekleyebilirsiniz.
                        </p>
                    </div>

                    <form asp-action="CreateRole" method="post">

                        <div class="form-group">
                            <label asp-for="RoleName">
                                Rol Adı
                            </label>

                            <div class="nk-int-st">
                                <input asp-for="RoleName"
                                       class="form-control"
                                       placeholder="Örn: Admin" />
                            </div>

                            <span asp-validation-for="RoleName"
                                  class="text-danger"></span>
                        </div>

                        <div class="mt-3">

                            <button type="submit"
                                    class="btn btn-success notika-btn-success">

                                <i class="fa fa-save"></i>
                                Rolü Kaydet

                            </button>

                            <a asp-action="RoleList"
                                   class="btn btn-default">

                                <i class="fa fa-arrow-left"></i>
                                Rol Listesine Dön

                            </a>

                        </div>

                    </form>

                </div>

            </div>
        </div>

    </div>
</div>

