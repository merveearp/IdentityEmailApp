@model LoginUserViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Login | Notika Mail</title>
    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    <!-- Google Fonts: Roboto -->
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&amp;display=swap" rel="stylesheet">
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
        darkMode: "class",
        theme: {
        extend: {
        "colors": {
        "background": "#f7faf9",
        "on-error-container": "#93000a",
        "on-error": "#ffffff",
        "text-muted": "#777777",
        "on-tertiary": "#ffffff",
        "surface-container-high": "#e6e9e8",
        "on-primary": "#ffffff",
        "surface-variant": "#e0e3e2",
        "on-surface": "#181c1c",
        "input-border": "#e1e1e1",
        "secondary": "#4e6073",
        "on-secondary-fixed": "#091d2e",
        "secondary-container": "#cfe2f9",
        "surface-bright": "#f7faf9",
        "secondary-fixed": "#d1e4fb",
        "on-primary-container": "#004935",
        "surface": "#f7faf9",
        "on-secondary": "#ffffff",
        "surface-container-low": "#f1f4f3",
        "error": "#ba1a1a",
        "primary-fixed-dim": "#41dfac",
        "on-secondary-container": "#526478",
        "inverse-on-surface": "#eef1f0",
        "tertiary": "#9f412a",
        "outline": "#6c7a73",
        "surface-container-highest": "#e0e3e2",
        "text-main": "#333333",
        "outline-variant": "#bbcac1",
        "on-secondary-fixed-variant": "#36485b",
        "inverse-primary": "#41dfac",
        "on-surface-variant": "#3c4a43",
        "on-background": "#181c1c",
        "primary-container": "#00c292",
        "error-container": "#ffdad6",
        "inverse-surface": "#2d3131",
        "on-tertiary-container": "#75220f",
        "surface-container": "#ebeeed",
        "secondary-fixed-dim": "#b5c8df",
        "surface-tint": "#006c50",
        "primary-fixed": "#65fcc7",
        "surface-glass": "rgba(255, 255, 255, 0.8)",
        "on-primary-fixed-variant": "#00513b",
        "tertiary-fixed-dim": "#ffb4a3",
        "on-tertiary-fixed": "#3d0700",
        "on-tertiary-fixed-variant": "#7f2a16",
        "on-primary-fixed": "#002116",
        "surface-container-lowest": "#ffffff",
        "tertiary-fixed": "#ffdad2",
        "tertiary-container": "#ff8a6e",
        "surface-dim": "#d7dbda",
        "primary": "#006c50"
        },
        "borderRadius": {
        "DEFAULT": "0.25rem",
        "lg": "0.5rem",
        "xl": "0.75rem",
        "full": "9999px"
        },
        "spacing": {
        "md": "24px",
        "base": "8px",
        "max-width-auth": "420px",
        "margin-desktop": "32px",
        "gutter": "24px",
        "xl": "64px",
        "xs": "4px",
        "sm": "12px",
        "lg": "48px",
        "margin-mobile": "16px"
        },
        "fontFamily": {
        "body-lg": ["Roboto"],
        "headline-lg": ["Roboto"],
        "headline-lg-mobile": ["Roboto"],
        "label-md": ["Roboto"],
        "title-md": ["Roboto"],
        "display-lg": ["Roboto"],
        "body-sm": ["Roboto"]
        },
        "fontSize": {
        "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
        "headline-lg": ["32px", {"lineHeight": "40px", "fontWeight": "700"}],
        "headline-lg-mobile": ["24px", {"lineHeight": "32px", "fontWeight": "700"}],
        "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "700"}],
        "title-md": ["20px", {"lineHeight": "28px", "fontWeight": "500"}],
        "display-lg": ["48px", {"lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
        "body-sm": ["14px", {"lineHeight": "20px", "fontWeight": "400"}]
        }
        }
        }
        }
    </script>
    <style>
        .notika-icon {
        font-family: 'Material Symbols Outlined';
        font-weight: normal;
        font-style: normal;
        font-size: 20px;
        line-height: 1;
        letter-spacing: normal;
        text-transform: none;
        display: inline-block;
        white-space: nowrap;
        word-wrap: normal;
        direction: ltr;
        -webkit-font-feature-settings: 'liga';
        -webkit-font-smoothing: antialiased;
        }
        .notika-support:before { content: "person"; }
        .notika-mail:before { content: "alternate_email"; }
        .notika-edit:before { content: "lock"; }
        .notika-right-arrow:before { content: "arrow_forward"; }

        .waves-effect {
        position: relative;
        overflow: hidden;
        transform: translate3d(0, 0, 0);
        }
        .waves-effect:after {
        content: "";
        display: block;
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        pointer-events: none;
        background-image: radial-gradient(circle, #fff 10%, transparent 10.01%);
        background-repeat: no-repeat;
        background-position: 50%;
        transform: scale(10, 10);
        opacity: 0;
        transition: transform .5s, opacity 1s;
        }
        .waves-effect:active:after {
        transform: scale(0, 0);
        opacity: .3;
        transition: 0s;
        }

        .premium-shadow {
        box-shadow: 0 15px 35px -5px rgba(0, 0, 0, 0.07), 0 5px 15px -5px rgba(0, 0, 0, 0.04);
        }

        @@keyframes float {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
        100% { transform: translateY(0px); }
        }
        .floating {
        animation: float 4s ease-in-out infinite;
        }

        .nk-block {
        transition: all 0.4s ease;
        }
        .nk-int-st input {
        border: none;
        border-bottom: 1px solid #e1e1e1;
        border-radius: 0;
        padding-left: 0;
        transition: all 0.3s ease;
        }
        .nk-int-st input:focus {
        border-bottom-color: #00c292;
        box-shadow: none;
        }
        .btn-float {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        line-height: 45px;
        text-align: center;
        position: absolute;
        right: -25px;
        bottom: -25px;
        font-size: 20px;
        z-index: 10;
        }
        .glass-panel {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        }
    </style>
</head>
<body class="bg-background text-on-background font-body-lg overflow-hidden h-screen">
    <main class="flex h-full w-full">
        <!-- Left Side: Login Form -->
        <section class="w-full md:w-1/2 h-full flex flex-col bg-surface-container-low overflow-y-auto">
            <!-- Mobile Logo Header -->
            <div class="md:hidden flex items-center px-gutter py-md">
                <span class="material-symbols-outlined text-primary text-headline-lg-mobile mr-xs" style="font-variation-settings: 'FILL' 1;">mail</span>
                <span class="font-headline-lg-mobile text-headline-lg-mobile font-bold text-primary">Notika Mail</span>
            </div>
            <div class="flex-grow flex items-center justify-center p-gutter">
                <div class="w-full max-w-max-auth">
                    <!-- Heading -->
                    <div class="mb-lg text-center md:text-left">
                        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-xs">Welcome Back</h2>
                        <p class="font-body-lg text-body-lg text-text-muted">Sign in to continue to Notika Productivity.</p>
                    </div>
                    <!-- Notika Block Login -->
                    <div class="nk-block relative bg-surface-container-lowest premium-shadow border border-input-border rounded-xl p-lg" id="l-login">
                        <form class="space-y-md" method="post">
                              <div asp-validation-summary="ModelOnly"
                             class="bg-red-50 border border-red-200 text-red-600 text-sm rounded-lg px-4 py-3 mb-4">
                        </div>
                            <!-- Username Field -->
                            <div class="input-group flex items-end space-x-md group">
                                <span class="pb-2 flex items-center justify-center text-text-muted group-focus-within:text-primary transition-colors">
                                    <i class="notika-icon notika-support"></i>
                                </span>

                              
                                <div class="nk-int-st flex-grow">
                                    <label class="font-label-md text-label-md text-secondary block uppercase tracking-wider mb-xs">Kullanıcı Adı / Email</label>
                                   <input asp-for="UsernameOrEmail"
                                       class="w-full py-2 bg-transparent text-body-lg focus:outline-none placeholder:text-outline/50"
                                       placeholder="Kullanıcı Adı veya Email"
                                       type="text">
                                       <span asp-validation-for="UsernameOrEmail" class="text-red-500 text-xs"></span>
                                </div>
                            </div>
                            <!-- Password Field -->
                            <div class="input-group flex items-end space-x-md group">
                                <span class="pb-2 flex items-center justify-center text-text-muted group-focus-within:text-primary transition-colors">
                                    <i class="notika-icon notika-edit"></i>
                                </span>
                                <div class="nk-int-st flex-grow">
                                    <label class="font-label-md text-label-md text-secondary block uppercase tracking-wider mb-xs">Şifre</label>
                                    <input  asp-for="Password"  class="w-full py-2 bg-transparent text-body-lg focus:outline-none placeholder:text-outline/50"placeholder="Password" type="password">
                                </div>
                                <span asp-validation-for="Password" class="text-red-500 text-xs"></span>
                            </div>
                            <!-- Extra Options -->
                            <div class="flex items-center justify-between mt-md">
                                <div class="flex items-center space-x-2">
                                    <input asp-for="RememberMe" class="w-4 h-4 border-input-border rounded text-primary focus:ring-primary/20" id="remember" type="checkbox">
                                    <label class="font-body-sm text-body-sm text-on-surface-variant cursor-pointer" for="remember">Beni HATIRLA</label>
                                </div>
                                <a class="font-body-sm text-body-sm text-text-muted hover:text-primary transition-colors" asp-controller="Password" asp-action="ForgotPassword">Şifreni Mi Unuttun?</a>
                            </div>
                            <!-- Notika Signature Button Flow -->
                            <button type="submit" class="btn-float waves-effect bg-primary text-white shadow-lg hover:scale-110 active:scale-95 transition-all flex items-center justify-center">
                                <i class="notika-icon notika-right-arrow"></i>
                            </button>
                        </form>
                        <!-- Divider & Navigation -->
                        <div class="mt-xl pt-md border-t border-input-border">
                          
                            <div class="nk-navigation rg-ic-stl mt-lg flex flex-col items-center gap-sm">
                                <p class="text-center font-body-sm text-body-sm text-text-muted">
                                    Henüz Hesabın Yok Mu?
                                    <a class="text-primary font-bold hover:underline ml-xs flex items-center justify-center gap-1 inline-flex" asp-controller="Register" asp-action="Signup">
                                        <i class="notika-icon notika-right-arrow !text-[12px]"></i> Kayıt Ol
                                    </a>
                                </p>
                            </div>
                        </div>
                    </div>
                    <!-- Footer Info -->
                    <div class="mt-xl text-center md:text-left flex flex-wrap justify-center md:justify-start gap-md opacity-60">
                        <span class="font-body-sm text-body-sm text-text-muted">© 2024 Notika Productivity</span>
                        <a class="font-body-sm text-body-sm text-text-muted hover:text-primary transition-colors" href="#">Privacy</a>
                        <a class="font-body-sm text-body-sm text-text-muted hover:text-primary transition-colors" href="#">Terms</a>
                        <a class="font-body-sm text-body-sm text-text-muted hover:text-primary transition-colors" href="#">Security</a>
                    </div>
                </div>
            </div>
        </section>
        <!-- Right Side: Split-screen branding (Flipped and Updated with Image 11) -->
        <section class="hidden md:flex relative w-1/2 h-full items-center justify-center overflow-hidden bg-primary" style="background-image: url('https://lh3.googleusercontent.com/aida/AP1WRLsOnY5mf3COo5010Imi2nMdmCyTUFerXBqv7_oS3e-2xB-DXeCl_e5LjW4R4ucaljOjyHMSmfD0TSRF_9X2FIqj7suLxCNwgFM0HKt1bnKxRUC-riSMl-11HANxmJ2BTiyB4i2P84HHeMQvavBejFHLFfw3ME_28Vq6jgtEWNsJGLz-0BS1I-xv4Pa8Pg2cmXn5bpZw4-IZvaOgui7swILx1IAv4SQXaKOdtb9ZwG5nYBmj0W8cW06BBy0'); background-size: cover; background-position: center;">
            <div class="absolute inset-0 bg-primary/20 backdrop-brightness-50"></div>
            <div class="relative z-10 flex flex-col items-center text-center px-lg">
                <div class="floating mb-md">
                    <div class="w-32 h-32 rounded-full glass-panel flex items-center justify-center shadow-2xl">
                        <span class="material-symbols-outlined text-white text-[64px]" style="font-variation-settings: 'FILL' 1;">mail</span>
                    </div>
                </div>
                <h1 class="font-display-lg text-display-lg text-white mb-sm drop-shadow-lg">Notika Mail</h1>
                <p class="font-title-md text-title-md text-white/90 max-w-md drop-shadow-md">
                    Precision productivity meets modern design. Experience the fastest way to manage your communication.
                </p>
                <div class="mt-xl">
                    <div class="glass-panel px-lg py-md rounded-2xl">
                        <p class="font-label-md text-white/80 uppercase tracking-[0.2em]">High Performance Journey</p>
                    </div>
                </div>
            </div>
            <!-- Abstract decorative visual elements -->
            <div class="absolute top-1/4 -right-20 w-64 h-64 bg-primary-container/20 rounded-full blur-3xl"></div>
            <div class="absolute bottom-1/4 -left-20 w-80 h-80 bg-secondary-fixed/10 rounded-full blur-3xl"></div>
        </section>
    </main>
    <!-- Status Pill Decor -->
    <div class="fixed top-gutter right-gutter z-50">
        <div class="glass-card px-md py-sm rounded-full flex items-center space-x-sm shadow-lg backdrop-blur-md bg-white/80 border border-input-border">
            <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
            <span class="font-label-md text-label-md text-on-surface">System Online</span>
        </div>
    </div>
    <script>
        document.querySelectorAll('input').forEach(input => {
        input.addEventListener('focus', () => {
        input.closest('.nk-int-st').classList.add('active');
        });
        input.addEventListener('blur', () => {
        input.closest('.nk-int-st').classList.remove('active');
        });
        });
    </script>
</body></html>