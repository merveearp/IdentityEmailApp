<style>
        
        .notika-icon {
            font-family: 'Material Symbols Outlined';
            font-weight: normal;
            font-style: normal;
            font-size: 20px;
            line-height: 1;
            letter-spacing: normal;
            text-transform: none;
            display: inline-block;
            white-space: nowrap;
            word-wrap: normal;
            direction: ltr;
            -webkit-font-feature-settings: 'liga';
            -webkit-font-smoothing: antialiased;
        }
        .notika-support:before { content: "person"; }
        .notika-mail:before { content: "alternate_email"; }
        .notika-edit:before { content: "lock"; }
        .notika-right-arrow:before { content: "arrow_forward"; }
        .notika-plus-symbol:before { content: "add"; }

        .waves-effect {
            position: relative;
            overflow: hidden;
            transform: translate3d(0, 0, 0);
        }
        .waves-effect:after {
            content: "";
            display: block;
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            pointer-events: none;
            background-image: radial-gradient(circle, #fff 10%, transparent 10.01%);
            background-repeat: no-repeat;
            background-position: 50%;
            transform: scale(10, 10);
            opacity: 0;
            transition: transform .5s, opacity 1s;
        }
        .waves-effect:active:after {
            transform: scale(0, 0);
            opacity: .3;
            transition: 0s;
        }

        .premium-shadow {
            box-shadow: 0 15px 35px -5px rgba(0, 0, 0, 0.07), 0 5px 15px -5px rgba(0, 0, 0, 0.04);
        }

        @@keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
            100% { transform: translateY(0px); }
        }
        .floating {
            animation: float 4s ease-in-out infinite;
        }

        /* Notika Transition Elements */
        .nk-block {
            transition: all 0.4s ease;
        }
        .nk-int-st input {
            border: none;
            border-bottom: 1px solid #e1e1e1;
            border-radius: 0;
            padding-left: 0;
            transition: all 0.3s ease;
        }
        .nk-int-st input:focus {
            border-bottom-color: #00c292;
            box-shadow: none;
        }
        .btn-float {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            line-height: 45px;
            text-align: center;
            position: absolute;
            right: -25px;
            bottom: -25px;
            font-size: 20px;
            z-index: 10;
        }
 
    .password-wrapper{
        position:relative;
    }

    .password-wrapper input{
        padding-right:40px;
    }

    .toggle-password{
        position:absolute;
        right:0;
        top:50%;
        transform:translateY(-50%);
        background:none;
        border:none;
        cursor:pointer;
        color:#777;
        padding:0;
    }

    .toggle-password:hover{
        color:#00c292;
    }


    </style>

</head>
<body class="bg-background text-on-background font-body-lg overflow-hidden h-screen">
<main class="flex h-full w-full">
<!-- Left Side: Split-screen branding -->
<section class="hidden md:flex relative w-1/2 h-full items-center justify-center overflow-hidden bg-primary" style="background-image: url(&quot;https://lh3.googleusercontent.com/aida-public/AB6AXuAD_bdbPjL1AZvP4ATHH3dcIrfok9kwrVYd7iox2vLlIg0xri4cO23-rtraWAqFuWF8OKiSBTgzPzTBMby6ps1GHsWauD8M_0AHH1ghYfh2CURsEltJwR0_A_bKizwsO8nuUCWs-ue5cS5_7IE_YhYh7qK2lMxhLS6h8K41pJdlzq2a1ONikkWz2KDeswBR59-8dKTIEjJxmGdXUi8dla_T30vaipMDEdB9FMvRJf2sqCAYzjvxbnWs8t8rbKYTpjb98sEOO-A0XmpU&quot;); background-size: cover; background-position: center center;">
<div class="relative z-10 flex flex-col items-center text-center px-lg">
<div class="floating mb-md">
<div class="w-32 h-32 rounded-full bg-white/20 flex items-center justify-center backdrop-blur-md border border-white/30 shadow-xl">
<span class="material-symbols-outlined text-white text-[64px]" style="font-variation-settings: &quot;FILL&quot; 1;">mail</span>
</div>
</div>
<h1 class="font-display-lg text-display-lg text-white mb-sm">Notika Mail</h1>
<p class="font-title-md text-title-md text-white/80 max-w-md">
    Join the future. High-performance mail for professionals. </p>

<!-- Abstract visual elements -->
</div>
<!-- Bottom decorative image -->
</section>
<!-- Right Side: Registration Form -->
<section class="w-full md:w-1/2 h-full flex flex-col bg-surface-container-low overflow-y-auto">
<!-- Mobile Logo Header -->
<div class="md:hidden flex items-center px-gutter py-md">
<span class="material-symbols-outlined text-primary text-headline-lg-mobile mr-xs" style="font-variation-settings: &quot;FILL&quot; 1;">mail</span>
<span class="font-headline-lg-mobile text-headline-lg-mobile font-bold text-primary">Notika Mail</span>
</div>
<div class="flex-grow flex items-center justify-center p-gutter">
<div class="w-full max-w-max-auth">
<!-- Heading -->
<div class="mb-lg text-center md:text-left">
<h2 class="font-headline-lg text-headline-lg text-on-surface mb-xs">Hesap Oluştur</h2>
<p class="font-body-lg text-body-lg text-text-muted">Hesabınızı oluşturun ve Notika Mail deneyimine hemen başlayın.</p>
</div>
<!-- Notika Block Register -->

<div class="nk-block relative bg-surface-container-lowest premium-shadow border border-input-border rounded-xl p-lg" id="l-register">

<div asp-validation-summary="ModelOnly" class="text-red-500 text-sm mb-4"></div>

<form asp-controller="Register" asp-action="Signup" method="post" class="space-y-md">

    <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
        <div class="input-group flex items-end space-x-md group">
            <span class="pb-2 text-text-muted group-focus-within:text-primary">
                <i class="notika-icon notika-support"></i>
            </span>
            <div class="nk-int-st flex-grow">
                <label class="font-label-md text-label-md text-secondary block uppercase mb-xs">İsim</label>
                <input asp-for="Name" class="w-full py-2 bg-transparent text-body-lg focus:outline-none" placeholder="Name" />
                <span asp-validation-for="Name" class="text-red-500 text-xs"></span>
            </div>
        </div>

        <div class="input-group flex items-end space-x-md group">
            <span class="pb-2 text-text-muted group-focus-within:text-primary">
                <i class="notika-icon notika-support"></i>
            </span>
            <div class="nk-int-st flex-grow">
                <label class="font-label-md text-label-md text-secondary block uppercase mb-xs">Soyisim</label>
                <input asp-for="Surname" class="w-full py-2 bg-transparent text-body-lg focus:outline-none" placeholder="Surname" />
                <span asp-validation-for="Surname" class="text-red-500 text-xs"></span>
            </div>
        </div>
    </div>

    <div class="input-group flex items-end space-x-md group">
        <span class="pb-2 text-text-muted group-focus-within:text-primary">
            <i class="notika-icon notika-support"></i>
        </span>
        <div class="nk-int-st flex-grow">
            <label class="font-label-md text-label-md text-secondary block uppercase mb-xs">Kullanıcı Adı</label>
            <input asp-for="Username" class="w-full py-2 bg-transparent text-body-lg focus:outline-none" placeholder="Username" />
            <span asp-validation-for="Username" class="text-red-500 text-xs"></span>
        </div>
    </div>

    <div class="input-group flex items-end space-x-md group">
        <span class="pb-2 text-text-muted group-focus-within:text-primary">
            <i class="notika-icon notika-mail"></i>
        </span>
        <div class="nk-int-st flex-grow">
            <label class="font-label-md text-label-md text-secondary block uppercase mb-xs">Email Adresi </label>
            <input asp-for="Email" type="email" class="w-full py-2 bg-transparent text-body-lg focus:outline-none" placeholder="Email Address" />
            <span asp-validation-for="Email" class="text-red-500 text-xs"></span>
        </div>
    </div>

   <div class="input-group flex items-end space-x-md group">
    <span class="pb-2 text-text-muted group-focus-within:text-primary">
        <i class="notika-icon notika-edit"></i>
    </span>

    <div class="nk-int-st flex-grow">
        <label class="font-label-md text-label-md text-secondary block uppercase mb-xs">
            Şifre
        </label>

        <div class="password-wrapper">
            <input asp-for="Password"
                   id="Password"
                   type="password"
                   class="w-full py-2 bg-transparent text-body-lg focus:outline-none"
                   placeholder="Password" />

            <button type="button"
                    class="toggle-password"
                    onclick="togglePassword('Password',this)">
                <span class="material-symbols-outlined">visibility</span>
            </button>
        </div>

        <span asp-validation-for="Password" class="text-red-500 text-xs"></span>
    </div>
</div>

   <div class="input-group flex items-end space-x-md group">
    <span class="pb-2 text-text-muted group-focus-within:text-primary">
        <i class="notika-icon notika-edit"></i>
    </span>

    <div class="nk-int-st flex-grow">
        <label class="font-label-md text-label-md text-secondary block uppercase mb-xs">
            Şifre Tekrar
        </label>

        <div class="password-wrapper">
            <input asp-for="ConfirmPassword"
                   id="ConfirmPassword"
                   type="password"
                   class="w-full py-2 bg-transparent text-body-lg focus:outline-none"
                   placeholder="Confirm Password" />

            <button type="button"
                    class="toggle-password"
                    onclick="togglePassword('ConfirmPassword',this)">
                <span class="material-symbols-outlined">visibility</span>
            </button>
        </div>

        <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs"></span>
    </div>
</div>
    

    <div class="pt-5">

    <button type="submit"
            class="w-full flex items-center justify-center gap-2 bg-primary text-white py-3 rounded-xl shadow-lg hover:scale-[1.02] transition-all duration-300">

        <i class="material-symbols-outlined">person_add</i>

        <span>Kayıt Ol</span>

    </button>

</div>

</form>
<!-- Divider & Navigation -->
<div class="mt-xl pt-md border-t border-input-border"><div class="nk-navigation rg-ic-stl mt-lg flex flex-col items-center gap-sm">
    <p class="text-center font-body-sm text-body-sm text-text-muted">Zaten Hesabınız Var mı ? <a class="text-primary font-bold hover:underline ml-xs flex items-center justify-center gap-1 inline-flex" asp-controller="Login" asp-action="SignIn"><i class="notika-icon notika-right-arrow !text-[12px]"></i> Giriş Yap</a></p></div></div></div>
<!-- Footer Info -->
<div class="mt-xl text-center md:text-left flex flex-wrap justify-center md:justify-start gap-md opacity-60">
<span class="font-body-sm text-body-sm text-text-muted">© 2024 Notika Productivity</span>
<a class="font-body-sm text-body-sm text-text-muted hover:text-primary transition-colors" href="#">Privacy</a>
<a class="font-body-sm text-body-sm text-text-muted hover:text-primary transition-colors" href="#">Terms</a>
<a class="font-body-sm text-body-sm text-text-muted hover:text-primary transition-colors" href="#">Security</a>
</div>
</div>
</div>
</section>
</main>
<!-- Status Pill Decor -->
<div class="fixed top-gutter right-gutter z-50">
<div class="glass-card px-md py-sm rounded-full flex items-center space-x-sm shadow-lg backdrop-blur-md bg-white/80 border border-input-border"><div class="flex items-center space-x-sm">
  <span class="relative flex h-2 w-2">
    <span class="animate-pulse absolute inline-flex h-full w-full rounded-full bg-primary-container opacity-75"></span>
    <span class="relative inline-flex rounded-full h-2 w-2 bg-primary-container"></span>
  </span>
  <div class="flex flex-col">
    <span class="font-label-md text-label-md text-on-surface leading-none">SERVER STATUS</span>
    <span class="text-[10px] font-bold text-primary uppercase tracking-tighter">High Performance Online</span>
  </div>
</div></div>
</div>
<script>
     
        document.querySelectorAll('input').forEach(input => {
            input.addEventListener('focus', () => {
                input.closest('.nk-int-st').classList.add('active');
            });
            input.addEventListener('blur', () => {
                input.closest('.nk-int-st').classList.remove('active');
            });
        });
    </script>

    <script>
    function togglePassword(inputId, button) {

        const input = document.getElementById(inputId);
        const icon = button.querySelector("span");

        if (input.type === "password") {
            input.type = "text";
            icon.textContent = "visibility_off";
        } else {
            input.type = "password";
            icon.textContent = "visibility";
        }
    }
</script>




</body></html>