<style>
        body { font-family: 'Roboto', sans-serif; background-color: #f7faf9; overflow: hidden; }
        .glass-panel {
            backdrop-filter: blur(16px) saturate(180%);
            -webkit-backdrop-filter: blur(16px) saturate(180%);
            background-color: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        .ripple-btn {
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
        }
        .ripple-btn:active {
            transform: scale(0.98);
        }
        .status-dot {
            width: 8px;
            height: 8px;
            background-color: #41dfac;
            border-radius: 50%;
            box-shadow: 0 0 10px #41dfac;
            animation: pulse 2s infinite;
        }
        @@keyframes pulse {
            0% { opacity: 0.4; }
            50% { opacity: 1; }
            100% { opacity: 0.4; }
        }
    </style>
</head>
<body class="h-screen w-full flex flex-col md:flex-row">
<!-- Left Side: Image Section -->
<section class="hidden md:flex md:w-1/2 relative h-full flex-col items-center justify-center text-white overflow-hidden bg-primary overflow-hidden">
<div class="absolute inset-0 z-0">
<img alt="Background" class="w-full h-full object-cover opacity-60 scale-105" src="https://lh3.googleusercontent.com/aida/AP1WRLts7b-a1IIGuaG8lJR3zBseR6acR12LAw6q9W56BdBAPzTSVx0xwEw_-qDaTU8InZMEdoWLCIFMVPGYHD21L83YX-lyhbnVIVHduDaPnXPleQ-17VnEFNeFmBsCrwpLl6j5zSm4eqF-86x-mw5ud0z-fqqzSsxKmK-1s5_bt-eSRicqj4IKc73XnvYoRvfmCHkoDLwnnoPCanTDZuNJXNl2ZwYO3ufT4gzhG4wFjhvShTyaJpcqShxi-K0"/>
<!-- Overlay Gradient -->
<div class="absolute inset-0 bg-gradient-to-tr from-primary/80 via-transparent to-transparent"></div>
</div>
<div class="relative z-10 glass-panel px-lg py-xl rounded-xl flex flex-col items-center text-center max-w-md mx-margin-desktop shadow-2xl">
<div class="mb-md flex items-center gap-sm">
<span class="material-symbols-outlined text-display-lg" style="font-variation-settings: 'FILL' 1;">mail</span>
<span class="font-headline-lg text-headline-lg font-black tracking-tight">Notika Mail</span>
</div>
<h1 class="font-headline-lg text-headline-lg mb-sm">Erişim Engellendi</h1>
<p class="font-body-lg text-body-lg text-on-primary/90 opacity-90">Bu sayfayı görüntülemek için yetkiniz bulunmuyor.</p>
<!-- Atmospheric floating cards -->
<div class="mt-xl flex gap-md opacity-30 pointer-events-none">
<div class="w-16 h-20 bg-white/20 rounded-lg animate-bounce" style="animation-delay: 0.1s"></div>
<div class="w-16 h-24 bg-white/20 rounded-lg animate-bounce" style="animation-delay: 0.3s"></div>
<div class="w-16 h-16 bg-white/20 rounded-lg animate-bounce" style="animation-delay: 0.5s"></div>
</div>
</div>
</section>
<!-- Right Side: Content Section -->
<main class="w-full md:w-1/2 h-full bg-surface-container-lowest flex flex-col items-center justify-center relative p-margin-mobile md:p-margin-desktop">
<!-- Top Status Indicator -->
<div class="absolute top-margin-desktop right-margin-desktop flex items-center gap-xs">
<div class="status-dot"></div>
<span class="font-label-md text-label-md text-on-surface-variant uppercase tracking-widest">System Online</span>
</div>
<!-- Mobile Logo (Visible only on mobile) -->
<div class="md:hidden mb-lg flex items-center gap-xs text-primary">
<span class="material-symbols-outlined text-headline-lg" style="font-variation-settings: 'FILL' 1;">mail</span>
<span class="font-headline-lg-mobile text-headline-lg-mobile font-black">Notika Mail</span>
</div>
<div class="max-w-max-width-auth w-full text-center flex flex-col items-center">
<!-- 401 Indicator -->
<div class="w-20 h-20 rounded-full bg-error-container flex items-center justify-center mb-md shadow-sm">
<span class="material-symbols-outlined text-error text-4xl" style="font-variation-settings: 'FILL' 0;">lock_person</span>
</div>
<h2 class="font-headline-lg text-headline-lg md:text-display-lg text-on-surface mb-md">Yetkisiz Erişim (401)</h2>
<p class="font-body-lg text-body-lg text-on-surface-variant mb-xl leading-relaxed">
                Üzgünüz, bu alana erişmek için gerekli izinlere sahip değilsiniz. Lütfen giriş yapın veya sistem yöneticinizle iletişime geçin.
            </p>
<!-- Actions -->
<div class="flex flex-col gap-md w-full">
<a class="ripple-btn bg-primary text-on-primary font-label-md text-label-md py-md rounded-lg flex items-center justify-center gap-sm shadow-md hover:bg-primary/90 transition-all" asp-controller="Login" asp-action="SignIn">

                    Giriş Yap
                </a>
<a class="ripple-btn border border-outline-variant text-on-surface-variant font-label-md text-label-md py-md rounded-lg flex items-center justify-center gap-sm hover:bg-surface-container-low transition-all" asp-controller="Reigster" asp-action="Signup">

                    Kayıt Ol
                </a>
</div>
</div>


</main>
<!-- Interactive Micro-interactions -->
<script>
        document.querySelectorAll('.ripple-btn').forEach(button => {
            button.addEventListener('mousedown', function(e) {
                const rect = this.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                
                const ripple = document.createElement('span');
                ripple.style.position = 'absolute';
                ripple.style.width = '100px';
                ripple.style.height = '100px';
                ripple.style.background = 'rgba(255, 255, 255, 0.3)';
                ripple.style.borderRadius = '50%';
                ripple.style.left = `${x - 50}px`;
                ripple.style.top = `${y - 50}px`;
                ripple.style.transform = 'scale(0)';
                ripple.style.transition = 'transform 0.5s ease-out, opacity 0.5s ease-out';
                ripple.style.pointerEvents = 'none';
                
                this.appendChild(ripple);
                
                requestAnimationFrame(() => {
                    ripple.style.transform = 'scale(4)';
                    ripple.style.opacity = '0';
                });
                
                setTimeout(() => ripple.remove(), 500);
            });
        });
    </script>
</body></html>