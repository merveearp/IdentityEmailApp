
@{
    Layout = "~/Views/News/Layout.cshtml";
}


<main class="max-w-[1440px] mx-auto px-margin-mobile md:px-margin-desktop py-xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">


        <!-- Main Content Column -->

        <div class="lg:col-span-8 space-y-lg">

            <section>
                <div class="flex items-baseline justify-between mb-lg">
                    <div>
                        <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Gündem</h1>
                        <p class="font-label-md text-label-md text-on-surface-variant mt-1">@DateTime.Now.ToString("dd MMM yyyy")</p>
                    </div>

                </div>

                <!-- Hero Section - Grid Style (En çok okunanlar) -->
                @await Component.InvokeAsync("_NewLatestComponent")

            </section>


            <!-- More News Section -->

            @await Component.InvokeAsync("_NewMoreNewsComponent") 


        </div>



        <!-- Right Sidebar Column -->
        <aside class="lg:col-span-4 space-y-lg">
            <!-- Weather Widget -->
            @await Component.InvokeAsync("_NewWeatherComponent")


            <!-- Local News Section -->
            @await Component.InvokeAsync("_NewLocalComponent")

        </aside>

    </div>

</main>

