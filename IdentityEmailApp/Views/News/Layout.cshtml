@{
    Layout = null;
}

<!DOCTYPE html>

<html class="dark" lang="tr">

@await Component.InvokeAsync("_NewLayoutHeadComponent")


<body class="text-on-surface font-body-md overflow-x-hidden selection:bg-secondary/30 bg-surface-dim">
    <!-- TopNavBar -->
    <header class="flex flex-col w-full sticky top-0 z-50 px-margin-mobile md:px-margin-desktop gap-xs md:gap-md bg-background/80 backdrop-blur-md border-b border-white/10">
        <div class="flex items-center justify-between h-16 w-full">
            <!-- Brand -->
            <div class="flex items-center gap-md">
                <span class="font-headline-md text-headline-md font-bold text-on-surface">NotikaMail Haberler</span>
            </div>


            <!-- Search Bar (on_left style adjusted for center alignment like reference) -->
            @await Component.InvokeAsync("_NewSearchComponent")


            <!-- Account Icons -->
            @await Component.InvokeAsync("_NewAccountComponent")
        </div>


        <!-- Navigation Links (Horizontal) -->
        @await Component.InvokeAsync("_NewLayoutNavigationLinkComponent")


    </header>

    @RenderBody()

    

