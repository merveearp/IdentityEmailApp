        </div>


    </section>

    @await Component.InvokeAsync("_NewLayoutFooterComponent")



    <!-- Micro-interaction Script -->
    <script>
            document.querySelectorAll('.cursor-pointer').forEach(item => {
                item.addEventListener('mousedown', () => item.style.transform = 'scale(0.99)');
                item.addEventListener('mouseup', () => item.style.transform = 'scale(1)');
                item.addEventListener('mouseleave', () => item.style.transform = 'scale(1)');
            });
    </script>
</body></html>