@using IdentityEmailApp.Entities
@model List<Message>

@{
    ViewData["Title"] = "Mesaj Detayı";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var currentUserEmail = ViewBag.CurrentUserEmail as string;

    var firstMessage = Model.FirstOrDefault();
    var lastMessage = Model.LastOrDefault();

    var isReceiver = lastMessage?.ReceiverEmail == currentUserEmail;
}

<link href="~/notika-master/notika/green-horizotal/css/messagedetail.css" rel="stylesheet" />

@await Component.InvokeAsync("_LayoutBreadcombComponent")

<div class="inbox-area">
    <div class="container">
        <div class="row">

            @await Component.InvokeAsync("_MessageSidebarComponent")

            <div class="col-lg-9 col-md-9 col-sm-9 col-xs-12">
                @if (ViewBag.IsAiSpam == true)
                    {
                        <div class="ai-spam-warning">
                            <i class="fa fa-exclamation-triangle"></i>

                            <div>
                                <strong>Bu mesaj spam olabilir</strong>
                                <span>AI risk değerlendirmesi: @ViewBag.SpamScore%</span>
                            </div>
                        </div>
                    }
                <div class="message-detail-card sm-res-mg-t-30">

                    @if (firstMessage == null)
                    {
                        <div class="alert alert-warning">
                            Bu ileti dizisinde gösterilecek mesaj bulunamadı.
                        </div>
                    }
                    else
                    {
                     
                        <div class="message-detail-header">

                            <div>
                                <h2 class="message-detail-title">
                                    İleti Dizisi
                                </h2>

                                <p class="message-detail-subject">
                                    <strong>Konu:</strong>
                                    @firstMessage.Subject
                                </p>
                            </div>

                            <div class="message-detail-date">
                                <span>
                                    @Model.Count ileti
                                </span>
                            </div>

                        </div>

                      
                        <div class="conversation-thread">

                            @foreach (var item in Model)
                            {
                                var isMyMessage =
                                    item.SenderEmail == currentUserEmail;

                                var timeDiff = DateTime.Now - item.SendDate;

                                string timeAgoText;

                                if (timeDiff.TotalMinutes < 1)
                                {
                                    timeAgoText = "Şimdi";
                                }
                                else if (timeDiff.TotalMinutes < 60)
                                {
                                    timeAgoText =
                                        $"{(int)timeDiff.TotalMinutes} dakika önce";
                                }
                                else if (timeDiff.TotalHours < 24)
                                {
                                    timeAgoText =
                                        $"{(int)timeDiff.TotalHours} saat önce";
                                }
                                else if (timeDiff.TotalDays < 7)
                                {
                                    timeAgoText =
                                        $"{(int)timeDiff.TotalDays} gün önce";
                                }
                                else
                                {
                                    timeAgoText =
                                        item.SendDate.ToString("dd.MM.yyyy HH:mm");
                                }

                                <div class="conversation-message
                                    @(isMyMessage
                                                ? "my-message"
                                                : "received-message")">

                                    <div class="message-sender-area">

                                        <div class="message-avatar">

                                            @if (!string.IsNullOrWhiteSpace(item.SenderEmail))
                                            {
                                                @item.SenderEmail.Substring(0, 1).ToUpper()
                                            }
                                            else
                                            {
                                                <span>?</span>
                                            }

                                        </div>

                                        <div class="message-sender-info">

                                            <p>
                                                <strong>Gönderen:</strong>

                                                @if (isMyMessage)
                                                {
                                                    <span>Ben</span>
                                                }
                                                else
                                                {
                                                    <span>@item.SenderEmail</span>
                                                }
                                            </p>

                                            <p class="message-email">
                                                <strong>Alıcı:</strong>

                                                @if (item.ReceiverEmail == currentUserEmail)
                                                {
                                                    <span>Ben</span>
                                                }
                                                else
                                                {
                                                    <span>@item.ReceiverEmail</span>
                                                }
                                            </p>

                                            <div class="message-category">

                                                @if (item.Category == null)
                                                {
                                                    <span class="label label-default">
                                                        Kategori Yok
                                                    </span>
                                                }
                                                else if (item.Category.CategoryName == "Eğitim")
                                                {
                                                    <span class="label label-info">
                                                        @item.Category.CategoryName
                                                    </span>
                                                }
                                                else if (item.Category.CategoryName == "Sosyal")
                                                {
                                                    <span class="label label-success">
                                                        @item.Category.CategoryName
                                                    </span>
                                                }
                                                else if (item.Category.CategoryName == "Kampanyalar")
                                                {
                                                    <span class="label label-warning">
                                                        @item.Category.CategoryName
                                                    </span>
                                                }
                                                else if (item.Category.CategoryName == "Finans")
                                                {
                                                    <span class="label label-primary">
                                                        @item.Category.CategoryName
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="label label-default">
                                                        @item.Category.CategoryName
                                                    </span>
                                                }

                                            </div>

                                        </div>

                                        <div class="message-detail-date">
                                            <span>@timeAgoText</span>
                                        </div>

                                    </div>

                                    <div class="message-content">
                                        @Html.Raw(item.MessageDetail)
                                    </div>

                                </div>
                            }

                        </div>
                        <!-- İşlem butonları -->
                        @if (lastMessage != null)
                        {
                            <div class="message-action-area">

                                <!-- Geri dön -->
                                <a asp-controller="Message"
                                       asp-action="@(isReceiver ? "Inbox" : "SendBox")"
                                       class="message-action-button back-action"
                                       title="@(isReceiver ? "Gelen Kutusuna Dön" : "Gönderilen Kutusuna Dön")">

                                    <i class="fa fa-arrow-left"></i>
                                    <span>Geri</span>

                                </a>

                                <!-- Okundu / okunmadı -->
                                @if (isReceiver)
                                {
                                    <form asp-controller="Message"
                                          asp-action="MarkAsRead"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@lastMessage.MessageId" />

                                        <button type="submit"
                                                class="message-action-button"
                                                title="@(lastMessage.IsRead
                                                                                                ? "Okunmadı Olarak İşaretle"
                                                                                                : "Okundu Olarak İşaretle")">

                                            @if (lastMessage.IsRead)
                                            {
                                                <i class="fa fa-envelope"></i>
                                                <span>Okunmadı</span>
                                            }
                                            else
                                            {
                                                <i class="fa fa-envelope-open"></i>
                                                <span>Okundu</span>
                                            }

                                        </button>

                                    </form>
                                }

                                <!-- Yıldızla -->
                                <button type="button"
                                        class="message-action-button mail-action mail-star"
                                        data-url="@Url.Action("ToggleStar", "Message")"
                                        data-id="@lastMessage.MessageId"
                                        title="@(lastMessage.IsStarred
                                                                        ? "Yıldızı Kaldır"
                                                                        : "Yıldızla")">

                                    @if (lastMessage.IsStarred)
                                    {
                                        <i class="fa fa-star starred"></i>
                                        <span>Yıldızlı</span>
                                    }
                                    else
                                    {
                                        <i class="fa fa-star-o"></i>
                                        <span>Yıldızla</span>
                                    }

                                </button>

                                <!-- Spam -->
                                @if (isReceiver)
                                {
                                    <button type="button"
                                            class="message-action-button mail-action mail-spam"
                                            data-url="@Url.Action("ToggleSpam", "Message")"
                                            data-id="@lastMessage.MessageId"
                                            title="@(lastMessage.IsSpam
                                                                                    ? "Spamdan Çıkar"
                                                                                    : "Spam Olarak İşaretle")">

                                        @if (lastMessage.IsSpam)
                                        {
                                            <i class="fa fa-ban spam-active"></i>
                                            <span>Spamdan Çıkar</span>
                                        }
                                        else
                                        {
                                            <i class="fa fa-ban"></i>
                                            <span>Spam</span>
                                        }

                                    </button>
                                }

                                <!-- Yanıtla -->
                                <button type="button"
                                        id="showReplyButton"
                                        class="message-action-button reply-action"
                                        title="Bu ileti dizisine yanıt ver">

                                    <i class="fa fa-reply"></i>
                                    <span>Yanıtla</span>

                                </button>

                                <!-- Çöp kutusuna taşı -->
                                <button type="button"
                                        class="message-action-button mail-action mail-trash"
                                        data-url="@Url.Action("ToggleDeleted", "Message")"
                                        data-id="@lastMessage.MessageId"
                                        title="@(lastMessage.IsDeleted
                                                                        ? "Gelen Kutusuna Taşı"
                                                                        : "Çöp Kutusuna Gönder")">

                                    @if (lastMessage.IsDeleted)
                                    {
                                        <i class="fa fa-undo"></i>
                                        <span>Geri Al</span>
                                    }
                                    else
                                    {
                                        <i class="fa fa-trash"></i>
                                        <span>Çöp Kutusu</span>
                                    }

                                </button>

                            </div>
                            <br />
                            <br />

                            <div id="replyArea"
                                 class="reply-area"
                                 style="display:none;">

                                <form asp-controller="Message"
                                      asp-action="ReplyMessage"
                                      method="post"
                                      id="replyForm">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="ReplyMessageId"
                                           value="@lastMessage.MessageId" />

                                    <textarea name="MessageDetail"
                                              id="replySummernote"
                                              class="form-control summernote"
                                              placeholder="Yanıtınızı yazınız..."></textarea>
                                    <div class="reply-buttons">

                                        <button type="button"
                                                id="generateAIResponseButton"
                                                class="btn btn-info btn-sm"
                                                data-id="@lastMessage.MessageId">

                                            <i class="fa fa-magic"></i>
                                            AI ile Yanıtla

                                        </button>

                                        <button type="button"
                                                id="cancelReplyButton"
                                                class="btn btn-default btn-sm">

                                            <i class="fa fa-times"></i>
                                            Vazgeç

                                        </button>

                                        <button type="submit"
                                                class="btn btn-success btn-sm">

                                            <i class="fa fa-paper-plane"></i>
                                            Yanıtı Gönder

                                        </button>

                                    </div>

                                </form>

                            </div>
                        }
                    }

                </div>

            </div>

        </div>
    </div>
</div>

<!-- Summernote CSS -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.18/summernote-bs4.min.css" rel="stylesheet" />

<!-- jQuery + Bootstrap + Summernote JS -->

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.18/summernote-bs4.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.18/lang/summernote-tr-TR.min.js"></script>

<!-- message detail JS -->
<script src="~/notika-master/notika/green-horizotal/js/messagedetail.js"></script>