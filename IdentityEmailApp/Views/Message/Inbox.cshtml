@using System.Text.RegularExpressions
@using IdentityEmailApp.Models.MessageModels
@model List<MessageWithSenderInfoModel>

@{
    ViewData["Title"] = "Gelen Kutusu";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<link href="~/notika-master/notika/green-horizotal/css/messagecss/inbox.css" rel="stylesheet" />


<div class="inbox-area">
    <div class="container">
        <div class="row">

            @await Component.InvokeAsync("_MessageSidebarComponent")

            <div class="col-lg-9 col-md-9 col-sm-9 col-xs-12">

                <div class="inbox-text-list sm-res-mg-t-30">

                     <!-- Arama Alanı -->
                    <div class="form-group">
                        <div class="nk-int-st search-input search-overt">

                            <input type="text"
                                   id="notificationSearchInput"
                                   class="form-control"
                                   placeholder="Mesajlarda ara..." />

                            <button type="button"
                                    id="notificationSearchButton"
                                    class="btn search-ib">
                                Ara
                            </button>

                        </div>
                    </div>
                      
                    
                    <form asp-controller="Message"
                              method="post"
                              id="notificationForm">

                            @Html.AntiForgeryToken()

                    <div class="inbox-btn-st-ls btn-toolbar">
                      
                            <div class="btn-group ib-btn-gp active-hook nk-email-inbox">

                                <a asp-controller="Message"
                                       asp-action="Inbox"
                                       class="btn btn-default btn-sm"
                                       title="Yenile">

                                    <i class="notika-icon notika-refresh"></i>
                                    Yenile

                                </a>

                                <button type="button"
                                        id="selectAllButton"
                                        class="btn btn-default btn-sm"
                                        title="Tümünü Seç">

                                    <i class="notika-icon notika-checked"></i>

                                </button>

                              
                         <button type="button"
                            class="btn btn-default btn-sm bulk-action"
                            data-action="read"
                            data-url="@Url.Action("MarkSelectedAsRead", "Message")"
                            title="Okundu Olarak İşaretle">

                             <i class="notika-icon notika-next"></i>
                        </button>

                        <button type="button"
                                class="btn btn-default btn-sm bulk-action"
                                data-action="unread"
                                data-url="@Url.Action("MarkSelectedAsUnRead", "Message")"
                                title="Okunmadı Olarak İşaretle">

                            <i class="notika-icon notika-down-arrow"></i>
                        </button>

                        <button type="button"
                                class="btn btn-default btn-sm bulk-action"
                                data-action="delete"
                                data-url="@Url.Action("DeleteSelected", "Message")"
                                title="Seçilenleri Sil">

                            <i class="notika-icon notika-trash"></i>
                        </button>

                            </div>

                        <div class="btn-group ib-btn-gp active-hook nk-act nk-email-inbox">

                            <button type="button" class="btn btn-default btn-sm">
                                <i class="notika-icon notika-left-arrow"></i>
                            </button>

                            <button type="button" class="btn btn-default btn-sm">
                                <i class="notika-icon notika-right-arrow"></i>
                            </button>

                        </div>
                    </div>
                 
                    <div class="mail-page-header">
                        <div>
                            <h3>
                                <i class="fa fa-inbox"></i>
                                Gelen Kutusu
                            </h3>

                            <p>
                                Size gönderilen mesajları görüntüleyebilir, okuyabilir ve yönetebilirsiniz.
                            </p>
                        </div>
                    </div>
                    
                    <div class="table-responsive">
                     
                        <table class="table table-hover">

                            <thead>
                                <tr>
                                    <th style="width:120px;">Seç</th>
                                    <th>Gönderen</th>
                                    <th>Kategori</th>
                                    <th>Mesaj</th>
                                    <th class="text-right">Tarih</th>
                                    <th class="text-center" style="width:90px;">İşlemler</th>
                                </tr>
                            </thead>

                            <tbody>

                                @if (Model != null && Model.Any())
                                {
                                    @foreach (var item in Model)
                                    {
                                        var rowClass = item.IsRead
                                            ? "read-message"
                                            : "unread-message";

                                        var plainText = Regex.Replace(
                                            item.MessageDetail ?? "",
                                            "<.*?>",
                                            ""
                                        );

                                        var messagePreview =
                                            string.IsNullOrWhiteSpace(plainText)
                                                ? "Mesaj içeriği bulunmuyor."
                                                : plainText.Length > 40
                                                    ? plainText.Substring(0, 40) + "..."
                                                    : plainText;

                                        <tr class="@rowClass">

                                            <td class="mail-actions">

                                                <label class="mail-checkbox">
                                                    <input type="checkbox"
                                                        class="i-checks message-checkbox"
                                                        name="ids"
                                                        value="@item.MessageId" />
                                                </label>

                                                <!-- Yıldızlama -->
                                                <button type="button"
                                                        class="mail-action mail-star"
                                                        data-url="@Url.Action("ToggleStar", "Message")"
                                                        data-id="@item.MessageId"
                                                        title="@(item.IsStarred ? "Yıldızı Kaldır" : "Yıldızla")">

                                                    @if (item.IsStarred)
                                                    {
                                                        <i class="fa fa-star starred"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fa fa-star-o"></i>
                                                    }
                                                </button>

                                                <!-- Spam -->
                                                <button type="button"
                                                        class="mail-action mail-spam"
                                                        data-url="@Url.Action("ToggleSpam", "Message")"
                                                        data-id="@item.MessageId"
                                                        title="@(item.IsSpam ? "Spamdan Çıkar" : "Spam Olarak İşaretle")">

                                                    @if (item.IsSpam)
                                                    {
                                                        <i class="fa fa-flag spam-active"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fa fa-flag-o"></i>
                                                    }
                                                </button>

                                            </td>

                                            <td>
                                                <a asp-controller="Message"
                                                       asp-action="MessageDetail"
                                                       asp-route-id="@item.MessageId"
                                                       class="sender-link">

                                                    @item.SenderName @item.SenderSurname

                                                    <span class="sender-email">
                                                        @item.SenderEmail
                                                    </span>
                                                </a>
                                            </td>

                                            <td>
                                                @if (string.IsNullOrEmpty(item.CategoryName))
                                                {
                                                    <span class="label label-default">
                                                        Kategori Yok
                                                    </span>
                                                }
                                                else if (item.CategoryName == "Eğitim")
                                                {
                                                    <span class="label label-info">
                                                        @item.CategoryName
                                                    </span>
                                                }
                                                else if (item.CategoryName == "Sosyal")
                                                {
                                                    <span class="label label-success">
                                                        @item.CategoryName
                                                    </span>
                                                }
                                                else if (item.CategoryName == "Kampanyalar")
                                                {
                                                    <span class="label label-warning">
                                                        @item.CategoryName
                                                    </span>
                                                }
                                                else if (item.CategoryName == "Finans")
                                                {
                                                    <span class="label label-primary">
                                                        @item.CategoryName
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="label label-default">
                                                        @item.CategoryName
                                                    </span>
                                                }
                                            </td>

                                            <td>
                                                <a asp-controller="Message"
                                                       asp-action="MessageDetail"
                                                       asp-route-id="@item.MessageId"
                                                       class="message-link">

                                                    <strong>
                                                        Konu: @item.Subject
                                                    </strong>

                                                    <span class="message-preview">
                                                        @messagePreview
                                                    </span>
                                                </a>
                                            </td>

                                            <td class="text-right mail-date">
                                                @if (item.SendDate.Date == DateTime.Today)
                                                {
                                                    <span>
                                                        Bugün @item.SendDate.ToString("HH:mm")
                                                    </span>
                                                }
                                                else if (item.SendDate.Date == DateTime.Today.AddDays(-1))
                                                {
                                                    <span>
                                                        Dün @item.SendDate.ToString("HH:mm")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>
                                                        @item.SendDate.ToString("dd.MM.yyyy HH:mm")
                                                    </span>
                                                }
                                            </td>

                                            <td class="text-center">

                                                <!-- Çöp kutusuna taşı -->
                                                <button type="button"
                                                        class="mail-action mail-trash"
                                                        data-url="@Url.Action("ToggleDeleted", "Message")"
                                                        data-id="@item.MessageId"
                                                        title="Çöp Kutusuna Taşı">

                                                    <i class="fa fa-trash-o"></i>
                                                </button>

                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6"
                                            class="text-center"
                                            style="padding:30px;">

                                            Gelen kutunuzda mesaj bulunmuyor.
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>
                    </div>

                       </form>
                
                </div>
            </div>

        </div>
    </div>
</div>

<script src="~/notika-master/notika/green-horizotal/js/message/inbox.js"></script>