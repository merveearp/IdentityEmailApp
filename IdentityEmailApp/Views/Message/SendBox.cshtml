@using System.Text.RegularExpressions
@using IdentityEmailApp.Models.MessageModels
@model List<MessageWithReceiverInfoModel>
@{
    ViewData["Title"] = "SendBox";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>

    .sendbox-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
        padding: 18px 20px;
        background-color: #ffffff;
        border: 1px solid #eeeeee;
        border-left: 4px solid #00c292;
        border-radius: 6px;
    }

        .sendbox-header h3 {
            margin: 0 0 6px 0;
            color: #333333;
            font-size: 21px;
            font-weight: 600;
        }

            .sendbox-header h3 i {
                margin-right: 8px;
                color: #00c292;
            }

        .sendbox-header p {
            margin: 0;
            color: #777777;
            font-size: 13px;
        }

    .mail-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        white-space: nowrap;
    }

    .mail-checkbox {
        margin: 0;
    }

    .mail-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 25px;
        height: 25px;
        padding: 0;
        border: none !important;
        background: transparent !important;
        box-shadow: none !important;
        outline: none !important;
        font-size: 18px;
        cursor: pointer;
    }

    /* Boş yıldız */
    .mail-star {
        color: #b7b7b7;
    }

        .mail-star:hover {
            color: #f4b400;
        }

        /* Dolu yıldız */
        .mail-star .starred {
            color: #f4b400;
        }

    /* Spam değil */
    .mail-spam {
        color: #b7b7b7;
    }

        .mail-spam:hover {
            color: #d9534f;
        }

        /* Spam */
        .mail-spam .spam-active {
            color: #d9534f;
        }

    /* Çöp kutusu */
    .mail-trash {
        color: #777;
    }

        .mail-trash:hover {
            color: #d9534f;
        }
</style>

<div class="inbox-area">
    <div class="container">
        <div class="row">

            @await Component.InvokeAsync("_MessageSidebarComponent")

            <div class="col-lg-9 col-md-9 col-sm-9 col-xs-12">

                <div class="inbox-text-list sm-res-mg-t-30">

                    <!-- Arama Alanı -->
                    <div class="form-group">

                        <div class="nk-int-st search-input search-overt">

                            <input type="text"
                                   class="form-control"
                                   placeholder="Aranacak kelimeyi giriniz..." />

                            <button type="button"
                                    class="btn search-ib">
                                Ara
                            </button>

                        </div>

                    </div>

                    <!-- Mesaj İşlem Formu -->
                    <form asp-controller="Message"
                          method="post"
                          id="notificationForm">

                        @Html.AntiForgeryToken()

                        <!-- Üst İşlem Butonları -->
                        <div class="inbox-btn-st-ls btn-toolbar">

                            <div class="btn-group ib-btn-gp active-hook nk-email-inbox">

                                <a asp-controller="Message"
                                       asp-action="SendBox"
                                       class="btn btn-default btn-sm"
                                       title="Yenile">

                                    <i class="notika-icon notika-refresh"></i>
                                    Yenile

                                </a>

                                <button type="button"
                                        id="selectAllButton"
                                        class="btn btn-default btn-sm"
                                        title="Tümünü Seç">

                                    <i class="notika-icon notika-checked"></i>

                                </button>

                               
                                <button type="button"
                                        class="btn btn-default btn-sm bulk-action"
                                        data-action="delete"
                                        data-url="@Url.Action("DeleteSelected", "Message")"
                                        title="Seçilenleri Sil">

                                    <i class="notika-icon notika-trash"></i>

                                </button>

                            </div>

                            <!-- Sayfalama -->
                            <div class="btn-group ib-btn-gp active-hook nk-act nk-email-inbox">

                                <button type="button"
                                        class="btn btn-default btn-sm">

                                    <i class="notika-icon notika-left-arrow"></i>

                                </button>

                                <button type="button"
                                        class="btn btn-default btn-sm">

                                    <i class="notika-icon notika-right-arrow"></i>

                                </button>

                            </div>

                        </div>

                        <!-- Sayfa Başlığı -->
                        <div class="mail-page-header sendbox-header">

                            <div>

                                <h3>
                                    <i class="fa fa-paper-plane"></i>
                                    Gönderilen Kutusu
                                </h3>

                                <p>
                                    Gönderdiğiniz mesajları görüntüleyebilir ve takip edebilirsiniz.
                                </p>

                            </div>

                        </div>

                        <!-- Mesaj Tablosu -->
                        <div class="table-responsive">

                            <table class="table table-hover">

                                <thead>
                                    <tr>
                                        <th style="width:120px;">Seç</th>
                                        <th>Alıcı</th>
                                        <th>Kategori</th>
                                        <th>Mesaj</th>
                                        <th class="text-right">Tarih</th>
                                        <th class="text-center"
                                            style="width:90px;">
                                            İşlemler
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @if (Model != null && Model.Any())
                                    {
                                        @foreach (var item in Model)
                                        {
                                            var rowClass = item.IsRead
                                                ? "read-message"
                                                : "unread-message";

                                            var plainText = Regex.Replace(
                                                item.MessageDetail ?? "",
                                                "<.*?>",
                                                ""
                                            );

                                            var messagePreview =
                                                string.IsNullOrWhiteSpace(plainText)
                                                    ? "Mesaj içeriği bulunmuyor."
                                                    : plainText.Length > 40
                                                        ? plainText.Substring(0, 40) + "..."
                                                        : plainText;

                                            <tr class="@rowClass">

                                                <td class="mail-actions">

                                                    <label class="mail-checkbox">

                                                        <input type="checkbox"
                                                               class="message-checkbox"
                                                               name="ids"
                                                               value="@item.MessageId" />

                                                    </label>

                                                    <button type="button"
                                                            class="mail-action mail-star"
                                                            data-url="@Url.Action("ToggleStar", "Message")"
                                                            data-id="@item.MessageId"
                                                            title="@(item.IsStarred
                                                                        ? "Yıldızı Kaldır"
                                                                        : "Yıldızla")">

                                                        @if (item.IsStarred)
                                                        {
                                                            <i class="fa fa-star starred"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="fa fa-star-o"></i>
                                                        }

                                                    </button>

                                                </td>

                                                <td>

                                                    <a asp-controller="Message"
                                                           asp-action="MessageDetail"
                                                           asp-route-id="@item.MessageId"
                                                           class="sender-link">

                                                        @item.ReceiverName
                                                        @item.ReceiverSurname

                                                        <span class="sender-email">
                                                            @item.ReceiverEmail
                                                        </span>

                                                    </a>

                                                </td>

                                                <td>

                                                    @if (string.IsNullOrEmpty(item.CategoryName))
                                                    {
                                                        <span class="label label-default">
                                                            Kategori Yok
                                                        </span>
                                                    }
                                                    else if (item.CategoryName == "Eğitim")
                                                    {
                                                        <span class="label label-info">
                                                            @item.CategoryName
                                                        </span>
                                                    }
                                                    else if (item.CategoryName == "Sosyal")
                                                    {
                                                        <span class="label label-success">
                                                            @item.CategoryName
                                                        </span>
                                                    }
                                                    else if (item.CategoryName == "Kampanyalar")
                                                    {
                                                        <span class="label label-warning">
                                                            @item.CategoryName
                                                        </span>
                                                    }
                                                    else if (item.CategoryName == "Finans")
                                                    {
                                                        <span class="label label-primary">
                                                            @item.CategoryName
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="label label-default">
                                                            @item.CategoryName
                                                        </span>
                                                    }

                                                </td>

                                                <td>

                                                    <a asp-controller="Message"
                                                           asp-action="MessageDetail"
                                                           asp-route-id="@item.MessageId"
                                                           class="message-link">

                                                        <strong>
                                                            Konu: @item.Subject
                                                        </strong>

                                                        <span class="message-preview">
                                                            @messagePreview
                                                        </span>

                                                    </a>

                                                </td>

                                                <td class="text-right mail-date">

                                                    @if (item.SendDate.Date == DateTime.Today)
                                                    {
                                                        <span>
                                                            Bugün @item.SendDate.ToString("HH:mm")
                                                        </span>
                                                    }
                                                    else if (
                                                        item.SendDate.Date ==
                                                        DateTime.Today.AddDays(-1))
                                                    {
                                                        <span>
                                                            Dün @item.SendDate.ToString("HH:mm")
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span>
                                                            @item.SendDate.ToString("dd.MM.yyyy HH:mm")
                                                        </span>
                                                    }

                                                </td>

                                                <td class="text-center">

                                                    <button type="button"
                                                            class="mail-action mail-trash"
                                                            data-url="@Url.Action("ToggleDeleted", "Message")"
                                                            data-id="@item.MessageId"
                                                            title="Çöp Kutusuna Taşı">

                                                        <i class="fa fa-trash-o"></i>

                                                    </button>

                                                </td>

                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6"
                                                class="text-center"
                                                style="padding:30px;">

                                                Gönderilen kutunuzda mesaj bulunmuyor.

                                            </td>
                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>
</div>
<!-- Summernote CSS -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.18/summernote-bs4.min.css" rel="stylesheet" />

<!-- jQuery + Bootstrap + Summernote JS -->

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.18/summernote-bs4.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.18/lang/summernote-tr-TR.min.js"></script>

<script>
        document.addEventListener("DOMContentLoaded", function () {

            // ANTIFORGERY TOKEN
            function getAntiForgeryToken() {
                return $("#notificationForm input[name='__RequestVerificationToken']")
                    .val();
            }


            // CONTROLLER'DAN GELEN MESAJI AL
            function getSuccessMessage(response, fallbackMessage) {

                if (typeof response === "string" && response) {
                    return response;
                }

                if (response && response.message) {
                    return response.message;
                }

                return fallbackMessage;
            }


            // HATA MESAJINI AL
            function getErrorMessage(xhr, fallbackMessage) {

                if (xhr.responseJSON && xhr.responseJSON.message) {
                    return xhr.responseJSON.message;
                }

                if (xhr.responseText) {
                    return xhr.responseText;
                }

                return fallbackMessage;
            }

// TÜMÜNÜ SEÇ / SEÇİMLERİ KALDIR
$("#selectAllButton").on("click", function () {

    const checkboxes = $(".message-checkbox");

    const allSelected =
        checkboxes.length > 0 &&
        checkboxes.filter(":checked").length === checkboxes.length;

    checkboxes.prop("checked", !allSelected);

    $(this).attr(
        "title",
        allSelected
            ? "Tümünü Seç"
            : "Seçimi Kaldır"
    );
});


// TOPLU OKUNDU, OKUNMADI VE SİLME
$(document).on("click", ".bulk-action", function (event) {

    event.preventDefault();

    const button = $(this);
    const actionType = button.data("action");

    const selectedCheckboxes =
        $(".message-checkbox:checked");

    if (selectedCheckboxes.length === 0) {

        Swal.fire({
            title: "Mesaj seçilmedi",
            text: "Lütfen en az bir mesaj seçiniz.",
            icon: "warning",
            confirmButtonText: "Tamam"
        });

        return;
    }

    const selectedIds = selectedCheckboxes
        .map(function () {
            return $(this).val();
        })
        .get();

    const selectedRows =
        selectedCheckboxes.closest("tr");

    function sendBulkRequest() {

        $.ajax({
            url: button.data("url"),
            type: "POST",

            traditional: true,

            data: {
                ids: selectedIds,
                __RequestVerificationToken:
                    getAntiForgeryToken()
            },

            success: function (response) {

                let fallbackMessage =
                    "İşlem başarıyla tamamlandı.";

                if (actionType === "read") {

                    selectedRows
                        .removeClass("unread-message")
                        .addClass("read-message");

                    fallbackMessage =
                        "Seçilen mesajlar okundu olarak işaretlendi.";
                }

                if (actionType === "unread") {

                    selectedRows
                        .removeClass("read-message")
                        .addClass("unread-message");

                    fallbackMessage =
                        "Seçilen mesajlar okunmadı olarak işaretlendi.";
                }

                if (actionType === "delete") {

                    selectedRows.fadeOut(200, function () {
                        $(this).remove();
                    });

                    fallbackMessage =
                        "Seçilen mesajlar çöp kutusuna taşındı.";
                }
                else {

                    selectedCheckboxes.prop(
                        "checked",
                        false
                    );
                }

                $("#selectAllButton")
                    .attr("title", "Tümünü Seç");

                Swal.fire({
                    title: "Başarılı",
                    text: getSuccessMessage(
                        response,
                        fallbackMessage
                    ),
                    icon: "success",
                    timer: 1500,
                    showConfirmButton: false
                });
            },

            error: function (xhr) {

                console.log(
                    "Durum kodu:",
                    xhr.status
                );

                console.log(
                    "Sunucu cevabı:",
                    xhr.responseText
                );

                Swal.fire({
                    title: "Hata",
                    text: getErrorMessage(
                        xhr,
                        "Toplu işlem sırasında bir hata oluştu."
                    ),
                    icon: "error",
                    confirmButtonText: "Tamam"
                });
            }
        });
    }

    if (actionType === "delete") {

        Swal.fire({
            title: "Seçilen mesajlar silinsin mi?",
            text: "Mesajlar çöp kutusuna taşınacak.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Evet, sil",
            cancelButtonText: "Vazgeç",
            confirmButtonColor: "#d33",
            cancelButtonColor: "#6c757d"
        }).then(function (result) {

            if (result.isConfirmed) {
                sendBulkRequest();
            }
        });

        return;
    }

    sendBulkRequest();
});
            // TEKLİ YILDIZ, SPAM VE ÇÖP KUTUSU İŞLEMLERİ
            $(document).on("click", ".mail-action", function (event) {

                event.preventDefault();

                const button = $(this);
                const icon = button.find("i");

                $.ajax({
                    url: button.data("url"),
                    type: "POST",

                    data: {
                        id: button.data("id"),
                        __RequestVerificationToken:
                            getAntiForgeryToken()
                    },

                    success: function () {

                        // YILDIZLAMA
                        if (button.hasClass("mail-star")) {

                            if (icon.hasClass("fa-star")) {

                                icon
                                    .removeClass("fa-star starred")
                                    .addClass("fa-star-o");

                                button.attr(
                                    "title",
                                    "Yıldızla"
                                );
                            }
                            else {

                                icon
                                    .removeClass("fa-star-o")
                                    .addClass("fa-star starred");

                                button.attr(
                                    "title",
                                    "Yıldızı Kaldır"
                                );
                            }
                        }


                        // SPAM VEYA ÇÖP KUTUSU
                        if (
                            button.hasClass("mail-spam") ||
                            button.hasClass("mail-trash")
                        ) {
                            button.closest("tr").fadeOut(
                                200,
                                function () {
                                    $(this).remove();
                                }
                            );
                        }
                    },

                    error: function (xhr) {

                        console.log(
                            "Durum kodu:",
                            xhr.status
                        );

                        console.log(
                            "Sunucu cevabı:",
                            xhr.responseText
                        );

                        Swal.fire({
                            title: "Hata",
                            text: getErrorMessage(
                                xhr,
                                "İşlem sırasında bir hata oluştu."
                            ),
                            icon: "error",
                            confirmButtonText: "Tamam"
                        });
                    }
                });
            });


         $(document).on("click", ".mail-permanent-delete", function (event) {

        event.preventDefault();

        const button = $(this);
        const token = getAntiForgeryToken();

        if (!token) {
            console.log("Antiforgery token bulunamadı.");

            Swal.fire({
                title: "Hata",
                text: "Güvenlik anahtarı bulunamadı.",
                icon: "error"
            });

            return;
        }

        Swal.fire({
            title: "Mesaj kalıcı olarak silinsin mi?",
            text: "Bu işlem geri alınamaz.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Evet, sil",
            cancelButtonText: "Vazgeç",
            confirmButtonColor: "#d33",
            cancelButtonColor: "#6c757d"
        }).then(function (result) {

            if (!result.isConfirmed) {
                return;
            }

            $.ajax({
                url: button.data("url"),
                type: "POST",

                data: {
                    id: button.data("id"),
                    __RequestVerificationToken: token
                },

                success: function (response) {

                    button.closest("tr").fadeOut(200, function () {
                        $(this).remove();
                    });

                    const message =
                        response && response.message
                            ? response.message
                            : "Mesaj kalıcı olarak silindi.";

                    Swal.fire({
                        title: "Silindi",
                        text: message,
                        icon: "success",
                        timer: 1500,
                        showConfirmButton: false
                    });
                },

                error: function (xhr) {

                    console.log("Durum kodu:", xhr.status);
                    console.log("Sunucu cevabı:", xhr.responseText);

                    const message =
                        xhr.responseJSON?.message ||
                        xhr.responseText ||
                        "Mesaj kalıcı olarak silinemedi.";

                    Swal.fire({
                        title: "Hata",
                        text: message,
                        icon: "error",
                        confirmButtonText: "Tamam"
                    });
                }
                });
            });
        });

    });
</script>
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}
