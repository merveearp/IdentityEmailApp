@using System.Text.RegularExpressions
@using IdentityEmailApp.Models.MessageModels
@model List<MessageWithReceiverInfoModel>
@{
    ViewData["Title"] = "SendBox";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@await Component.InvokeAsync("_LayoutBreadcombComponent")


<style>

    .sendbox-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
        padding: 18px 20px;
        background-color: #ffffff;
        border: 1px solid #eeeeee;
        border-left: 4px solid #00c292;
        border-radius: 6px;
    }

        .sendbox-header h3 {
            margin: 0 0 6px 0;
            color: #333333;
            font-size: 21px;
            font-weight: 600;
        }

            .sendbox-header h3 i {
                margin-right: 8px;
                color: #00c292;
            }

        .sendbox-header p {
            margin: 0;
            color: #777777;
            font-size: 13px;
        }

    .mail-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        white-space: nowrap;
    }

    .mail-checkbox {
        margin: 0;
    }

    .mail-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 25px;
        height: 25px;
        padding: 0;
        border: none !important;
        background: transparent !important;
        box-shadow: none !important;
        outline: none !important;
        font-size: 18px;
        cursor: pointer;
    }

    /* Boş yıldız */
    .mail-star {
        color: #b7b7b7;
    }

        .mail-star:hover {
            color: #f4b400;
        }

        /* Dolu yıldız */
        .mail-star .starred {
            color: #f4b400;
        }

    /* Spam değil */
    .mail-spam {
        color: #b7b7b7;
    }

        .mail-spam:hover {
            color: #d9534f;
        }

        /* Spam */
        .mail-spam .spam-active {
            color: #d9534f;
        }

    /* Çöp kutusu */
    .mail-trash {
        color: #777;
    }

        .mail-trash:hover {
            color: #d9534f;
        }
</style>


<div class="inbox-area">
    <div class="container">
        <div class="row">

            @await Component.InvokeAsync("_MessageSidebarComponent")

            <div class="col-lg-9 col-md-9 col-sm-9 col-xs-12">
                <div class="inbox-text-list sm-res-mg-t-30">

                    <div class="form-group">
                        <div class="nk-int-st search-input search-overt">
                            <input type="text"
                                   class="form-control"
                                   placeholder="Aranacak kelimeyi giriniz..." />

                            <button type="button" class="btn search-ib">
                                Ara
                            </button>
                        </div>
                    </div>

                    <div class="inbox-btn-st-ls btn-toolbar">
                        <div class="btn-group ib-btn-gp active-hook nk-email-inbox">

                            <a asp-controller="Message"
                                   asp-action="SendBox"
                                   class="btn btn-default btn-sm">
                                <i class="notika-icon notika-refresh"></i>
                                Yenile
                            </a>

                            <button type="button" class="btn btn-default btn-sm">
                                <i class="notika-icon notika-next"></i>
                            </button>

                            <button type="button" class="btn btn-default btn-sm">
                                <i class="notika-icon notika-down-arrow"></i>
                            </button>

                            <button type="button" class="btn btn-default btn-sm">
                                <i class="notika-icon notika-trash"></i>
                            </button>

                            <button type="button" class="btn btn-default btn-sm">
                                <i class="notika-icon notika-checked"></i>
                            </button>

                            <button type="button" class="btn btn-default btn-sm">
                                <i class="notika-icon notika-promos"></i>
                            </button>

                        </div>

                        <div class="btn-group ib-btn-gp active-hook nk-act nk-email-inbox">

                            <button type="button" class="btn btn-default btn-sm">
                                <i class="notika-icon notika-left-arrow"></i>
                            </button>

                            <button type="button" class="btn btn-default btn-sm">
                                <i class="notika-icon notika-right-arrow"></i>
                            </button>

                        </div>
                    </div>

                    <div class="mail-page-header sendbox-header">
                        <div>
                            <h3>
                                <i class="fa fa-paper-plane"></i>
                                Gönderilen Kutusu
                            </h3>

                            <p>
                                Gönderdiğiniz mesajları görüntüleyebilir ve takip edebilirsiniz.
                            </p>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <form id="tokenForm" style="display:none;">
                            @Html.AntiForgeryToken()
                        </form>
                        <table class="table table-hover">

                            <thead>
                                <tr>
                                    <th style="width:120px;">Seç</th>
                                    <th>Alıcı</th>
                                    <th>Kategori</th>
                                    <th>Mesaj</th>
                                    <th class="text-right">Tarih</th>
                                    <th class="text-center" style="width:90px;">İşlemler</th>
                                </tr>
                            </thead>

                            <tbody>

                                @if (Model != null && Model.Any())
                                {
                                    @foreach (var item in Model)
                                    {
                                        var rowClass = item.IsRead
                                            ? "read-message"
                                            : "unread-message";

                                        var plainText = Regex.Replace(
                                            item.MessageDetail ?? "",
                                            "<.*?>",
                                            ""
                                        );

                                        var messagePreview =
                                            string.IsNullOrWhiteSpace(plainText)
                                                ? "Mesaj içeriği bulunmuyor."
                                                : plainText.Length > 40
                                                    ? plainText.Substring(0, 40) + "..."
                                                    : plainText;

                                        <tr class="@rowClass">

                                            <td class="mail-actions">

                                                <label class="mail-checkbox">
                                                    <input type="checkbox"
                                                           class="i-checks"
                                                           name="selectedIds"
                                                           value="@item.MessageId" />
                                                </label>

                                                <!-- Yıldızlama -->
                                                <button type="button"
                                                        class="mail-action mail-star"
                                                        data-url="@Url.Action("ToggleStar", "Message")"
                                                        data-id="@item.MessageId"
                                                        title="@(item.IsStarred ? "Yıldızı Kaldır" : "Yıldızla")">

                                                    @if (item.IsStarred)
                                                    {
                                                        <i class="fa fa-star starred"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fa fa-star-o"></i>
                                                    }
                                                </button>
                                               

                                            </td>

                                            <td>
                                                <a asp-controller="Message"
                                                       asp-action="MessageDetail"
                                                       asp-route-id="@item.MessageId"
                                                       class="sender-link">
                                                       @item.ReceiverName @item.ReceiverSurname

                                                    <span class="sender-email">
                                                        @item.ReceiverEmail
                                                    </span>
                                                </a>
                                            </td>

                                            <td>
                                                @if (string.IsNullOrEmpty(item.CategoryName))
                                                {
                                                    <span class="label label-default">
                                                        Kategori Yok
                                                    </span>
                                                }
                                                else if (item.CategoryName == "Eğitim")
                                                {
                                                    <span class="label label-info">
                                                        @item.CategoryName
                                                    </span>
                                                }
                                                else if (item.CategoryName == "Sosyal")
                                                {
                                                    <span class="label label-success">
                                                        @item.CategoryName
                                                    </span>
                                                }
                                                else if (item.CategoryName == "Kampanyalar")
                                                {
                                                    <span class="label label-warning">
                                                        @item.CategoryName
                                                    </span>
                                                }
                                                else if (item.CategoryName == "Finans")
                                                {
                                                    <span class="label label-primary">
                                                        @item.CategoryName
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="label label-default">
                                                        @item.CategoryName
                                                    </span>
                                                }
                                            </td>

                                            <td>
                                                <a asp-controller="Message"
                                                       asp-action="MessageDetail"
                                                       asp-route-id="@item.MessageId"
                                                       class="message-link">

                                                    <strong>
                                                        Konu: @item.Subject
                                                    </strong>

                                                    <span class="message-preview">
                                                        @messagePreview
                                                    </span>
                                                </a>
                                            </td>

                                            <td class="text-right mail-date">
                                                @if (item.SendDate.Date == DateTime.Today)
                                                {
                                                    <span>
                                                        Bugün @item.SendDate.ToString("HH:mm")
                                                    </span>
                                                }
                                                else if (item.SendDate.Date == DateTime.Today.AddDays(-1))
                                                {
                                                    <span>
                                                        Dün @item.SendDate.ToString("HH:mm")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>
                                                        @item.SendDate.ToString("dd.MM.yyyy HH:mm")
                                                    </span>
                                                }
                                            </td>

                                            <td class="text-center">

                                                <!-- Çöp kutusuna taşı -->
                                                <button type="button"
                                                        class="mail-action mail-trash"
                                                        data-url="@Url.Action("ToggleDeleted", "Message")"
                                                        data-id="@item.MessageId"
                                                        title="Çöp Kutusuna Taşı">
                                                    <i class="fa fa-trash-o"></i>
                                                </button>

                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6"
                                            class="text-center"
                                            style="padding:30px;">

                                            Gelen kutunuzda mesaj bulunmuyor.
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        $(document).on("click", ".mail-action", function () {

            var button = $(this);
            var icon = button.find("i");

            $.post(button.data("url"), {
                id: button.data("id"),
                __RequestVerificationToken:
                    $("#tokenForm input[name='__RequestVerificationToken']").val()
            })
            .done(function () {

                if (button.hasClass("mail-star")) {

                    if (icon.hasClass("fa-star")) {
                        icon.removeClass("fa-star starred")
                            .addClass("fa-star-o");
                    }
                    else {
                        icon.removeClass("fa-star-o")
                            .addClass("fa-star starred");
                    }
                }

                if (button.hasClass("mail-spam") ||
                    button.hasClass("mail-trash")) {

                    button.closest("tr").fadeOut(200);
                }
            })
            .fail(function (xhr) {
                console.log(xhr.status);
                console.log(xhr.responseText);
            });

        });

    });
</script>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}
