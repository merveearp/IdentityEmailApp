
@{
    Layout = null;
}

<!DOCTYPE html>

<html class="dark" lang="tr">
    
    
    @await Component.InvokeAsync("_DashboardHeadComponent")


<body class="flex flex-col min-h-screen overflow-hidden selection:bg-glacier-accent selection:text-glacier-bg">


<!-- TopNavBar -->
    @await Component.InvokeAsync("_DashboardTopNavbarComponent")

<div class="flex flex-1 pt-16 h-screen">


<!-- SideNavBar -->

    @await Component.InvokeAsync("_DashboardSideNavbarComponent")

        <main class="ml-0 md:ml-sidebar-width
            mt-16
            h-[calc(100vh-4rem)]
            p-6 pb-20
            box-border
            overflow-y-auto overflow-x-hidden
            relative
            bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))]
            from-[#002226] via-[#001113] to-[#001113]">

            @RenderBody()

        </main>

</div>

</body>

</html>