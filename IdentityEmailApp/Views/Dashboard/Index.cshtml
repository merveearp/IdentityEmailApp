
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Dashboard/Layout.cshtml";
}


    <!-- Decorative background glow -->
    <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-glacier-accent opacity-5 blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] rounded-full bg-glacier-chart-4 opacity-10 blur-[120px] pointer-events-none"></div>

    @await Component.InvokeAsync("_DashboardHeaderComponent")
    <!-- 8-Widget Grid Layout -->
            <div class="grid grid-cols-1 md:grid-cols-1 xl:grid-cols-12 gap-6 relative z-10">
        <!-- Quick Stats Row (Spans all 12 cols, 4 cards of 3 cols each) -->
    
        @await Component.InvokeAsync("_DashboardStatisticsComponent")
        
        <!-- Row 2 -->
      @await Component.InvokeAsync("_DashbordWeeklyChartComponent")
    @await Component.InvokeAsync("_DashboardPieComponent")


    @await Component.InvokeAsync("_DashboardPie1Component")
  
    @await Component.InvokeAsync("_DashboardPie2Component")
        
<br />
    
        <!-- Row 3 -->
      
        
       
    <!-- Widget 5: Weekly Activity Chart (Spans 8 cols) -->


    <!-- Widget 7: Recent Messages / Activity List (Spans 8 cols) -->
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-6 mt-6">

        @await Component.InvokeAsync("_DashboardLastMessageComponent")

        <div class="glass-card rounded-2xl
            xl:col-span-4 min-h-[400px]">
           
        </div>

    </div>

      
        
        <!-- Widget 8: Storage/System Status (Spans 4 cols) -->
        <div class="flex flex-col gap-6 xl:col-span-4">
            <!-- Storage Card -->
            <div class="glass-card rounded-2xl p-6 flex flex-col relative overflow-hidden">
                <div class="absolute top-[-50px] right-[-50px] w-32 h-32 rounded-full border-[20px] border-glacier-chart-3/10 pointer-events-none"></div>
                <h3 class="text-base font-semibold text-white mb-6">System Storage</h3>
                <div class="flex justify-between items-end mb-2">
                    <div>
                        <p class="text-3xl font-bold text-white">842 <span class="text-sm font-normal text-glacier-text-muted">GB</span></p>
                        <p class="text-xs text-glacier-text-muted mt-1">Used of 1 TB</p>
                    </div>
                    <div class="text-right">
                        <span class="text-lg font-semibold text-glacier-accent drop-shadow-[0_0_8px_rgba(125,211,252,0.5)]">84%</span>
                    </div>
                </div>
                <div class="w-full h-2 bg-white/10 rounded-full mt-2 mb-4 overflow-hidden flex">
                    <div class="h-full bg-glacier-chart-4 w-[30%]"></div>
                    <div class="h-full bg-glacier-chart-3 w-[40%]"></div>
                    <div class="h-full bg-glacier-chart-1 w-[14%] shadow-[0_0_10px_#7dd3fc]"></div>
                </div>
                <div class="flex justify-between text-xs text-glacier-text-muted">
                    <span class="flex items-center gap-1"><div class="w-2 h-2 rounded-full bg-glacier-chart-4"></div> System</span>
                    <span class="flex items-center gap-1"><div class="w-2 h-2 rounded-full bg-glacier-chart-3"></div> Media</span>
                    <span class="flex items-center gap-1"><div class="w-2 h-2 rounded-full bg-glacier-chart-1"></div> Docs</span>
                </div>
            </div>
            <!-- Quick Actions -->
            <div class="glass-card rounded-2xl p-6 flex-1 flex flex-col">
                <h3 class="text-base font-semibold text-white mb-4">Quick Actions</h3>
                <div class="grid grid-cols-2 gap-3 flex-1">
                    <button class="glass-button rounded-xl p-3 flex flex-col items-center justify-center gap-2 hover:bg-white/10 transition-all group">
                        <div class="p-2 rounded-full bg-white/5 group-hover:bg-glacier-accent/20 transition-colors text-white group-hover:text-glacier-accent group-hover:shadow-glacier-glow">
                            <span class="material-symbols-outlined text-[20px]">person_add</span>
                        </div>
                        <span class="text-xs font-medium text-white">Add User</span>
                    </button>
                    <button class="glass-button rounded-xl p-3 flex flex-col items-center justify-center gap-2 hover:bg-white/10 transition-all group">
                        <div class="p-2 rounded-full bg-white/5 group-hover:bg-glacier-accent/20 transition-colors text-white group-hover:text-glacier-accent group-hover:shadow-glacier-glow">
                            <span class="material-symbols-outlined text-[20px]">description</span>
                        </div>
                        <span class="text-xs font-medium text-white">New Report</span>
                    </button>
                    <button class="glass-button rounded-xl p-3 flex flex-col items-center justify-center gap-2 hover:bg-white/10 transition-all group">
                        <div class="p-2 rounded-full bg-white/5 group-hover:bg-glacier-accent/20 transition-colors text-white group-hover:text-glacier-accent group-hover:shadow-glacier-glow">
                            <span class="material-symbols-outlined text-[20px]">security</span>
                        </div>
                        <span class="text-xs font-medium text-white">Security Scan</span>
                    </button>
                    <button class="glass-button rounded-xl p-3 flex flex-col items-center justify-center gap-2 hover:bg-white/10 transition-all group">
                        <div class="p-2 rounded-full bg-white/5 group-hover:bg-glacier-accent/20 transition-colors text-white group-hover:text-glacier-accent group-hover:shadow-glacier-glow">
                            <span class="material-symbols-outlined text-[20px]">sync</span>
                        </div>
                        <span class="text-xs font-medium text-white">Sync Data</span>
                    </button>
                </div>
            </div>
        </div>
  
    </div>



