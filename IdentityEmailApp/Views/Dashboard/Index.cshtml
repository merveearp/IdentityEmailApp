
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Dashboard/Layout.cshtml";
}


    <!-- Decorative background glow -->
    <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-glacier-accent opacity-5 blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] rounded-full bg-glacier-chart-4 opacity-10 blur-[120px] pointer-events-none"></div>

    @await Component.InvokeAsync("_DashboardHeaderComponent")
    <!-- 8-Widget Grid Layout -->
            <div class="grid grid-cols-1 md:grid-cols-1 xl:grid-cols-12 gap-6 relative z-10">
        <!-- Quick Stats Row (Spans all 12 cols, 4 cards of 3 cols each) -->
    
        @await Component.InvokeAsync("_DashboardStatisticsComponent")
        
        <!-- Row 2 -->
      @await Component.InvokeAsync("_DashbordWeeklyChartComponent")
    @await Component.InvokeAsync("_DashboardPieComponent")


    @await Component.InvokeAsync("_DashboardPie1Component")
  
    @await Component.InvokeAsync("_DashboardPie2Component")
        
<br />
    
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-6 mt-6">

        @await Component.InvokeAsync("_DashboardNotificationComponent")

        @await Component.InvokeAsync("_DashboardProfileStatusComponent")

    </div>

    <br />
    
    
    
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-6 mt-6">

        @await Component.InvokeAsync("_DashboardLastMessageComponent")

        <div class="glass-card rounded-2xl
            xl:col-span-4 min-h-[400px]">
            @await Component.InvokeAsync("_DashboardUserTaskComponent")
           
        </div>

    </div>

    <br />

    </div>






