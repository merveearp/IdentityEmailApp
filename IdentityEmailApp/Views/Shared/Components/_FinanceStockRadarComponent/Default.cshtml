@using System.Globalization
@using IdentityEmailApp.DTOs.FinanceDtos
@model FinanceStockRadarDto

@*
    _FinanceStockRadarComponent
*@

@{
    var culture = new CultureInfo("tr-TR");

    string GetCompanyName(FinanceStockResultDto stock)
    {
        if (string.IsNullOrWhiteSpace(stock.Text))
        {
            return stock.Code;
        }

        return stock.Text
            .Replace($"{stock.Code} - ", "");
    }

    string GetRateText(decimal rate)
    {
        var sign = rate > 0 ? "+" : "";

        return $"{sign}%{rate.ToString("0.00", culture)}";
    }
}

<div class="bg-dark-surface rounded-lg p-stack-lg
    card-shadow border border-dark-border
    ring-1 ring-white/5">

    <!-- Başlık -->
    <div class="flex items-center justify-between mb-stack-md">

        <div>
            <h3 class="font-label-md text-label-md
                text-dark-text-muted uppercase tracking-wider">
                Piyasa Radarı
            </h3>

            <p class="text-xs text-dark-text-muted mt-1">
                Günün dikkat çeken hisseleri
            </p>
        </div>

        <div class="w-10 h-10 rounded-lg bg-dark-primary/10
            text-dark-primary flex items-center justify-center">

            <span class="material-symbols-outlined">
                radar
            </span>
        </div>
    </div>

    <div class="space-y-4">

        <!-- Günün Yükseleni -->
        @if (Model?.TopGainer != null)
        {
            var stock = Model.TopGainer;

            <div class="relative overflow-hidden rounded-xl
                border border-[#22c55e]/30
                bg-gradient-to-br
                from-[#22c55e]/15 to-transparent p-5">

                <div class="absolute -right-6 -top-6 w-24 h-24
                    rounded-full bg-[#22c55e]/10">
                </div>

                <div class="relative">

                    <div class="flex items-center justify-between mb-4">

                        <div class="flex items-center gap-2">

                            <div class="w-9 h-9 rounded-lg
                                bg-[#22c55e]/15 text-[#22c55e]
                                flex items-center justify-center">

                                <span class="material-symbols-outlined">
                                    trending_up
                                </span>
                            </div>

                            <div>
                                <p class="text-[10px] uppercase
                                    tracking-wider text-[#22c55e]
                                    font-semibold">
                                    Günün yükseleni
                                </p>

                                <p class="text-xs text-dark-text-muted">
                                    En yüksek değişim oranı
                                </p>
                            </div>
                        </div>

                        <span class="px-2.5 py-1 rounded-full
                            bg-[#22c55e]/15 text-[#22c55e]
                            text-xs font-semibold">

                            @GetRateText(stock.Rate)
                        </span>
                    </div>

                    <div class="flex items-end justify-between">

                        <div>
                            <h4 class="text-xl font-bold text-dark-text">
                                @stock.Code
                            </h4>

                            <p class="text-xs text-dark-text-muted mt-1">
                                @GetCompanyName(stock)
                            </p>
                        </div>

                        <div class="text-right">
                            <p class="font-numeric-data text-xl
                                font-semibold text-dark-text">
                                @stock.LastPriceStr ₺
                            </p>

                            <p class="text-[10px]
                                text-dark-text-muted mt-1">
                                Son fiyat
                            </p>
                        </div>
                    </div>

                    <div class="mt-4 pt-3
                        border-t border-[#22c55e]/20
                        flex items-center justify-between">

                        <span class="text-xs text-dark-text-muted
                            flex items-center gap-1">

                            <span class="material-symbols-outlined
                                text-sm">
                                monitoring
                            </span>

                            İşlem hacmi
                        </span>

                        <span class="text-xs font-medium text-dark-text">
                            @stock.HacimStr ₺
                        </span>
                    </div>
                </div>
            </div>
        }

        <!-- Alt radar kartları -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">

            <!-- Günün Düşeni -->
            @if (Model?.TopLoser != null)
            {
                var stock = Model.TopLoser;

                <div class="rounded-xl border border-[#ef4444]/30
                    bg-[#ef4444]/5 p-4
                    hover:bg-[#ef4444]/10
                    transition-colors">

                    <div class="flex items-center justify-between mb-3">

                        <div class="w-8 h-8 rounded-lg
                            bg-[#ef4444]/15 text-[#ef4444]
                            flex items-center justify-center">

                            <span class="material-symbols-outlined text-lg">
                                trending_down
                            </span>
                        </div>

                        <span class="text-xs font-semibold text-[#ef4444]">
                            @GetRateText(stock.Rate)
                        </span>
                    </div>

                    <p class="text-[10px] uppercase tracking-wider
                        text-dark-text-muted">
                        Günün düşeni
                    </p>

                    <div class="flex items-end
                        justify-between mt-2 gap-2">

                        <div class="min-w-0">
                            <h4 class="font-semibold text-dark-text">
                                @stock.Code
                            </h4>

                            <p class="text-[10px] text-dark-text-muted
                                truncate mt-1"
                                   title="@GetCompanyName(stock)">
                                @GetCompanyName(stock)
                            </p>
                        </div>

                        <span class="font-numeric-data text-sm
                            text-dark-text whitespace-nowrap">
                            @stock.LastPriceStr ₺
                        </span>
                    </div>
                </div>
            }

            <!-- En Yüksek Hacim -->
            @if (Model?.HighestVolume != null)
            {
                var stock = Model.HighestVolume;
                var isPositive = stock.Rate >= 0;

                <div class="rounded-xl border border-dark-primary/30
                    bg-dark-primary/5 p-4
                    hover:bg-dark-primary/10
                    transition-colors">

                    <div class="flex items-center justify-between mb-3">

                        <div class="w-8 h-8 rounded-lg
                            bg-dark-primary/15 text-dark-primary
                            flex items-center justify-center">

                            <span class="material-symbols-outlined text-lg">
                                equalizer
                            </span>
                        </div>

                        <span class="text-xs font-semibold
                            @(isPositive
                                                              ? "text-[#22c55e]"
                                                              : "text-[#ef4444]")">

                            @GetRateText(stock.Rate)
                        </span>
                    </div>

                    <p class="text-[10px] uppercase tracking-wider
                        text-dark-text-muted">
                        En yüksek hacim
                    </p>

                    <div class="mt-2">
                        <div class="flex items-center justify-between gap-2">

                            <h4 class="font-semibold text-dark-text">
                                @stock.Code
                            </h4>

                            <span class="font-numeric-data text-sm
                                text-dark-text whitespace-nowrap">
                                @stock.LastPriceStr ₺
                            </span>
                        </div>

                        <p class="text-[10px] text-dark-text-muted
                            truncate mt-1"
                               title="@GetCompanyName(stock)">
                            @GetCompanyName(stock)
                        </p>

                        <div class="flex items-center gap-1 mt-3
                            text-dark-primary">

                            <span class="material-symbols-outlined
                                text-sm">
                                bar_chart
                            </span>

                            <span class="text-xs font-medium">
                                @stock.HacimStr ₺
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Alt bağlantı -->
    <a href="#featured-stocks"
           class="w-full mt-4 py-2.5
        border border-dark-border rounded-lg
        text-xs font-medium text-dark-primary
        hover:bg-dark-surface-elevated
        transition-colors flex items-center
        justify-center gap-2">

        <span class="material-symbols-outlined text-sm">
            query_stats
        </span>

        Öne Çıkan Hisseleri İncele
    </a>
</div>