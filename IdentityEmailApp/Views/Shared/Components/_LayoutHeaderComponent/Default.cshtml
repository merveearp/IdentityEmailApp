@*
   _LayoutHeaderComponent
*@

<style>

    .navbar-user-item {
        position: relative;
        margin-left: 8px;
    }

    .navbar-user-profile {
        display: flex !important;
        align-items: center;
        gap: 9px;
        min-height: 58px;
        padding: 7px 12px !important;
        color: #ffffff !important;
        text-decoration: none !important;
        border-radius: 6px;
        transition: background-color 0.2s ease;
    }

        .navbar-user-profile:hover,
        .navbar-user-profile:focus {
            background-color: rgba(255, 255, 255, 0.10) !important;
        }

    .navbar-user-image {
        width: 38px;
        height: 38px;
        min-width: 38px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid rgba(255, 255, 255, 0.85);
    }

    .navbar-user-info {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
    }

    .navbar-user-name {
        max-width: 145px;
        overflow: hidden;
        text-overflow: ellipsis;
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }

    .navbar-user-title {
        display: flex;
        align-items: center;
        gap: 4px;
        margin-top: 3px;
        color: rgba(255, 255, 255, 0.78);
        font-size: 11px;
    }

    /* Dropdown kutusu */
    .navbar-user-dropdown {
        right: 0 !important;
        left: auto !important;
        width: 225px;
        min-width: 225px;
        margin-top: 0;
        padding: 8px;
        border: 0;
        border-radius: 10px;
        background-color: #ffffff;
        box-shadow: 0 10px 30px rgba(34, 46, 60, 0.18);
    }

        /* Tema kaynaklı büyük yazıları ezmek için */
        .navbar-user-dropdown > li > a,
        .navbar-user-dropdown-link {
            display: flex !important;
            align-items: center;
            gap: 11px;
            width: 100%;
            min-height: 42px;
            padding: 10px 12px !important;
            margin: 0;
            border: 0;
            border-radius: 7px;
            background: transparent;
            color: #444444 !important;
            font-size: 14px !important;
            font-weight: 400;
            line-height: 20px !important;
            text-align: left;
            text-decoration: none !important;
            cursor: pointer;
            box-sizing: border-box;
            transition: all 0.2s ease;
        }

            .navbar-user-dropdown > li > a:hover,
            .navbar-user-dropdown > li > a:focus,
            .navbar-user-dropdown-link:hover,
            .navbar-user-dropdown-link:focus {
                background-color: #f0faf7 !important;
                color: #00a982 !important;
            }

            .navbar-user-dropdown-link i {
                width: 18px;
                color: #6f7b87;
                font-size: 15px !important;
                text-align: center;
            }

            .navbar-user-dropdown-link:hover i {
                color: #00a982;
            }

        .navbar-user-dropdown .divider {
            height: 1px;
            margin: 7px 4px;
            background-color: #eeeeee;
        }

    /* Çıkış formu ve butonu */
    .navbar-dropdown-logout-form {
        width: 100%;
        margin: 0;
        padding: 0;
    }

    .navbar-dropdown-logout {
        appearance: none;
        -webkit-appearance: none;
        font-family: inherit;
        color: #e25561 !important;
    }

        .navbar-dropdown-logout i {
            color: #e25561;
        }

        .navbar-dropdown-logout:hover,
        .navbar-dropdown-logout:focus {
            background-color: #fff1f2 !important;
            color: #d94350 !important;
            outline: none;
        }

    .navbar-top-item {
        position: relative;
    }

    .navbar-top-trigger {
        position: relative !important;
        display: flex !important;
        align-items: center;
        justify-content: center;
        overflow: visible !important;
    }


    .navbar-top-badge {
        position: absolute;
        top: 2px;
        right: 2px;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 19px;
        height: 19px;
        padding: 0 5px;
        border-radius: 20px;
        border: 2px solid #00c292;
        background-color: #e85d68;
        color: #ffffff !important;
        font-size: 10px;
        font-weight: 700;
        line-height: 1;
        box-sizing: border-box;
        z-index: 50;
        box-shadow: 0 2px 7px rgba(232, 93, 104, 0.45);
        animation: navbarBadgePulse 1.8s infinite;
    }

        .navbar-top-badge::after {
            content: "";
            position: absolute;
            inset: -4px;
            border-radius: 50%;
            border: 2px solid rgba(232, 93, 104, 0.4);
            opacity: 0;
            animation: navbarBadgeRing 1.8s infinite;
        }

      
        .navbar-top-badge.large-count {
            min-width: 24px;
            padding: 0 6px;
        }

    .navbar-top-trigger .notika-icon {
        transition: transform 0.2s ease;
    }

    .navbar-top-trigger:hover .notika-icon {
        transform: scale(1.12);
    }

    @@keyframes navbarBadgePulse {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.08);
        }
    }

    @@keyframes navbarBadgeRing {
        0% {
            transform: scale(0.8);
            opacity: 0.5;
        }

        70% {
            transform: scale(1.35);
            opacity: 0;
        }

        100% {
            transform: scale(1.35);
            opacity: 0;
        }
    }

    .navbar-top-item {
        position: relative;
    }

    .navbar-top-trigger {
        position: relative !important;
        display: flex !important;
        align-items: center;
        justify-content: center;
    }

    

    .navbar-message-menu {
        width: 360px;
    }

    .navbar-notification-menu {
        width: 360px;
    }

    .header-top-area,
.header-top-menu,
.notika-top-nav,
.notika-top-nav > li {
    overflow: visible !important;
}

    /* =========================================
       NOTIKA UYGULAMALAR MENÜSÜ
    ========================================= */

    .notika-apps-item {
        position: relative;
    }

    .notika-apps-trigger {
        width: 48px;
        height: 48px;
        display: flex !important;
        align-items: center;
        justify-content: center;
        padding: 0 !important;
        margin-right: 8px;
        border-radius: 50%;
        transition: background-color 0.2s ease;
    }

        .notika-apps-trigger:hover,
        .notika-apps-item.open .notika-apps-trigger {
            background-color: rgba(255, 255, 255, 0.12);
        }

    /* 9 noktalı ikon */
    .notika-apps-grid {
        width: 20px;
        height: 20px;
        display: grid;
        grid-template-columns: repeat(3, 4px);
        grid-template-rows: repeat(3, 4px);
        gap: 4px;
        justify-content: center;
        align-content: center;
    }

        .notika-apps-grid span {
            width: 4px;
            height: 4px;
            display: block;
            background-color: #ffffff;
            border-radius: 50%;
        }

    /* Açılan uygulama kutusu */
    .notika-apps-dropdown {
        width: 330px;
        padding: 0;
        margin-top: 12px;
        right: 0;
        left: auto;
        border: none;
        border-radius: 16px;
        background-color: #ffffff;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
        overflow: hidden;
    }

    .notika-apps-header {
        padding: 18px 20px 14px;
        border-bottom: 1px solid #eeeeee;
    }

        .notika-apps-header h4 {
            margin: 0 0 4px;
            color: #222222;
            font-size: 16px;
            font-weight: 600;
        }

        .notika-apps-header span {
            color: #888888;
            font-size: 12px;
        }

    .notika-apps-list {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 6px;
        padding: 14px;
    }

    .notika-app-card {
        min-height: 92px;
        display: flex !important;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 10px 5px !important;
        color: #444444 !important;
        text-align: center;
        text-decoration: none !important;
        border-radius: 12px;
        transition: background-color 0.2s ease, transform 0.2s ease;
    }

        .notika-app-card:hover {
            background-color: #f5f7fa !important;
            transform: translateY(-2px);
        }

        .notika-app-card > span:last-child {
            font-size: 13px;
            font-weight: 500;
        }

    .notika-app-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 20px;
    }

    .mail-app {
        color: #ffffff;
        background-color: #00c292;
    }

    .calendar-app {
        color: #ffffff;
        background-color: #4285f4;
    }

    .contact-app {
        color: #ffffff;
        background-color: #7e57c2;
    }

    .file-app {
        color: #ffffff;
        background-color: #f4b400;
    }

    .task-app {
        color: #ffffff;
        background-color: #ef5350;
    }

    .dashboard-app {
        color: #ffffff;
        background-color: #26a69a;
    }

    /* Mobil */
    @@media (max-width: 767px) {
        .notika-apps-dropdown {
            position: fixed;
            top: 60px;
            right: 10px;
            left: 10px;
            width: auto;
        }
    }
</style>

<div class="header-top-area">
    <div class="container">
        <div class="row">

            <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                <div class="logo-area">
                    <a asp-controller="Message" asp-action="Inbox">
                        <img src="/notika-master/notika/green-horizotal/img/logo/logo.png"
                             alt="Notika" />
                    </a>
                </div>
            </div>

            <div class="col-lg-8 col-md-8 col-sm-12 col-xs-12">

                <div class="header-top-menu">

                   <ul class="nav navbar-nav notika-top-nav">

    <!-- Arama -->
    <li class="nav-item dropdown navbar-top-item">

        <a href="#"
           data-toggle="dropdown"
           role="button"
           aria-expanded="false"
           class="nav-link dropdown-toggle navbar-top-trigger">

            <span>
                <i class="notika-icon notika-search"></i>
            </span>

        </a>

        <div role="menu"
             class="dropdown-menu search-dd animated flipInX">

            <div class="search-input">
                <i class="notika-icon notika-left-arrow"></i>

                <input type="text"
                       placeholder="Arama yapın..." />
            </div>

        </div>

    </li>

    <!-- Mesaj -->
    @await Component.InvokeAsync("_MessageListOnNavbarComponent")

    <!-- Bildirim -->
    @await Component.InvokeAsync("_NotificationListOnNavbarComponent")
                      
    
    <li class="nav-item dropdown navbar-user-item">

                            <a href="#"
                                   class="navbar-user-profile dropdown-toggle"
                                   data-toggle="dropdown"
                                   role="button"
                                   aria-haspopup="true"
                                   aria-expanded="false">

                                <img class="navbar-user-image"
                                     src="@(string.IsNullOrEmpty(ViewBag.ImageUrl)
                                                              ? "/images/profile/default-user.png"
                                                              : ViewBag.ImageUrl)"
                                     alt="@ViewBag.FullName" />

                                <span class="navbar-user-info">
                                    <span class="navbar-user-name">
                                        @ViewBag.FullName
                                    </span>

                                    <span class="navbar-user-title">
                                        Hesabım
                                        <i class="fa fa-angle-down"></i>
                                    </span>
                                </span>
                            </a>

                            <ul class="dropdown-menu navbar-user-dropdown">

                                <li>
                                    <a asp-controller="Profile"
                                           asp-action="Index"
                                           class="navbar-user-dropdown-link">
                                        <i class="fa fa-user"></i>
                                        <span>Profilim</span>
                                    </a>
                                </li>

                                <li>
                                    <a asp-controller="Profile"
                                           asp-action="EditProfile"
                                           class="navbar-user-dropdown-link">
                                        <i class="fa fa-pencil"></i>
                                        <span>Profili Düzenle</span>
                                    </a>
                                </li>

                                <li>
                                    <a asp-controller="Password"
                                           asp-action="ChangePassword"
                                           class="navbar-user-dropdown-link">
                                        <i class="fa fa-lock"></i>
                                        <span>Şifre Değiştir</span>
                                    </a>
                                </li>

                                <li class="divider"></li>

                                <li>
                                    <form asp-controller="Login"
                                          asp-action="Logout"
                                          method="post"
                                          class="navbar-dropdown-logout-form">

                                        <button type="submit"
                                                class="navbar-user-dropdown-link navbar-dropdown-logout">
                                            <i class="fa fa-sign-out"></i>
                                            <span>Çıkış Yap</span>
                                        </button>

                                    </form>
                                </li>

                            </ul>
                        </li>


                        <!-- Notika Uygulamaları -->
                        <li class="nav-item dropdown notika-apps-item">

                            <a href="#"
                                   class="nav-link dropdown-toggle notika-apps-trigger"
                                   data-toggle="dropdown"
                                   role="button"
                                   aria-haspopup="true"
                                   aria-expanded="false"
                                   title="Notika Uygulamaları">

                                <span class="notika-apps-grid">
                                    @for (int i = 0; i < 9; i++)
                                    {
                                        <span></span>
                                    }
                                </span>

                            </a>

                            <div class="dropdown-menu notika-apps-dropdown">

                                <div class="notika-apps-header">
                                    <h4>Notika Uygulamaları</h4>
                                    <span>Diğer servislere geçiş yapın</span>
                                </div>

                                <div class="notika-apps-list">

                                    <a asp-controller="Message"
                                           asp-action="Inbox"
                                           class="notika-app-card">

                                        <span class="notika-app-icon mail-app">
                                            <i class="fa fa-envelope"></i>
                                        </span>

                                        <span>Mail</span>
                                    </a>

                                    <a asp-controller="News"
                                           asp-action="Index"
                                           class="notika-app-card">

                                        <span class="notika-app-icon calendar-app">
                                            <i class="fa fa-calendar"></i>
                                        </span>

                                        <span>Haberler</span>
                                    </a>

                                    <a asp-controller="Finance"
                                           asp-action="Index"
                                           class="notika-app-card">

                                        <span class="notika-app-icon contact-app">
                                            <i class="fa fa-address-book"></i>
                                        </span>

                                        <span>Finans</span>
                                    </a>


                                    <a asp-controller="Task"
                                           asp-action="Index"
                                           class="notika-app-card">

                                        <span class="notika-app-icon task-app">
                                            <i class="fa fa-check-square-o"></i>
                                        </span>

                                        <span>Görevler</span>
                                    </a>

                                    <a asp-controller="Dashboard"
                                           asp-action="Index"
                                           class="notika-app-card">

                                        <span class="notika-app-icon dashboard-app">
                                            <i class="fa fa-bar-chart"></i>
                                        </span>

                                        <span>Panel</span>
                                    </a>

                                </div>

                            </div>

                        </li>
</ul>
                </div>
            </div>

            

        </div>
    </div>
</div>