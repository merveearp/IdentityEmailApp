@*
   _LayoutHeaderComponent
*@

<style>
    .navbar-top-item {
        position: relative;
    }

    .navbar-top-trigger {
        position: relative !important;
        display: flex !important;
        align-items: center;
        justify-content: center;
        overflow: visible !important;
    }


    .navbar-top-badge {
        position: absolute;
        top: 2px;
        right: 2px;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 19px;
        height: 19px;
        padding: 0 5px;
        border-radius: 20px;
        border: 2px solid #00c292;
        background-color: #e85d68;
        color: #ffffff !important;
        font-size: 10px;
        font-weight: 700;
        line-height: 1;
        box-sizing: border-box;
        z-index: 50;
        box-shadow: 0 2px 7px rgba(232, 93, 104, 0.45);
        animation: navbarBadgePulse 1.8s infinite;
    }

        .navbar-top-badge::after {
            content: "";
            position: absolute;
            inset: -4px;
            border-radius: 50%;
            border: 2px solid rgba(232, 93, 104, 0.4);
            opacity: 0;
            animation: navbarBadgeRing 1.8s infinite;
        }

      
        .navbar-top-badge.large-count {
            min-width: 24px;
            padding: 0 6px;
        }

    .navbar-top-trigger .notika-icon {
        transition: transform 0.2s ease;
    }

    .navbar-top-trigger:hover .notika-icon {
        transform: scale(1.12);
    }

    @@keyframes navbarBadgePulse {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.08);
        }
    }

    @@keyframes navbarBadgeRing {
        0% {
            transform: scale(0.8);
            opacity: 0.5;
        }

        70% {
            transform: scale(1.35);
            opacity: 0;
        }

        100% {
            transform: scale(1.35);
            opacity: 0;
        }
    }

    .navbar-top-item {
        position: relative;
    }

    .navbar-top-trigger {
        position: relative !important;
        display: flex !important;
        align-items: center;
        justify-content: center;
    }

    

    .navbar-message-menu {
        width: 360px;
    }

    .navbar-notification-menu {
        width: 360px;
    }
    .header-top-area,
.header-top-menu,
.notika-top-nav,
.notika-top-nav > li {
    overflow: visible !important;
}
</style>

<div class="header-top-area">
    <div class="container">
        <div class="row">

            <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                <div class="logo-area">
                    <a asp-controller="Message" asp-action="Inbox">
                        <img src="/notika-master/notika/green-horizotal/img/logo/logo.png"
                             alt="Notika" />
                    </a>
                </div>
            </div>

            <div class="col-lg-8 col-md-8 col-sm-12 col-xs-12">

                <div class="header-top-menu">

                    <ul class="nav navbar-nav notika-top-nav">

                        <!-- Arama -->
                        <li class="nav-item dropdown navbar-top-item">

                            <a href="#"
                                   data-toggle="dropdown"
                                   role="button"
                                   aria-expanded="false"
                                   class="nav-link dropdown-toggle navbar-top-trigger">

                                <span>
                                    <i class="notika-icon notika-search"></i>
                                </span>

                            </a>

                            <div role="menu"
                                 class="dropdown-menu search-dd animated flipInX">

                                <div class="search-input">
                                    <i class="notika-icon notika-left-arrow"></i>
                                    <input type="text"
                                           placeholder="Arama yapın..." />
                                </div>

                            </div>
                        </li>

                        <!-- Mesaj -->
                     @await Component.InvokeAsync("_MessageListOnNavbarComponent")

                        <!-- Bildirim -->
                     
                     @await Component.InvokeAsync("_NotificationListOnNavbarComponent")

                        <!-- Chat -->
                        <li class="nav-item dropdown navbar-top-item">

                            <a href="#"
                                   data-toggle="dropdown"
                                   role="button"
                                   aria-expanded="false"
                                   class="nav-link dropdown-toggle navbar-top-trigger">

                                <span>
                                    <i class="notika-icon notika-chat"></i>
                                </span>

                            </a>

                            <div role="menu"
                                 class="dropdown-menu message-dd chat-dd animated zoomIn">

                                <div class="hd-mg-tt">
                                    <h2>Sohbet</h2>
                                </div>

                                <div class="search-people">
                                    <i class="notika-icon notika-left-arrow"></i>

                                    <input type="text"
                                           placeholder="Kişi ara..." />
                                </div>

                                <div class="hd-message-info">

                                    <a href="#">
                                        <div class="hd-message-sn">

                                            <div class="hd-message-img chat-img">

                                                <img src="/notika-master/notika/green-horizotal/img/post/1.jpg"
                                                     alt="Kullanıcı" />

                                                <div class="chat-avaible">
                                                    <i class="notika-icon notika-dot"></i>
                                                </div>

                                            </div>

                                            <div class="hd-mg-ctn">
                                                <h3>David Belle</h3>
                                                <p>Çevrim içi</p>
                                            </div>

                                        </div>
                                    </a>

                                </div>

                                <div class="hd-mg-va">
                                    <a href="#">
                                        Tüm Sohbetleri Görüntüle
                                    </a>
                                </div>

                            </div>
                        </li>

                    </ul>

                </div>
            </div>

        </div>
    </div>
</div>