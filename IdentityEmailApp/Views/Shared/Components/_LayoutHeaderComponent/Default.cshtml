@*
   _LayoutHeaderComponent
*@

<style>

    .navbar-user-item {
        position: relative;
        margin-left: 8px;
    }

    .navbar-user-profile {
        display: flex !important;
        align-items: center;
        gap: 9px;
        min-height: 58px;
        padding: 7px 12px !important;
        color: #ffffff !important;
        text-decoration: none !important;
        border-radius: 6px;
        transition: background-color 0.2s ease;
    }

        .navbar-user-profile:hover,
        .navbar-user-profile:focus {
            background-color: rgba(255, 255, 255, 0.10) !important;
        }

    .navbar-user-image {
        width: 38px;
        height: 38px;
        min-width: 38px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid rgba(255, 255, 255, 0.85);
    }

    .navbar-user-info {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
    }

    .navbar-user-name {
        max-width: 145px;
        overflow: hidden;
        text-overflow: ellipsis;
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }

    .navbar-user-title {
        display: flex;
        align-items: center;
        gap: 4px;
        margin-top: 3px;
        color: rgba(255, 255, 255, 0.78);
        font-size: 11px;
    }

    /* Dropdown kutusu */
    .navbar-user-dropdown {
        right: 0 !important;
        left: auto !important;
        width: 225px;
        min-width: 225px;
        margin-top: 0;
        padding: 8px;
        border: 0;
        border-radius: 10px;
        background-color: #ffffff;
        box-shadow: 0 10px 30px rgba(34, 46, 60, 0.18);
    }

        /* Tema kaynaklı büyük yazıları ezmek için */
        .navbar-user-dropdown > li > a,
        .navbar-user-dropdown-link {
            display: flex !important;
            align-items: center;
            gap: 11px;
            width: 100%;
            min-height: 42px;
            padding: 10px 12px !important;
            margin: 0;
            border: 0;
            border-radius: 7px;
            background: transparent;
            color: #444444 !important;
            font-size: 14px !important;
            font-weight: 400;
            line-height: 20px !important;
            text-align: left;
            text-decoration: none !important;
            cursor: pointer;
            box-sizing: border-box;
            transition: all 0.2s ease;
        }

            .navbar-user-dropdown > li > a:hover,
            .navbar-user-dropdown > li > a:focus,
            .navbar-user-dropdown-link:hover,
            .navbar-user-dropdown-link:focus {
                background-color: #f0faf7 !important;
                color: #00a982 !important;
            }

            .navbar-user-dropdown-link i {
                width: 18px;
                color: #6f7b87;
                font-size: 15px !important;
                text-align: center;
            }

            .navbar-user-dropdown-link:hover i {
                color: #00a982;
            }

        .navbar-user-dropdown .divider {
            height: 1px;
            margin: 7px 4px;
            background-color: #eeeeee;
        }

    /* Çıkış formu ve butonu */
    .navbar-dropdown-logout-form {
        width: 100%;
        margin: 0;
        padding: 0;
    }

    .navbar-dropdown-logout {
        appearance: none;
        -webkit-appearance: none;
        font-family: inherit;
        color: #e25561 !important;
    }

        .navbar-dropdown-logout i {
            color: #e25561;
        }

        .navbar-dropdown-logout:hover,
        .navbar-dropdown-logout:focus {
            background-color: #fff1f2 !important;
            color: #d94350 !important;
            outline: none;
        }

    .navbar-top-item {
        position: relative;
    }

    .navbar-top-trigger {
        position: relative !important;
        display: flex !important;
        align-items: center;
        justify-content: center;
        overflow: visible !important;
    }


    .navbar-top-badge {
        position: absolute;
        top: 2px;
        right: 2px;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 19px;
        height: 19px;
        padding: 0 5px;
        border-radius: 20px;
        border: 2px solid #00c292;
        background-color: #e85d68;
        color: #ffffff !important;
        font-size: 10px;
        font-weight: 700;
        line-height: 1;
        box-sizing: border-box;
        z-index: 50;
        box-shadow: 0 2px 7px rgba(232, 93, 104, 0.45);
        animation: navbarBadgePulse 1.8s infinite;
    }

        .navbar-top-badge::after {
            content: "";
            position: absolute;
            inset: -4px;
            border-radius: 50%;
            border: 2px solid rgba(232, 93, 104, 0.4);
            opacity: 0;
            animation: navbarBadgeRing 1.8s infinite;
        }

      
        .navbar-top-badge.large-count {
            min-width: 24px;
            padding: 0 6px;
        }

    .navbar-top-trigger .notika-icon {
        transition: transform 0.2s ease;
    }

    .navbar-top-trigger:hover .notika-icon {
        transform: scale(1.12);
    }

    @@keyframes navbarBadgePulse {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.08);
        }
    }

    @@keyframes navbarBadgeRing {
        0% {
            transform: scale(0.8);
            opacity: 0.5;
        }

        70% {
            transform: scale(1.35);
            opacity: 0;
        }

        100% {
            transform: scale(1.35);
            opacity: 0;
        }
    }

    .navbar-top-item {
        position: relative;
    }

    .navbar-top-trigger {
        position: relative !important;
        display: flex !important;
        align-items: center;
        justify-content: center;
    }

    

    .navbar-message-menu {
        width: 360px;
    }

    .navbar-notification-menu {
        width: 360px;
    }

    .header-top-area,
.header-top-menu,
.notika-top-nav,
.notika-top-nav > li {
    overflow: visible !important;
}
<style>
    /* =========================================
       NOTIKA UYGULAMALAR MENÜSÜ
    ========================================= */

    .notika-apps-item {
        position: relative;
    }

    .notika-apps-trigger {
        display: flex !important;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        margin-right: 8px;
        padding: 0 !important;
        border-radius: 50%;
        transition: background-color 0.2s ease;
    }

    .notika-apps-trigger:hover,
    .notika-apps-item.open .notika-apps-trigger {
        background-color: rgba(255, 255, 255, 0.12);
    }

    /* Dokuz noktalı uygulama ikonu */
    .notika-apps-grid {
        display: grid;
        grid-template-columns: repeat(3, 4px);
        grid-template-rows: repeat(3, 4px);
        justify-content: center;
        align-content: center;
        width: 20px;
        height: 20px;
        gap: 3px;
    }

    .notika-apps-grid span {
        display: block;
        width: 4px;
        height: 4px;
        background-color: #ffffff;
        border-radius: 50%;
    }

    /* Açılır menü */
    .notika-apps-dropdown {
        right: 0;
        left: auto;
        width: 390px;
        margin-top: 12px;
        padding: 0;
        overflow: hidden;
        background-color: #182236;
        border: 1px solid #344158;
        border-radius: 17px;
        box-shadow: 0 18px 45px rgba(5, 12, 25, 0.38);
    }

    /* Başlık alanı */
    .notika-apps-header {
        display: flex;
        align-items: center;
        gap: 14px;
        min-height: 85px;
        padding: 17px 20px;
        border-bottom: 1px solid #344158;
    }

    .notika-apps-header-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 45px;
        width: 45px;
        height: 45px;
        color: #ffffff;
        background: linear-gradient(145deg, #7785ff, #8d82ef);
        border-radius: 12px;
        box-shadow: 0 8px 18px rgba(123, 132, 255, 0.28);
    }

    .notika-apps-header-text h4 {
        margin: 0 0 4px;
        color: #f7f8fc;
        font-size: 18px;
        font-weight: 700;
        line-height: 1.2;
    }

    .notika-apps-header-text span {
        color: #9ca8bd;
        font-size: 13px;
    }

    /* Uygulama listesi */
    .notika-apps-list {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        column-gap: 10px;
        row-gap: 18px;
        padding: 28px 24px 30px;
    }

    .notika-app-card {
        display: flex !important;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 100px;
        padding: 10px 5px !important;
        color: #cbd3e1 !important;
        text-align: center;
        text-decoration: none !important;
        border-radius: 13px;
        transition: background-color 0.2s ease, transform 0.2s ease;
    }

    .notika-app-card:hover,
    .notika-app-card:focus {
        color: #ffffff !important;
        text-decoration: none !important;
        background-color: #222f46 !important;
        transform: translateY(-3px);
    }

    .notika-app-card > span:last-child {
        font-size: 14px;
        font-weight: 600;
    }

    /* Renkli uygulama ikonları */
    .notika-app-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 53px;
        height: 53px;
        color: #ffffff;
        border-radius: 17px;
        font-size: 24px;
        box-shadow: 0 8px 20px rgba(4, 12, 28, 0.24);
    }

    .mail-app {
        background: linear-gradient(145deg, #2578ff, #2467e8);
    }

    .news-app {
        background: linear-gradient(145deg, #18bbed, #0da6dc);
    }

    .finance-app {
        background: linear-gradient(145deg, #b54eff, #913ce2);
    }

    .task-app {
        background: linear-gradient(145deg, #ff831b, #ff6910);
    }

    .translate-app {
        background: linear-gradient(145deg, #22bfaf, #13a899);
    }

    .dashboard-app {
        background: linear-gradient(145deg, #18c68c, #0eaa77);
    }

    /* Mobil görünüm */
    @@media (max-width: 767px) {
        .notika-apps-dropdown {
            position: fixed;
            top: 60px;
            right: 10px;
            left: 10px;
            width: auto;
        }

        .notika-apps-list {
            padding: 20px 15px;
        }

        .notika-app-icon {
            width: 48px;
            height: 48px;
            font-size: 21px;
        }
    }
</style>
</style>

<div class="header-top-area">
    <div class="container">
        <div class="row">

            <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                <div class="logo-area">
                    <a asp-controller="Message" asp-action="Inbox">
                        <img src="/notika-master/notika/green-horizotal/img/logo/logo.png"
                             alt="Notika" />
                    </a>
                </div>
            </div>

            <div class="col-lg-8 col-md-8 col-sm-12 col-xs-12">

                <div class="header-top-menu">

                   <ul class="nav navbar-nav notika-top-nav">

    <!-- Arama -->
    <li class="nav-item dropdown navbar-top-item">

        <a href="#"
           data-toggle="dropdown"
           role="button"
           aria-expanded="false"
           class="nav-link dropdown-toggle navbar-top-trigger">

            <span>
                <i class="notika-icon notika-search"></i>
            </span>

        </a>

        <div role="menu"
             class="dropdown-menu search-dd animated flipInX">

            <div class="search-input">
                <i class="notika-icon notika-left-arrow"></i>

                <input type="text"
                       placeholder="Arama yapın..." />
            </div>

        </div>

    </li>

    <!-- Mesaj -->
    @await Component.InvokeAsync("_MessageListOnNavbarComponent")

    <!-- Bildirim -->
    @await Component.InvokeAsync("_NotificationListOnNavbarComponent")
                      
    
