@using System.Globalization
@using IdentityEmailApp.DTOs.FinanceDtos
@model List<FinanceStockResultDto>

@*
    _FinanceFeaturedStocksComponent
*@

@{
    var culture = new CultureInfo("tr-TR");

    string GetCompanyName(FinanceStockResultDto stock)
    {
        if (string.IsNullOrWhiteSpace(stock.Text))
        {
            return stock.Code;
        }

        return stock.Text
            .Replace($"{stock.Code} - ", "");
    }
}

<section id="featured-stocks">

    <!-- Başlık -->
    <div class="flex items-center justify-between mb-stack-md">

        <div>
            <h2 class="font-headline-sm text-headline-sm text-dark-text">
                Öne Çıkan Hisseler
            </h2>

            <p class="text-xs text-dark-text-muted mt-1">
                BIST'in öne çıkan şirketlerini takip edin
            </p>
        </div>

        <div class="flex items-center gap-1 text-dark-primary">

            <span class="material-symbols-outlined text-sm">
                update
            </span>

            <span class="text-xs">
                Güncel veriler
            </span>
        </div>
    </div>

    <!-- Hisse kartları -->
    <div class="grid grid-cols-1 sm:grid-cols-2
        lg:grid-cols-3 xl:grid-cols-5 gap-gutter">

        @foreach (var item in Model)
        {
            var isPositive = item.Rate >= 0;

            var companyName = GetCompanyName(item);

            var stockIcon = item.Code switch
            {
                "THYAO" => "flight",
                "ASELS" => "radar",
                "AKBNK" => "account_balance",
                "GARAN" => "account_balance_wallet",
                "TUPRS" => "oil_barrel",
                _ => "monitoring"
            };

            var rateText =
                $"{(item.Rate > 0 ? "+" : "")}%" +
                item.Rate.ToString("0.00", culture);

            <div class="relative overflow-hidden
                bg-dark-surface rounded-xl
                p-stack-md card-shadow
                border border-dark-border
                ring-1 ring-white/5
                hover:border-dark-primary/50
                hover:-translate-y-1
                transition-all duration-200">

                <!-- Üst bölüm -->
                <div class="flex items-start justify-between mb-4">

                    <div class="flex items-center gap-3">

                        <div class="w-10 h-10 rounded-lg
                            bg-dark-primary/10
                            text-dark-primary
                            flex items-center justify-center">

                            <span class="material-symbols-outlined">
                                @stockIcon
                            </span>
                        </div>

                        <div>
                            <h3 class="font-semibold text-dark-text">
                                @item.Code
                            </h3>

                            <p class="text-[10px]
                                text-dark-text-muted
                                max-w-[110px] truncate"
                                   title="@companyName">
                                @companyName
                            </p>
                        </div>
                    </div>

                    <span class="material-symbols-outlined
                        text-dark-text-muted text-sm">
                        show_chart
                    </span>
                </div>

                <!-- Fiyat -->
                <div class="mb-4">

                    <p class="text-[10px] uppercase tracking-wider
                        text-dark-text-muted">
                        Son fiyat
                    </p>

                    <div class="flex items-end justify-between mt-1">

                        <span class="font-numeric-data
                            text-numeric-data text-dark-text">
                            @item.LastPriceStr ₺
                        </span>

                        <span class="text-xs font-semibold
                            flex items-center
                            @(isPositive
                                                              ? "text-[#22c55e]"
                                                              : "text-[#ef4444]")">

                            <span class="material-symbols-outlined
                                text-[13px] mr-0.5">

                                @(isPositive
                                    ? "arrow_upward"
                                    : "arrow_downward")
                            </span>

                            @rateText
                        </span>
                    </div>
                </div>

                <!-- Mini trend görünümü -->
                <div class="h-7 flex items-center mb-3">

                    <div class="relative w-full h-full overflow-hidden">

                        <div class="absolute left-0 right-0 top-1/2
                            border-t border-dark-border">
                        </div>

                        @if (isPositive)
                        {
                            <div class="absolute left-0 right-0
                                bottom-1 h-4 border-b-2
                                border-[#22c55e]
                                rounded-bl-full opacity-60">
                            </div>
                        }
                        else
                        {
                            <div class="absolute left-0 right-0
                                top-1 h-4 border-t-2
                                border-[#ef4444]
                                rounded-tl-full opacity-60">
                            </div>
                        }
                    </div>
                </div>

                <!-- İşlem hacmi -->
                <div class="pt-3 border-t border-dark-border
                    flex items-center justify-between gap-2">

                    <span class="text-[10px] text-dark-text-muted
                        flex items-center gap-1">

                        <span class="material-symbols-outlined text-sm">
                            bar_chart
                        </span>

                        İşlem hacmi
                    </span>

                    <span class="text-[10px] font-medium
                        text-dark-text text-right truncate"
                          title="@item.HacimStr ₺">
                        @item.HacimStr ₺
                    </span>
                </div>
            </div>
        }
    </div>
</section>