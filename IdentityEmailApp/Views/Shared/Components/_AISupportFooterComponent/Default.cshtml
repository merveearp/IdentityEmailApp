@*
    _AISupportFooterComponent
*@

<footer class="bg-surface-container-low dark:bg-inverse-surface
    font-label-sm text-label-sm w-full py-section-padding
    border-t border-outline-variant
    dark:border-outline mt-auto">

    <div class="max-w-container-width mx-auto px-margin-desktop
        flex flex-col md:flex-row justify-between
        items-center gap-stack-lg">

        <div class="flex flex-col items-center md:items-start gap-stack-sm">

            <span class="font-headline-sm text-headline-sm font-black
                text-on-surface dark:text-inverse-on-surface
                flex items-center gap-2">

                <span class="material-symbols-outlined"
                      style="font-variation-settings: 'FILL' 1;">
                    smart_toy
                </span>

                Notika AI Destek
            </span>

            <span class="text-on-surface-variant
                dark:text-surface-variant">

                © @DateTime.Now.Year Notika. Tüm hakları saklıdır.
            </span>
        </div>

        <span class="text-on-surface-variant
            dark:text-surface-variant text-center">

            Yapay zekâ destekli kişisel asistanınız
        </span>
    </div>
</footer>