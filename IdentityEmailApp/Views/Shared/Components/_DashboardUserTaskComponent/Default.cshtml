@using System.Globalization
@model IdentityEmailApp.Entities.UserTask?

@*
    _DashboardUserTaskComponent
*@

@{
    var turkishCulture = new CultureInfo("tr-TR");

    var subTasks = Model?.SubTasks?
        .OrderBy(x => x.IsCompleted)
        .ThenBy(x => x.CreatedDate)
        .ToList()
        ?? new List<IdentityEmailApp.Entities.SubTask>();

    var completedSubTaskCount =
        subTasks.Count(x => x.IsCompleted);

    var progressPercent = subTasks.Count == 0
        ? 0
        : (int)Math.Round(
            completedSubTaskCount * 100.0 / subTasks.Count
        );

    var isOverdue =
        Model?.DueDate.HasValue == true &&
        Model.DueDate.Value.Date < DateTime.Today;

    var visibleSubTasks = subTasks.Take(4).ToList();
    var remainingSubTaskCount =
        subTasks.Count - visibleSubTasks.Count;
}

<style>
    .dashboard-notebook-paper {
        background-color: #fffdf2;
        background-image: repeating-linear-gradient( to bottom, transparent 0, transparent 31px, rgba(100, 116, 139, 0.16) 31px, rgba(100, 116, 139, 0.16) 32px );
    }

        .dashboard-notebook-paper::before {
            content: "";
            position: absolute;
            top: 0;
            bottom: 0;
            left: 31px;
            width: 1px;
            background: rgba(239, 68, 68, 0.35);
        }
</style>

<div class="glass-card rounded-2xl
    border border-glacier-card-border
    shadow-glacier xl:col-span-4
    flex flex-col min-h-[400px]">

    <!-- Başlık -->
    <div class="p-6 border-b border-glacier-card-border
        bg-white/[0.01]">

        <h2 class="text-base font-semibold text-white">
            Son Aktif Görev
        </h2>

        <p class="text-xs text-glacier-text-muted mt-1">
            En son oluşturduğunuz tamamlanmamış görev
        </p>
    </div>

    <div class="flex-1 p-5">

        @if (Model == null)
        {
            <div class="h-full min-h-[290px]
                flex flex-col items-center justify-center
                text-center">

                <div class="w-14 h-14 rounded-full
                    bg-white/5 text-glacier-text-muted
                    flex items-center justify-center mb-4">

                    <span class="material-symbols-outlined text-3xl">
                        task_alt
                    </span>
                </div>

                <p class="text-sm font-medium text-white">
                    Aktif görev bulunmuyor
                </p>

                <p class="text-xs text-glacier-text-muted mt-1">
                    Yeni görevler burada görüntülenecek.
                </p>
            </div>
        }
        else
        {
            <!-- Not defteri -->
            <div class="dashboard-notebook-paper
                relative min-h-[290px] rounded-xl
                border border-[#e8e0c6]
                shadow-[0_12px_35px_rgba(0,0,0,0.25)]
                pl-12 pr-5 pt-7 pb-5 overflow-visible">

                <!-- Kırmızı ataş -->
                <div class="absolute -top-4 right-6
                    w-9 h-14 z-20
                    flex items-center justify-center
                    text-red-500
                    rotate-[18deg]
                    drop-shadow-[0_3px_3px_rgba(0,0,0,0.3)]">

                    <span class="material-symbols-outlined text-[42px]">
                        attach_file
                    </span>
                </div>

                <!-- Kategori ve önem -->
                <div class="flex items-center justify-between
                    gap-3 mb-4">

                    <span class="inline-flex items-center
                        rounded-full px-3 py-1
                        bg-[#00c292]/10 text-[#008e6c]
                        border border-[#00c292]/20
                        text-[11px] font-semibold">

                        @(Model.TaskList?.Name ?? "Genel")
                    </span>

                    @if (Model.IsImportant)
                    {
                        <span class="material-symbols-outlined
                            text-amber-500 text-[22px]"
                              style="font-variation-settings:'FILL' 1;">

                            star
                        </span>
                    }
                </div>

                <!-- Görev başlığı -->
                <h3 class="text-lg font-bold text-slate-800
                    leading-7 mb-2">

                    @Model.Title
                </h3>

                <!-- Açıklama -->
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="text-sm leading-6 text-slate-600
                        mb-4 max-h-[72px] overflow-hidden">

                        @Model.Description
                    </p>
                }
                else
                {
                    <p class="text-sm italic text-slate-400 mb-4">
                        Açıklama eklenmemiş.
                    </p>
                }

                <!-- Tarihler -->
                <div class="flex flex-wrap items-center gap-3 mb-4">

                    <div class="inline-flex items-center gap-1.5
                        text-xs text-slate-500">

                        <span class="material-symbols-outlined text-[17px]">
                            calendar_add_on
                        </span>

                        @Model.CreatedDate.ToString(
                            "dd MMM yyyy",
                            turkishCulture
                        )
                    </div>

                    @if (Model.DueDate.HasValue)
                    {
                        <div class="inline-flex items-center gap-1.5
                            text-xs font-medium
                            @(isOverdue
                                                             ? "text-red-600"
                                                             : "text-slate-600")">

                            <span class="material-symbols-outlined text-[17px]">
                                event
                            </span>

                            @Model.DueDate.Value.ToString(
                                "dd MMM yyyy",
                                turkishCulture
                            )
                        </div>
                    }
                </div>

                <!-- Alt görevler -->
                @if (subTasks.Any())
                {
                    <div class="border-t border-slate-300/60 pt-4">

                        <div class="flex items-center justify-between mb-3">

                            <span class="text-xs font-semibold
                                text-slate-700 uppercase
                                tracking-wide">

                                Alt Görevler
                            </span>

                            <span class="text-xs font-semibold text-slate-500">
                                @completedSubTaskCount/@subTasks.Count
                            </span>
                        </div>

                        <div class="space-y-2.5">
                            @foreach (var subTask in visibleSubTasks)
                            {
                                <div class="flex items-center gap-2.5">

                                    @if (subTask.IsCompleted)
                                    {
                                        <span class="material-symbols-outlined
                                            text-[19px] text-[#00a67c]"
                                              style="font-variation-settings:'FILL' 1;">

                                            check_circle
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined
                                            text-[19px] text-slate-400">

                                            radio_button_unchecked
                                        </span>
                                    }

                                    <span class="text-sm
                                        @(subTask.IsCompleted
                                                                                      ? "text-slate-400 line-through"
                                                                                      : "text-slate-700")">

                                        @subTask.Title
                                    </span>
                                </div>
                            }
                        </div>

                        @if (remainingSubTaskCount > 0)
                        {
                            <p class="text-xs text-slate-500 mt-3">
                                +@remainingSubTaskCount alt görev daha
                            </p>
                        }

                        <!-- İlerleme -->
                        <div class="mt-4">
                            <div class="w-full h-1.5 rounded-full
                                bg-slate-200 overflow-hidden">

                                <div class="h-full rounded-full
                                    bg-[#00c292]"
                                     style="width:@progressPercent%">
                                </div>
                            </div>

                            <p class="text-[11px] text-slate-500 mt-1.5">
                                %@progressPercent tamamlandı
                            </p>
                        </div>

                    </div>
                }
                else
                {
                    <div class="border-t border-slate-300/60 pt-4">

                        <div class="flex items-center gap-2 text-slate-400">

                            <span class="material-symbols-outlined text-[18px]">
                                checklist
                            </span>

                            <span class="text-xs">
                                Bu görev için alt görev bulunmuyor.
                            </span>
                        </div>
                    </div>
                }

            </div>
        }

    </div>
</div>