@model List<Category>
@*
   _MessageCategoryListComponent
*@

<div class="inbox-status">
    <ul class="inbox-st-nav">
        @foreach(var item in Model)
        {
            <li><a asp-controller="Message" asp-action="GetMessageListCategoryId" asp-route-id="@item.CategoryId"><i class="@item.CategoryIconUrl"></i> @item.CategoryName</a></li>
        }
      
    </ul>
</div>
