@*
   _AISupportTopNavBarComponent
*@
<nav class="bg-surface dark:bg-surface-dim font-body-md text-body-md
    w-full sticky top-0 z-50 border-b border-outline-variant">

    <div class="w-full px-4 md:px-margin-desktop flex justify-between items-center h-16">

        <!-- Sol alan -->
        <div class="flex items-center gap-4">

          
            <a asp-controller="AISupport"
                   asp-action="Index"
                   class="font-headline-md text-headline-md text-on-surface
                flex items-center gap-2">

                <span class="material-symbols-outlined text-primary">
                    smart_toy
                </span>

                Notika AI Destek
            </a>
        </div>

        <!-- Sağ alan -->
        <div class="flex items-center gap-2 md:gap-4">

            <!-- AI Destek -->
            <a asp-controller="AISupport"
                   asp-action="Index"
                   class="p-2 text-on-surface-variant
                hover:bg-surface-container rounded-full
                flex items-center justify-center transition-colors"
                   title="AI Destek">

                <span class="material-symbols-outlined">
                    help
                </span>
            </a>

            <!-- Mail -->
            <a asp-controller="Message"
                   asp-action="Inbox"
                   class="p-2 text-on-surface-variant
                hover:bg-surface-container rounded-full
                flex items-center justify-center transition-colors"
                   title="Notika Mail">

                <span class="material-symbols-outlined">
                    mail
                </span>
            </a>

            <!-- Uygulamalar -->
            <div class="relative group">

                <!-- Uygulamalar Butonu -->
                <button type="button"
                        class="p-2 text-on-surface-variant
                    hover:bg-surface-container rounded-full
                    flex items-center justify-center
                    transition-colors"
                        title="Notika Uygulamaları">

                    <span class="material-symbols-outlined">
                        apps
                    </span>
                </button>

                <!-- Uygulamalar Menüsü -->
                <div class="hidden group-focus-within:block
                    absolute right-0 top-full mt-3
                    w-[360px] sm:w-[390px]
                    max-w-[calc(100vw-24px)]
                    bg-[#182236]
                    rounded-2xl overflow-hidden
                    border border-[#344158]
                    shadow-[0_20px_55px_rgba(0,0,0,0.45)]
                    z-[100]">

                    <!-- Başlık -->
                    <div class="flex items-center gap-4
                        px-5 py-5
                        border-b border-[#344158]">

                        <div class="w-12 h-12 shrink-0 rounded-xl
                            bg-gradient-to-br
                            from-indigo-400 to-violet-500
                            text-white
                            flex items-center justify-center
                            shadow-lg shadow-indigo-500/20">

                            <span class="material-symbols-outlined text-[28px]">
                                apps
                            </span>
                        </div>

                        <div>
                            <h4 class="m-0 text-[18px] leading-tight
                                font-bold text-white">
                                Notika Uygulamaları
                            </h4>

                            <p class="mt-1 mb-0 text-[13px] text-slate-400">
                                Kullanmak istediğiniz servisi seçin
                            </p>
                        </div>
                    </div>

                    <!-- Uygulama Kartları -->
                    <div class="grid grid-cols-3 gap-x-2 gap-y-4 px-5 py-6">

                        <!-- Mail -->
                        <a asp-controller="Message"
                               asp-action="Inbox"
                               class="group/app min-h-[105px] rounded-xl p-2
                            flex flex-col items-center justify-center gap-3
                            text-slate-300 hover:text-white
                            hover:bg-white/5
                            transition-all duration-200"
                               style="text-decoration: none;">

                            <div class="w-[52px] h-[52px] rounded-2xl
                                bg-blue-600 text-white
                                flex items-center justify-center
                                shadow-md transition-transform duration-200
                                group-hover/app:-translate-y-1">

                                <span class="material-symbols-outlined text-[27px]">
                                    mail
                                </span>
                            </div>

                            <span class="text-[14px] font-semibold">
                                Mail
                            </span>
                        </a>

                        <!-- Haberler -->
                        <a asp-controller="News"
                               asp-action="Index"
                               asp-route-category="latest"
                               class="group/app min-h-[105px] rounded-xl p-2
                            flex flex-col items-center justify-center gap-3
                            text-slate-300 hover:text-white
                            hover:bg-white/5
                            transition-all duration-200"
                               style="text-decoration: none;">

                            <div class="w-[52px] h-[52px] rounded-2xl
                                bg-sky-500 text-white
                                flex items-center justify-center
                                shadow-md transition-transform duration-200
                                group-hover/app:-translate-y-1">

                                <span class="material-symbols-outlined text-[27px]">
                                    newspaper
                                </span>
                            </div>

                            <span class="text-[14px] font-semibold">
                                Haberler
                            </span>
                        </a>

                        <!-- Finans -->
                        <a asp-controller="Finance"
                               asp-action="Index"
                               class="group/app min-h-[105px] rounded-xl p-2
                            flex flex-col items-center justify-center gap-3
                            text-slate-300 hover:text-white
                            hover:bg-white/5
                            transition-all duration-200"
                               style="text-decoration: none;">

                            <div class="w-[52px] h-[52px] rounded-2xl
                                bg-purple-500 text-white
                                flex items-center justify-center
                                shadow-md transition-transform duration-200
                                group-hover/app:-translate-y-1">

                                <span class="material-symbols-outlined text-[27px]">
                                    monitoring
                                </span>
                            </div>

                            <span class="text-[14px] font-semibold">
                                Finans
                            </span>
                        </a>

                        <!-- Görevler -->
                        <a asp-controller="Task"
                               asp-action="Index"
                               class="group/app min-h-[105px] rounded-xl p-2
                            flex flex-col items-center justify-center gap-3
                            text-slate-300 hover:text-white
                            hover:bg-white/5
                            transition-all duration-200"
                               style="text-decoration: none;">

                            <div class="w-[52px] h-[52px] rounded-2xl
                                bg-orange-500 text-white
                                flex items-center justify-center
                                shadow-md transition-transform duration-200
                                group-hover/app:-translate-y-1">

                                <span class="material-symbols-outlined text-[27px]">
                                    task_alt
                                </span>
                            </div>

                            <span class="text-[14px] font-semibold">
                                Görevler
                            </span>
                        </a>

                        <!-- Translate -->
                        <a asp-controller="Translate"
                               asp-action="Index"
                               class="group/app min-h-[105px] rounded-xl p-2
                            flex flex-col items-center justify-center gap-3
                            text-slate-300 hover:text-white
                            hover:bg-white/5
                            transition-all duration-200"
                               style="text-decoration: none;">

                            <div class="w-[52px] h-[52px] rounded-2xl
                                bg-teal-500 text-white
                                flex items-center justify-center
                                shadow-md transition-transform duration-200
                                group-hover/app:-translate-y-1">

                                <span class="material-symbols-outlined text-[27px]">
                                    translate
                                </span>
                            </div>

                            <span class="text-[14px] font-semibold">
                                Translate
                            </span>
                        </a>

                        <!-- Panel -->
                        <a asp-controller="Dashboard"
                               asp-action="Index"
                               class="group/app min-h-[105px] rounded-xl p-2
                            flex flex-col items-center justify-center gap-3
                            text-slate-300 hover:text-white
                            hover:bg-white/5
                            transition-all duration-200"
                               style="text-decoration: none;">

                            <div class="w-[52px] h-[52px] rounded-2xl
                                bg-emerald-500 text-white
                                flex items-center justify-center
                                shadow-md transition-transform duration-200
                                group-hover/app:-translate-y-1">

                                <span class="material-symbols-outlined text-[27px]">
                                    bar_chart
                                </span>
                            </div>

                            <span class="text-[14px] font-semibold">
                                Panel
                            </span>
                        </a>

                    </div>
                </div>
            </div>

            <!-- Kullanıcı -->
            <div class="flex items-center gap-3 pl-2
                border-l border-outline-variant">

                <div class="hidden md:block text-right">
                    <p class="text-label-md text-on-surface leading-tight">
                        @ViewBag.FullName
                    </p>

                    <p class="text-label-sm text-on-surface-variant">
                        Kullanıcı
                    </p>
                </div>

                <div class="w-9 h-9 rounded-full bg-primary-container
                    text-on-primary-container flex items-center
                    justify-center overflow-hidden
                    border border-outline-variant">

                    @if (!string.IsNullOrWhiteSpace(ViewBag.ImageUrl as string))
                    {
                        <img src="@ViewBag.ImageUrl"
                             alt="@ViewBag.FullName"
                             class="w-full h-full object-cover" />
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-lg">
                            person
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>
</nav>