@*
    _NewAccountComponent
*@

<div class="relative flex items-center gap-xs">

    <!-- AI Destek -->
    <a asp-controller="AISupport"
           asp-action="Index"
           title="AI Destek"
           class="p-2 hover:bg-surface-variant/50 rounded-lg
        transition-all text-on-surface-variant
        hover:text-on-surface flex items-center justify-center"
           style="text-decoration:none;">

        <span class="material-symbols-outlined">
            support_agent
        </span>

    </a>

    <!-- Ayarlar -->
    <a asp-controller="Message"
           asp-action="Inbox"
           title="Mail"
           class="p-2 hover:bg-surface-variant/50 rounded-lg
        transition-all text-on-surface-variant
        hover:text-on-surface flex items-center justify-center"
           style="text-decoration:none;">

        <span class="material-symbols-outlined">
            Notika Mail
        </span>

    </a>

    <!-- Uygulamalar Alanı -->
    <div class="relative">

        <!-- Uygulamalar Butonu -->
        <button type="button"
                id="appsMenuButton"
                title="Notika Uygulamaları"
                aria-expanded="false"
                aria-controls="appsMenu"
                class="p-2 hover:bg-surface-variant/50 rounded-lg
            transition-all text-on-surface-variant
            hover:text-on-surface flex items-center justify-center">

            <span class="material-symbols-outlined">
                apps
            </span>
        </button>

        <!-- Uygulamalar Menüsü -->
        <div id="appsMenu"
             class="hidden absolute right-0 top-full mt-3
            w-[360px] sm:w-[390px]
            bg-[#182236]
            rounded-2xl overflow-hidden
            border border-[#344158]
            shadow-2xl z-[100]">

            <!-- Başlık Alanı -->
            <div class="flex items-center gap-4 px-5 py-5
                border-b border-[#344158]">

                <!-- Başlık İkonu -->
                <div class="w-12 h-12 shrink-0 rounded-xl
                    bg-gradient-to-br from-indigo-400 to-violet-500
                    flex items-center justify-center
                    shadow-lg shadow-indigo-500/20">

                    <span class="material-symbols-outlined text-white text-[28px]">
                        apps
                    </span>
                </div>

                <!-- Başlık Metni -->
                <div>
                    <h3 class="text-[18px] leading-tight font-semibold text-white">
                        Notika Uygulamaları
                    </h3>

                    <p class="mt-1 text-[13px] text-slate-400">
                        Kullanmak istediğiniz servisi seçin
                    </p>
                </div>

            </div>

            <!-- Uygulama Kartları -->
            <div class="grid grid-cols-3 gap-x-2 gap-y-4 px-5 py-6">

                <!-- Mail -->
                <a asp-controller="Message"
                       asp-action="Inbox"
                       class="group flex flex-col items-center justify-center
                    min-h-[105px] rounded-xl p-2
                    hover:bg-white/5
                    transition-all duration-200"
                       style="text-decoration: none;">

                    <div class="w-[52px] h-[52px] rounded-2xl
                        bg-blue-600 flex items-center justify-center
                        shadow-md transition-transform duration-200
                        group-hover:-translate-y-1">

                        <span class="material-symbols-outlined text-white text-[27px]">
                            mail
                        </span>
                    </div>

                    <span class="mt-3 text-[14px] font-semibold text-slate-300 text-center">
                        Mail
                    </span>
                </a>

                <!-- Haberler -->
                <a asp-controller="News"
                       asp-action="Index"
                       asp-route-category="latest"
                       class="group flex flex-col items-center justify-center
                    min-h-[105px] rounded-xl p-2
                    hover:bg-white/5
                    transition-all duration-200"
                       style="text-decoration: none;">

                    <div class="w-[52px] h-[52px] rounded-2xl
                        bg-sky-500 flex items-center justify-center
                        shadow-md transition-transform duration-200
                        group-hover:-translate-y-1">

                        <span class="material-symbols-outlined text-white text-[27px]">
                            newspaper
                        </span>
                    </div>

                    <span class="mt-3 text-[14px] font-semibold text-slate-300 text-center">
                        Haberler
                    </span>
                </a>

                <!-- Finans -->
                <a asp-controller="Finance"
                       asp-action="Index"
                       class="group flex flex-col items-center justify-center
                    min-h-[105px] rounded-xl p-2
                    hover:bg-white/5
                    transition-all duration-200"
                       style="text-decoration: none;">

                    <div class="w-[52px] h-[52px] rounded-2xl
                        bg-purple-500 flex items-center justify-center
                        shadow-md transition-transform duration-200
                        group-hover:-translate-y-1">

                        <span class="material-symbols-outlined text-white text-[27px]">
                            monitoring
                        </span>
                    </div>

                    <span class="mt-3 text-[14px] font-semibold text-slate-300 text-center">
                        Finans
                    </span>
                </a>

                <!-- Görevler -->
                <a asp-controller="Task"
                       asp-action="Index"
                       class="group flex flex-col items-center justify-center
                    min-h-[105px] rounded-xl p-2
                    hover:bg-white/5
                    transition-all duration-200"
                       style="text-decoration: none;">

                    <div class="w-[52px] h-[52px] rounded-2xl
                        bg-orange-500 flex items-center justify-center
                        shadow-md transition-transform duration-200
                        group-hover:-translate-y-1">

                        <span class="material-symbols-outlined text-white text-[27px]">
                            task_alt
                        </span>
                    </div>

                    <span class="mt-3 text-[14px] font-semibold text-slate-300 text-center">
                        Görevler
                    </span>
                </a>

                <!-- Translate -->
                <a asp-controller="Translate"
                       asp-action="Index"
                       class="group flex flex-col items-center justify-center
                    min-h-[105px] rounded-xl p-2
                    hover:bg-white/5
                    transition-all duration-200"
                       style="text-decoration: none;">

                    <div class="w-[52px] h-[52px] rounded-2xl
                        bg-teal-500 flex items-center justify-center
                        shadow-md transition-transform duration-200
                        group-hover:-translate-y-1">

                        <span class="material-symbols-outlined text-white text-[27px]">
                            translate
                        </span>
                    </div>

                    <span class="mt-3 text-[14px] font-semibold text-slate-300 text-center">
                        Translate
                    </span>
                </a>

                <!-- Panel -->
                <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="group flex flex-col items-center justify-center
                    min-h-[105px] rounded-xl p-2
                    hover:bg-white/5
                    transition-all duration-200"
                       style="text-decoration: none;">

                    <div class="w-[52px] h-[52px] rounded-2xl
                        bg-emerald-500 flex items-center justify-center
                        shadow-md transition-transform duration-200
                        group-hover:-translate-y-1">

                        <span class="material-symbols-outlined text-white text-[27px]">
                            bar_chart
                        </span>
                    </div>

                    <span class="mt-3 text-[14px] font-semibold text-slate-300 text-center">
                        Panel
                    </span>
                </a>

            </div>
        </div>
    </div>

    <!-- Profil Resmi -->
    <a asp-controller="Profile"
           asp-action="Index"
           title="@ViewBag.FullName"
           class="ml-2 w-9 h-9 rounded-full overflow-hidden
        border border-white/10 cursor-pointer
        hover:ring-2 hover:ring-secondary/50
        transition-all block"
           style="text-decoration:none;">

        @if (!string.IsNullOrWhiteSpace(ViewBag.ImageUrl))
        {
            <img src="@ViewBag.ImageUrl"
                 alt="@ViewBag.FullName"
                 class="w-full h-full object-cover" />
        }
        else
        {
            <div class="w-full h-full bg-secondary/20
                flex items-center justify-center">

                <span class="material-symbols-outlined text-secondary">
                    person
                </span>

            </div>
        }

    </a>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const appsMenuButton = document.getElementById("appsMenuButton");
        const appsMenu = document.getElementById("appsMenu");

        if (!appsMenuButton || !appsMenu) {
            return;
        }

        appsMenuButton.addEventListener("click", function (event) {

            event.stopPropagation();

            const isHidden = appsMenu.classList.contains("hidden");

            appsMenu.classList.toggle("hidden");

            appsMenuButton.setAttribute(
                "aria-expanded",
                isHidden ? "true" : "false"
            );
        });

        appsMenu.addEventListener("click", function (event) {
            event.stopPropagation();
        });

        document.addEventListener("click", function () {

            appsMenu.classList.add("hidden");
            appsMenuButton.setAttribute("aria-expanded", "false");

        });

        document.addEventListener("keydown", function (event) {

            if (event.key === "Escape") {
                appsMenu.classList.add("hidden");
                appsMenuButton.setAttribute("aria-expanded", "false");
            }

        });

    });
</script>