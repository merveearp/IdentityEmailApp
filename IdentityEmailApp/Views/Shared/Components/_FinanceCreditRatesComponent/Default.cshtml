@using IdentityEmailApp.DTOs.FinanceDtos
@model List<FinanceCreditRateResultDto>

@{
    string GetBankName(string bankCode)
    {
        return bankCode?.ToLower() switch
        {
            "ing-bank" => "ING Bank",
            "cepteteb" => "CEPTETEB",
            "akbank" => "Akbank",
            "garanti-bbva" => "Garanti BBVA",
            "yapi-kredi" => "Yapı Kredi",
            "is-bankasi" => "İş Bankası",
            "qnb-finansbank" => "QNB Finansbank",
            "denizbank" => "DenizBank",
            "enpara" => "Enpara",
            "vakifbank" => "VakıfBank",
            "ziraat-bankasi" => "Ziraat Bankası",
            "halkbank" => "Halkbank",
            _ => bankCode?
                .Replace("-", " ")
                .ToUpper() ?? "Banka"
        };
    }

    string GetRate(string rate)
    {
        return rate?
            .Replace("Oran:", "")
            .Trim() ?? "--";
    }
}

<div class="bg-dark-surface rounded-lg p-stack-lg
    card-shadow border border-dark-border
    border-opacity-100 ring-1 ring-white/5">

    <!-- Başlık -->
    <div class="flex items-center justify-between
        mb-stack-md">

        <div class="flex items-center gap-3">

            <div class="w-10 h-10 rounded-xl
                bg-dark-primary/10
                border border-dark-primary/20
                text-dark-primary
                flex items-center justify-center">

                <span class="material-symbols-outlined">
                    account_balance
                </span>
            </div>

            <div>
                <h3 class="font-headline-sm text-headline-sm
                    text-dark-text">
                    İhtiyaç Kredisi Teklifleri
                </h3>

                <p class="text-xs text-dark-text-muted mt-1">
                    1.000 TL · 12 ay vade
                </p>
            </div>
        </div>

        <div class="hidden sm:flex items-center gap-2
            px-2.5 py-1 rounded-full
            bg-dark-primary/10
            border border-dark-primary/20">

            <span class="material-symbols-outlined
                text-sm text-dark-primary">
                compare_arrows
            </span>

            <span class="text-[10px] font-semibold
                text-dark-primary uppercase">
                Karşılaştır
            </span>
        </div>
    </div>

    <!-- Sütun başlıkları -->
    <div class="grid grid-cols-12 gap-2
        px-3 pb-2 border-b border-dark-border
        text-[10px] uppercase tracking-wider
        text-dark-text-muted">

        <div class="col-span-5">
            Banka ve Kredi
        </div>

        <div class="col-span-2 text-right">
            Faiz
        </div>

        <div class="col-span-2 text-right">
            Aylık
        </div>

        <div class="col-span-3 text-right">
            Toplam
        </div>
    </div>

    <!-- Teklif listesi -->
    <div class="divide-y divide-dark-border">

        @for (var i = 0; i < Model.Count; i++)
        {
            var credit = Model[i];
            var isBestOffer = i == 0;

            <div class="relative grid grid-cols-12 gap-2
                items-center px-3 py-4
                hover:bg-dark-surface-elevated
                transition-colors rounded-lg">

                <!-- Banka ve kredi adı -->
                <div class="col-span-5 flex items-center gap-3">

                    <div class="w-10 h-10 rounded-xl
                        @(isBestOffer
                                                     ? "bg-[#22c55e]/10 border-[#22c55e]/20 text-[#22c55e]"
                                                     : "bg-dark-primary/10 border-dark-primary/20 text-dark-primary")
                        border flex items-center
                        justify-center shrink-0">

                        <span class="material-symbols-outlined">
                            account_balance
                        </span>
                    </div>

                    <div class="min-w-0">

                        <div class="flex items-center gap-2">

                            <span class="font-body-sm font-semibold
                                text-dark-text">
                                @GetBankName(credit.BankCode)
                            </span>

                            @if (isBestOffer)
                            {
                                <span class="hidden xl:inline-flex
                                    px-2 py-0.5 rounded-full
                                    bg-[#22c55e]/10
                                    text-[#22c55e]
                                    text-[9px] font-semibold">
                                    EN UYGUN
                                </span>
                            }
                        </div>

                        <div class="text-xs text-dark-text-muted
                            truncate mt-1"
                             title="@credit.CreditName">
                            @credit.CreditName
                        </div>
                    </div>
                </div>

                <!-- Faiz oranı -->
                <div class="col-span-2 text-right">

                    <div class="inline-flex items-center gap-1
                        px-2 py-1 rounded-lg
                        @(isBestOffer
                                                     ? "bg-[#22c55e]/10 text-[#22c55e]"
                                                     : "bg-dark-primary/10 text-dark-primary")">

                        <span class="material-symbols-outlined
                            text-sm">
                            percent
                        </span>

                        <span class="text-xs font-semibold">
                            @GetRate(credit.InterestRate)
                        </span>
                    </div>
                </div>

                <!-- Aylık ödeme -->
                <div class="col-span-2 text-right">

                    <div class="font-numeric-data text-sm
                        font-semibold text-dark-text">
                        @credit.MonthlyPayment
                    </div>

                    <div class="text-[10px]
                        text-dark-text-muted mt-1">
                        Taksit
                    </div>
                </div>

                <!-- Toplam ödeme -->
                <div class="col-span-3 flex items-center
                    justify-end gap-3">

                    <div class="text-right">

                        <div class="font-numeric-data text-sm
                            font-semibold text-dark-text">
                            @credit.TotalPayment
                        </div>

                        <div class="text-[10px]
                            text-dark-text-muted mt-1">
                            Toplam ödeme
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(credit.Url))
                    {
                        <a href="@credit.Url"
                               target="_blank"
                               rel="noopener noreferrer"
                               title="Kredi detayını görüntüle"
                               class="w-8 h-8 rounded-lg
                            border border-dark-border
                            text-dark-text-muted
                            hover:bg-dark-primary/10
                            hover:text-dark-primary
                            hover:border-dark-primary/30
                            transition-all
                            flex items-center justify-center"
                               style="text-decoration:none;">

                            <span class="material-symbols-outlined
                                text-lg">
                                arrow_outward
                            </span>
                        </a>
                    }
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="flex flex-col items-center
                justify-center py-12
                text-dark-text-muted">

                <span class="material-symbols-outlined
                    text-4xl text-dark-primary mb-2">
                    account_balance
                </span>

                <p class="text-sm">
                    Kredi teklifleri alınamadı.
                </p>
            </div>
        }
    </div>

    <!-- Alt bilgi -->
    <div class="flex items-center justify-between
        gap-3 border-t border-dark-border
        pt-3 mt-2 text-xs text-dark-text-muted">

        <span class="flex items-center gap-2">

            <span class="material-symbols-outlined text-sm">
                info
            </span>

            Teklifler bankaların koşullarına göre değişebilir.
        </span>

        <span class="hidden sm:flex items-center gap-1">

            <span class="material-symbols-outlined text-sm">
                verified
            </span>

            Güncel teklifler
        </span>
    </div>
</div>