@using System.Globalization
@model IdentityEmailApp.DTOs.WeatherDtos.GetCityWeatherDto


@{
    var currentWeather = Model?.Forecasts?.FirstOrDefault();

    var weatherDescription = currentWeather?
        .Weather?
        .FirstOrDefault();

    var culture = new CultureInfo("tr-TR");

    var description = weatherDescription?.Description;

    if (!string.IsNullOrWhiteSpace(description))
    {
        description = culture.TextInfo.ToTitleCase(description);
    }

    var iconUrl = weatherDescription != null
        ? $"https://openweathermap.org/img/wn/{weatherDescription.Icon}@2x.png"
        : null;

    double ConvertToCelsius(double temperature)
    {
        return temperature > 100
            ? temperature - 273.15
            : temperature;
    }

    var temperatureCelsius = currentWeather != null
        ? Math.Round(
            ConvertToCelsius(currentWeather.Main.Temperature))
        : 0;

    var feelsLikeCelsius = currentWeather != null
        ? Math.Round(
            ConvertToCelsius(currentWeather.Main.FeelsLike))
        : 0;

    var windSpeedKm = currentWeather != null
        ? Math.Round(currentWeather.Wind.Speed * 3.6, 1)
        : 0;
}
@if (currentWeather != null)
{
    <div class="bg-gradient-to-br from-[#1a2332] via-[#00374d] to-[#00a6e0]
        rounded-2xl p-lg ghost-border relative overflow-hidden
        backdrop-blur-md border border-white/20 shadow-xl">

        <!-- Arka plan parlama efekti -->
        <div class="absolute -top-16 -right-16 w-48 h-48
            bg-secondary/30 blur-[80px] rounded-full animate-pulse">
        </div>

        <div class="absolute inset-0 opacity-10 pointer-events-none"
             style="background-image:
            radial-gradient(circle at 2px 2px, white 1px, transparent 0px);
            background-size: 24px 24px;">
        </div>

        <div class="relative z-10">

            <div class="flex justify-between items-start mb-md">

                <div>
                    <p class="font-label-md text-label-md
                        text-on-surface-variant uppercase
                        tracking-widest">

                        @Model.City.Name
                    </p>

                    <h3 class="font-display-lg text-display-lg
                        text-on-surface leading-none mt-1
                        drop-shadow-md">

                      @temperatureCelsius°C
                    </h3>
                </div>

                <div class="text-right">

                    @if (!string.IsNullOrWhiteSpace(weatherDescription?.Icon))
                    {
                        <img src="@($"https://openweathermap.org/img/wn/{weatherDescription.Icon}@2x.png")"
                             alt="@description"
                             width="80"
                             height="80"
                             class="w-20 h-20 object-contain
                        drop-shadow-[0_0_15px_rgba(123,208,255,0.8)]" />
                    }

                    <p class="font-label-md text-label-md
                        text-on-surface mt-1">

                        @description
                    </p>
                </div>

            </div>

            <div class="flex justify-between items-center
                text-on-surface-variant">

                <div class="flex flex-col">
                    <span class="font-label-md text-label-md opacity-60">
                        Nem
                    </span>

                    <span class="font-body-md text-body-md text-on-surface">
                        %@currentWeather.Main.Humidity
                    </span>
                </div>

                <div class="flex flex-col">
                    <span class="font-label-md text-label-md opacity-60">
                        Rüzgâr
                    </span>

                    <span class="font-body-md text-body-md text-on-surface">
                        @windSpeedKm km/sa
                    </span>
                </div>

                <div class="flex flex-col">
                    <span class="font-label-md text-label-md opacity-60">
                        Hissedilen
                    </span>

                    <span class="font-body-md text-body-md text-on-surface">
                        @feelsLikeCelsius°C
                    </span>
                </div>

            </div>

        </div>
    </div>
}
else
{
    <div class="bg-gradient-to-br from-[#1a2332] via-[#00374d] to-[#00a6e0]
        rounded-2xl p-lg border border-white/20 shadow-xl">

        <p class="text-on-surface">
            Hava durumu bilgisi alınamadı.
        </p>
    </div>
}

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const weatherContainer =
            document.getElementById("weatherComponent");

        if (!weatherContainer) {
            return;
        }

        const savedLatitude =
            localStorage.getItem("notikaLatitude");

        const savedLongitude =
            localStorage.getItem("notikaLongitude");

        function getWeather(latitude, longitude) {

            const url =
                '@Url.Action("GetByLocation", "Weather")' +
                '?latitude=' + encodeURIComponent(latitude) +
                '&longitude=' + encodeURIComponent(longitude);

            fetch(url)
                .then(function (response) {

                    if (!response.ok) {
                        throw new Error("Hava durumu alınamadı.");
                    }

                    return response.text();
                })
                .then(function (html) {
                    weatherContainer.innerHTML = html;
                })
                .catch(function (error) {
                    console.error(
                        "Hava durumu yüklenirken hata oluştu:",
                        error
                    );
                });
        }

        // Daha önce kaydedilen konum varsa doğrudan kullan
        if (savedLatitude && savedLongitude) {
            getWeather(savedLatitude, savedLongitude);
            return;
        }

        // Kayıtlı konum yoksa kullanıcıdan konum iste
        if (!navigator.geolocation) {
            console.log(
                "Tarayıcı konum özelliğini desteklemiyor. İstanbul gösteriliyor."
            );

            return;
        }

        navigator.geolocation.getCurrentPosition(
            function (position) {

                const latitude = position.coords.latitude;
                const longitude = position.coords.longitude;

                // Konumu tarayıcı hafızasına kaydet
                localStorage.setItem(
                    "notikaLatitude",
                    latitude
                );

                localStorage.setItem(
                    "notikaLongitude",
                    longitude
                );

                getWeather(latitude, longitude);
            },
            function (error) {
                console.log(
                    "Konum izni verilmedi. İstanbul gösteriliyor.",
                    error
                );
            },
            {
                enableHighAccuracy: false,
                timeout: 10000,
                maximumAge: 600000
            }
        );
    });
</script>