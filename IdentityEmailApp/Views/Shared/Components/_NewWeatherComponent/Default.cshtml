
@*
   _NewWeatherComponent
*@



<div class="bg-gradient-to-br from-[#1a2332] via-[#00374d] to-[#00a6e0] rounded-2xl p-lg ghost-border relative overflow-hidden backdrop-blur-md border border-white/20 shadow-xl">
    <!-- Subtle Glow Effect -->
    <div class="absolute -top-16 -right-16 w-48 h-48 bg-secondary/30 blur-[80px] rounded-full animate-pulse"></div><div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0px); background-size: 24px 24px;"></div>
    <div class="flex justify-between items-start mb-md">
        <div>
            <p class="font-label-md text-label-md text-on-surface-variant uppercase tracking-widest">İstanbul</p>
            <h3 class="font-display-lg text-display-lg text-on-surface leading-none mt-1 drop-shadow-md">23°C</h3>
        </div>
        <div class="text-right">
            <span class="material-symbols-outlined text-secondary text-6xl drop-shadow-[0_0_15px_rgba(123,208,255,0.8)]" style='font-variation-settings: "FILL" 1;'>sunny</span>
            <p class="font-label-md text-label-md text-on-surface mt-1">Güneşli</p>
        </div>
    </div>
    <div class="flex justify-between items-center text-on-surface-variant">
        <div class="flex flex-col">
            <span class="font-label-md text-label-md opacity-60">Nem</span>
            <span class="font-body-md text-body-md text-on-surface">%45</span>
        </div>
        <div class="flex flex-col">
            <span class="font-label-md text-label-md opacity-60">Rüzgar</span>
            <span class="font-body-md text-body-md text-on-surface">12 km/s</span>
        </div>
        <div class="flex flex-col">
            <span class="font-label-md text-label-md opacity-60">Hissedilen</span>
            <span class="font-body-md text-body-md text-on-surface">25°</span>
        </div>
    </div>
</div>