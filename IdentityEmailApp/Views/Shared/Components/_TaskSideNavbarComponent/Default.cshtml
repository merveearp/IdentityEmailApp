
@*
  _TaskSideNavbarComponent
*@

<nav class="w-sidebar-width flex-shrink-0 flex flex-col bg-background h-full rounded-lg">
    <div class="mb-stack-lg px-2">
        <a asp-controller="Task"
               asp-action="CreateTask"

               class="flex items-center justify-center gap-2 bg-primary text-on-primary
            font-label-lg text-label-lg h-12 rounded-lg w-full
            hover:bg-primary-container-variant transition-colors shadow-sm">

            <span class="material-symbols-outlined">
                edit
            </span>

            Görev Oluştur
        </a>
    </div>
    <div class="mb-stack-lg px-2">
        <a asp-controller="Task"
               asp-action="TaskList"
               class="flex items-center gap-3 px-4 py-3 rounded-full
            text-on-surface-variant hover:bg-surface-container">

            <span class="material-symbols-outlined">
                folder_open
            </span>

            Kategori Listesi
        </a>
    </div>
    <div class="flex-1 overflow-y-auto space-y-1 pr-2">
        <a asp-controller="Task"
               asp-action="Index"
               class="flex items-center gap-3 px-4 py-3 rounded-full
            text-on-surface-variant hover:bg-surface-container
            transition-colors">

            <span class="material-symbols-outlined">
                task_alt
            </span>

            Görevler
        </a>
        <a asp-controller="Task"
               asp-action="StarredIndex"
               class="flex items-center gap-3 px-4 py-3 rounded-full
            text-on-surface-variant hover:bg-surface-container">

            <span class="material-symbols-outlined text-yellow-500"
                  style="font-variation-settings:
                'FILL' 1,
                'wght' 500,
                'GRAD' 0,
                'opsz' 24;">
                star
            </span>

            Yıldızlı
        </a>
        <a asp-controller="Task"
               asp-action="UnCompletedIndex"
               class="flex items-center gap-3 px-4 py-3 rounded-full
            text-on-surface-variant hover:bg-surface-container">

            <span class="material-symbols-outlined text-blue-600">
                pending_actions
            </span>

            Devam Edenler
        </a>

        <a asp-controller="Task"
               asp-action="CompletedIndex"
               class="flex items-center gap-3 px-4 py-3 rounded-full
            text-on-surface-variant hover:bg-surface-container">

            <span class="material-symbols-outlined text-green-600">
                task_alt
            </span>

            Tamamlananlar
        </a>
        <a asp-controller="Task"
               asp-action="DeletedIndex"
               class="flex items-center gap-3 px-4 py-3 rounded-full
            text-on-surface-variant hover:bg-surface-container">

            <span class="material-symbols-outlined">
                delete
            </span>

            Silinen Görevler
        </a>
       
       
       
        @await Component.InvokeAsync("_TaskListComponent")
        
    </div>
</nav>