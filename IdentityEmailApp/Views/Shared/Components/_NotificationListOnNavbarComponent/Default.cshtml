@using IdentityEmailApp.Enums
@model List<Notification>

<li class="nav-item dropdown navbar-top-item">

    <a href="#"
           data-toggle="dropdown"
           role="button"
           aria-expanded="false"
           class="nav-link dropdown-toggle navbar-top-trigger">

        <span>
            <i class="notika-icon notika-alarm"></i>
        </span>

        <span class="navbar-top-badge">
            @ViewBag.NotificationCount
        </span>

    </a>

    <div role="menu"
         class="dropdown-menu message-dd notification-dd animated zoomIn navbar-notification-menu">

        <div class="hd-mg-tt">
            <h2>Bildirimler</h2>
        </div>

        <div class="hd-message-info">

            @foreach (var item in Model)
            {
                <a href="#">

                    <div class="hd-message-sn">

                        <div class="hd-message-img">

   
                             
                    

                        </div>

                        <div class="hd-mg-ctn">

                            <h3>@item.Title</h3>

                            <p>
                                @(item.Detail.Length > 45
                                    ? item.Detail.Substring(0, 45) + "..."
                                    : item.Detail)
                            </p>

                            <small class="text-muted">
                                @item.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                            </small>

                        </div>

                    </div>

                </a>
            }

            @if (!Model.Any())
            {
                <div class="text-center p-3">
                    Bildirim bulunamadı.
                </div>
            }

        </div>

        <div class="hd-mg-va">
            <a href="/Notification/Index">
                Tüm Bildirimleri Görüntüle
            </a>
        </div>

    </div>

</li>