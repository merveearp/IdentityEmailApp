@using System.Text.Json
@using IdentityEmailApp.DTOs.FinanceDtos
@model List<FinanceLiveStockResultDto>

@{
    var initialStocksJson = JsonSerializer.Serialize(
        Model,
        new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        });
}

<div class="lg:col-span-2 bg-dark-surface rounded-lg
    p-stack-lg card-shadow border border-dark-border
    border-opacity-100 ring-1 ring-white/5">

    <!-- Başlık -->
    <div class="flex flex-col sm:flex-row
        sm:items-center sm:justify-between
        gap-3 mb-stack-lg">

        <div>
            <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full
                    bg-[#22c55e] animate-pulse">
                </span>

                <h3 class="font-label-md text-label-md
                    text-dark-text-muted uppercase
                    tracking-wider">
                    Canlı Piyasa – En Hareketli 5 Hisse
                </h3>
            </div>

            <p class="text-xs text-dark-text-muted mt-2">
                Anlık fiyat ve değişim oranları
            </p>
        </div>

        <div class="flex items-center gap-2 text-xs
            text-dark-text-muted">

            <span class="material-symbols-outlined
                text-sm text-[#22c55e]">
                schedule
            </span>

            <span id="liveUpdateTime">
                Son güncelleme:
                @(Model.FirstOrDefault()?.Time ?? "--")
            </span>
        </div>
    </div>

    <!-- Tablo -->
    <div class="overflow-x-auto rounded-lg
        border border-dark-border bg-dark-bg">

        <table class="w-full text-left">

            <thead class="bg-dark-surface-elevated
                border-b border-dark-border">

                <tr class="text-xs uppercase tracking-wider
                    text-dark-text-muted">

                    <th class="px-5 py-4 font-medium">
                        Hisse
                    </th>

                    <th class="px-5 py-4 font-medium">
                        Son Fiyat
                    </th>

                    <th class="px-5 py-4 font-medium">
                        Değişim
                    </th>

                    <th class="px-5 py-4 font-medium">
                        Para Birimi
                    </th>

                    <th class="px-5 py-4 font-medium">
                        Son İşlem
                    </th>

                    <th class="px-5 py-4 font-medium text-right">
                        Durum
                    </th>
                </tr>
            </thead>

            <tbody id="liveStocksTableBody"
                   class="divide-y divide-dark-border">

                @foreach (var stock in Model)
                {
                    var isRising = stock.Rate > 0;
                    var isFalling = stock.Rate < 0;

                    var rateColor = isRising
                        ? "#22c55e"
                        : isFalling
                            ? "#ef4444"
                            : "#94a3b8";

                    var icon = isRising
                        ? "trending_up"
                        : isFalling
                            ? "trending_down"
                            : "trending_flat";

                    var status = isRising
                        ? "Yükseliyor"
                        : isFalling
                            ? "Düşüyor"
                            : "Sabit";

                    <tr data-stock="@stock.Name"
                        class="hover:bg-dark-surface-elevated
                        transition-colors">

                        <td class="px-5 py-4">
                            <div class="flex items-center gap-3">

                                <div class="w-9 h-9 rounded-lg
                                    bg-dark-surface-elevated
                                    border border-dark-border
                                    flex items-center justify-center">

                                    <span class="material-symbols-outlined
                                        text-dark-primary text-lg">
                                        monitoring
                                    </span>
                                </div>

                                <div>
                                    <div class="text-sm font-semibold
                                        text-dark-text">
                                        @stock.Name
                                    </div>

                                    <div class="text-xs
                                        text-dark-text-muted">
                                        Borsa İstanbul
                                    </div>
                                </div>
                            </div>
                        </td>

                        <td class="px-5 py-4">
                            <span class="font-numeric-data
                                text-sm font-semibold
                                text-dark-text">
                                @stock.PriceStr ₺
                            </span>
                        </td>

                        <td class="px-5 py-4">
                            <span class="inline-flex items-center
                                gap-1 text-sm font-semibold"
                                  style="color: @rateColor">

                                <span class="material-symbols-outlined
                                    text-base">
                                    @icon
                                </span>

                                @(stock.Rate >= 0
                                    ? $"+%{stock.Rate:N2}"
                                    : $"-%{Math.Abs(stock.Rate):N2}")
                            </span>
                        </td>

                        <td class="px-5 py-4">
                            <span class="text-xs text-dark-text-muted">
                                @stock.Currency
                            </span>
                        </td>

                        <td class="px-5 py-4">
                            <span class="text-xs text-dark-text-muted">
                                @stock.Time
                            </span>
                        </td>

                        <td class="px-5 py-4 text-right">
                            <span class="inline-flex items-center
                                gap-1.5 px-2.5 py-1
                                rounded-full text-xs font-medium"
                                  style="color: @rateColor;
                                background-color:
                                @(isRising
                                                                      ? "rgba(34,197,94,0.12)"
                                                                      : isFalling
                                                                          ? "rgba(239,68,68,0.12)"
                                                                          : "rgba(148,163,184,0.12)")">

                                <span class="w-1.5 h-1.5 rounded-full"
                                      style="background-color: @rateColor">
                                </span>

                                @status
                            </span>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6"
                            class="px-5 py-12 text-center
                            text-dark-text-muted">
                            Canlı borsa verisi alınamadı.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Alt bilgi -->
    <div class="flex items-center justify-between mt-4
        text-xs text-dark-text-muted">

        <span>
            Veriler otomatik olarak güncellenir.
        </span>

      
    </div>
</div>

<script>
    const initialStocks = @Html.Raw(initialStocksJson);

    const tableBody =
        document.getElementById("liveStocksTableBody");

    const previousPrices = {};

    initialStocks.forEach(stock => {
        previousPrices[stock.name] =
            Number(stock.price);
    });

    function formatRate(rate) {
        const numericRate = Number(rate);

        const formattedRate =
            Math.abs(numericRate).toLocaleString(
                "tr-TR",
                {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }
            );

        return numericRate >= 0
            ? `+%${formattedRate}`
            : `-%${formattedRate}`;
    }

    function getStockStatus(rate) {
        const numericRate = Number(rate);

        if (numericRate > 0) {
            return {
                text: "Yükseliyor",
                icon: "trending_up",
                color: "#22c55e",
                background: "rgba(34,197,94,0.12)"
            };
        }

        if (numericRate < 0) {
            return {
                text: "Düşüyor",
                icon: "trending_down",
                color: "#ef4444",
                background: "rgba(239,68,68,0.12)"
            };
        }

        return {
            text: "Sabit",
            icon: "trending_flat",
            color: "#94a3b8",
            background: "rgba(148,163,184,0.12)"
        };
    }

    function renderLiveStocks(stocks) {
        tableBody.innerHTML = "";

        if (!stocks || stocks.length === 0) {
            tableBody.innerHTML = `
                <tr>
                    <td colspan="6"
                        class="px-5 py-12 text-center
                               text-dark-text-muted">
                        Canlı borsa verisi alınamadı.
                    </td>
                </tr>`;

            return;
        }

        stocks.forEach(stock => {
            const status =
                getStockStatus(stock.rate);

            const oldPrice =
                previousPrices[stock.name];

            const newPrice =
                Number(stock.price);

            let rowBackground = "transparent";

            // Bir önceki isteğe göre fiyat değişimi
            if (oldPrice !== undefined) {
                if (newPrice > oldPrice) {
                    rowBackground =
                        "rgba(34,197,94,0.06)";
                }
                else if (newPrice < oldPrice) {
                    rowBackground =
                        "rgba(239,68,68,0.06)";
                }
            }

            const row =
                document.createElement("tr");

            row.className =
                "hover:bg-dark-surface-elevated " +
                "transition-colors";

            row.dataset.stock = stock.name;
            row.style.backgroundColor = rowBackground;

            row.innerHTML = `
                <td class="px-5 py-4">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg
                                    bg-dark-surface-elevated
                                    border border-dark-border
                                    flex items-center justify-center">

                            <span class="material-symbols-outlined
                                         text-dark-primary text-lg">
                                monitoring
                            </span>
                        </div>

                        <div>
                            <div class="text-sm font-semibold
                                        text-dark-text">
                                ${stock.name}
                            </div>

                            <div class="text-xs
                                        text-dark-text-muted">
                                Borsa İstanbul
                            </div>
                        </div>
                    </div>
                </td>

                <td class="px-5 py-4">
                    <span class="font-numeric-data text-sm
                                 font-semibold text-dark-text">
                        ${stock.priceStr} ₺
                    </span>
                </td>

                <td class="px-5 py-4">
                    <span class="inline-flex items-center
                                 gap-1 text-sm font-semibold"
                          style="color:${status.color}">

                        <span class="material-symbols-outlined
                                     text-base">
                            ${status.icon}
                        </span>

                        ${formatRate(stock.rate)}
                    </span>
                </td>

                <td class="px-5 py-4">
                    <span class="text-xs text-dark-text-muted">
                        ${stock.currency}
                    </span>
                </td>

                <td class="px-5 py-4">
                    <span class="text-xs text-dark-text-muted">
                        ${stock.time}
                    </span>
                </td>

                <td class="px-5 py-4 text-right">
                    <span class="inline-flex items-center gap-1.5
                                 px-2.5 py-1 rounded-full
                                 text-xs font-medium"
                          style="color:${status.color};
                                 background-color:${status.background}">

                        <span class="w-1.5 h-1.5 rounded-full"
                              style="background-color:${status.color}">
                        </span>

                        ${status.text}
                    </span>
                </td>`;

            tableBody.appendChild(row);

            previousPrices[stock.name] =
                newPrice;

            // Anlık değişim rengini kısa süre sonra kaldır
            setTimeout(() => {
                row.style.backgroundColor =
                    "transparent";
            }, 1200);
        });

        document.getElementById(
            "liveUpdateTime"
        ).textContent =
            `Son güncelleme: ${stocks[0]?.time ?? "--"}`;
    }

    async function updateLiveStocksTable() {
        try {
            const response = await fetch(
                "/Finance/GetLiveStocks"
            );

            if (!response.ok) {
                throw new Error(
                    "Canlı borsa verisi alınamadı."
                );
            }

            const stocks =
                await response.json();

            renderLiveStocks(stocks);
        }
        catch (error) {
            console.error(
                "Canlı borsa hatası:",
                error
            );
        }
    }

    // Her 15 saniyede tabloyu güncelle
    setInterval(
        updateLiveStocksTable,
        15000
    );
</script>