@using System.Globalization
@using IdentityEmailApp.DTOs.FinanceDtos
@model List<FinanceCurrencyResultDto>



@{
    var culture = new CultureInfo("tr-TR");
}

<section>

    <h2 class="font-headline-sm text-headline-sm
        text-dark-text mb-stack-md">
        Piyasa Özeti
    </h2>

    <div class="grid grid-cols-2 md:grid-cols-3
        lg:grid-cols-5 gap-gutter">

        @foreach (var item in Model)
        {
            var currencyCode = item.Name.Split(' ')[0];

            var currencyName = currencyCode switch
            {
                "USD" => "Dolar/TL",
                "EUR" => "Euro/TL",
                "GBP" => "Sterlin/TL",
                "CHF" => "İsviçre Frangı/TL",
                "JPY" => "Japon Yeni/TL",
                _ => item.Name
            };

            var currencyIcon = currencyCode switch
            {
                "USD" => "attach_money",
                "EUR" => "euro",
                "GBP" => "currency_pound",
                "JPY" => "currency_yen",
                _ => "currency_exchange"
            };

            <div class="bg-dark-surface rounded-lg p-stack-md
                card-shadow border border-dark-border
                flex flex-col justify-between
                border-opacity-100 ring-1 ring-white/5">

                <div class="flex justify-between
                    items-start mb-stack-sm">

                    <span class="font-label-md text-label-md
                        text-dark-text-muted">
                        @currencyName
                    </span>

                    <span class="material-symbols-outlined
                        text-dark-primary text-sm">
                        @currencyIcon
                    </span>
                </div>

                <div class="flex items-end justify-between">

                    <div>
                        <!-- Satış fiyatı -->
                        <div class="font-numeric-data
                            text-numeric-data text-dark-text">

                            @item.Selling.ToString("N4", culture) ₺
                        </div>

                        <!-- Alış fiyatı -->
                        <div class="text-xs text-[#22c55e]
                            flex items-center font-medium mt-1">

                            <span class="material-symbols-outlined
                                text-[11px] mr-1">
                                south_west
                            </span>

                            Alış:
                            @item.Buying.ToString("N4", culture) ₺
                        </div>
                    </div>

                    <div class="flex flex-col items-end">

                        <span class="text-[10px]
                            text-dark-text-muted">
                            SATIŞ
                        </span>

                        <span class="text-xs font-semibold
                            text-dark-primary mt-1">
                            @currencyCode
                        </span>
                    </div>
                </div>
            </div>
        }
    </div>
</section>