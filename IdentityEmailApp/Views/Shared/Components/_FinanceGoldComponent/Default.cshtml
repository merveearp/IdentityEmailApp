@using System.Globalization
@using IdentityEmailApp.DTOs.FinanceDtos
@model List<FinanceGoldResultDto>

@{
    var trCulture = new CultureInfo("tr-TR");

    string FormatPrice(string value)
    {
        if (decimal.TryParse(
            value,
            NumberStyles.Number,
            trCulture,
            out var price))
        {
            return price.ToString("N2", trCulture);
        }

        return value ?? "--";
    }

    string FormatPercent(string value)
    {
        if (decimal.TryParse(
            value,
            NumberStyles.Any,
            CultureInfo.InvariantCulture,
            out var percent))
        {
            var sign = percent > 0 ? "+" : "";

            return $"{sign}%{percent.ToString("N2", trCulture)}";
        }

        return $"%{value}";
    }

    var lastUpdate =
        Model.FirstOrDefault()?.LastUpdate ?? "--";
}

<div class="bg-dark-surface rounded-lg p-stack-lg
    card-shadow border border-dark-border
    border-opacity-100 ring-1 ring-white/5">

    <!-- Başlık -->
    <div class="flex items-center justify-between
        mb-stack-md">

        <div class="flex items-center gap-3">

            <div class="w-10 h-10 rounded-xl
                bg-[#f59e0b]/10
                border border-[#f59e0b]/20
                flex items-center justify-center">

                <span class="material-symbols-outlined
                    text-[#f59e0b]">
                    diamond
                </span>
            </div>

            <div>
                <h3 class="font-headline-sm text-headline-sm
                    text-dark-text">
                    Altın Fiyatları
                </h3>

                <p class="text-xs text-dark-text-muted mt-1">
                    Canlı alış ve satış değerleri
                </p>
            </div>
        </div>

        <div class="text-right">

            <div class="inline-flex items-center gap-2
                px-2.5 py-1 rounded-full
                bg-[#22c55e]/10
                border border-[#22c55e]/20">

                <span class="w-1.5 h-1.5 rounded-full
                    bg-[#22c55e] animate-pulse">
                </span>

                <span class="text-[10px] font-semibold
                    text-[#22c55e] uppercase">
                    Canlı
                </span>
            </div>

            <p class="text-[10px] text-dark-text-muted mt-2">
                @lastUpdate
            </p>
        </div>
    </div>

    <!-- Sütun başlıkları -->
    <div class="grid grid-cols-12 gap-2
        px-3 pb-2 border-b border-dark-border
        text-[10px] uppercase tracking-wider
        text-dark-text-muted">

        <div class="col-span-5">
            Altın Türü
        </div>

        <div class="col-span-2 text-right">
            Alış
        </div>

        <div class="col-span-2 text-right">
            Satış
        </div>

        <div class="col-span-3 text-right">
            Değişim
        </div>
    </div>

    <!-- Altın listesi -->
    <div class="divide-y divide-dark-border">

        @foreach (var gold in Model)
        {
            var goldIcon = gold.Key switch
            {
                var name when name.Contains(
                    "GRAM",
                    StringComparison.OrdinalIgnoreCase)
                    => "diamond",

                var name when name.Contains(
                    "ÇEYREK",
                    StringComparison.OrdinalIgnoreCase)
                    => "monetization_on",

                var name when name.Contains(
                    "YARIM",
                    StringComparison.OrdinalIgnoreCase)
                    => "toll",

                var name when name.Contains(
                    "TAM",
                    StringComparison.OrdinalIgnoreCase)
                    => "workspace_premium",

                var name when name.Contains(
                    "ATA",
                    StringComparison.OrdinalIgnoreCase)
                    => "military_tech",

                _ => "savings"
            };

            var isRising = string.Equals(
                gold.Arrow,
                "up",
                StringComparison.OrdinalIgnoreCase);

            var isFalling = string.Equals(
                gold.Arrow,
                "down",
                StringComparison.OrdinalIgnoreCase);

            var changeColor = isRising
                ? "#22c55e"
                : isFalling
                    ? "#ef4444"
                    : "#94a3b8";

            var changeIcon = isRising
                ? "trending_up"
                : isFalling
                    ? "trending_down"
                    : "trending_flat";

            <div class="grid grid-cols-12 gap-2
                items-center px-3 py-4
                hover:bg-dark-surface-elevated
                transition-colors rounded-lg">

                <!-- Altın adı -->
                <div class="col-span-5 flex items-center gap-3">

                    <div class="w-10 h-10 rounded-xl
                        bg-gradient-to-br
                        from-[#fbbf24]/20
                        to-[#f59e0b]/5
                        border border-[#f59e0b]/20
                        flex items-center justify-center
                        shrink-0">

                        <span class="material-symbols-outlined
                            text-[#fbbf24] text-xl">
                            @goldIcon
                        </span>
                    </div>

                    <div class="min-w-0">

                        <div class="font-body-sm font-semibold
                            text-dark-text truncate"
                             title="@gold.Key">
                            @gold.Key
                        </div>

                        <div class="flex items-center gap-1
                            text-[10px]
                            text-dark-text-muted mt-1">

                            <span class="material-symbols-outlined
                                text-[12px]">
                                schedule
                            </span>

                            @gold.LastUpdate
                        </div>
                    </div>
                </div>

                <!-- Alış -->
                <div class="col-span-2 text-right">

                    <div class="font-numeric-data text-sm
                        font-semibold text-[#22c55e]">
                        @FormatPrice(gold.Buy) ₺
                    </div>

                    <div class="text-[10px]
                        text-dark-text-muted mt-1">
                        ALIŞ
                    </div>
                </div>

                <!-- Satış -->
                <div class="col-span-2 text-right">

                    <div class="font-numeric-data text-sm
                        font-semibold text-dark-text">
                        @FormatPrice(gold.Sell) ₺
                    </div>

                    <div class="text-[10px]
                        text-dark-text-muted mt-1">
                        SATIŞ
                    </div>
                </div>

                <!-- Değişim -->
                <div class="col-span-3 flex justify-end">

                    <div class="inline-flex items-center gap-1
                        px-2.5 py-1.5 rounded-lg"
                         style="color:@changeColor;
                        background-color:
                        @(isRising
                                                     ? "rgba(34,197,94,0.10)"
                                                     : isFalling
                                                         ? "rgba(239,68,68,0.10)"
                                                         : "rgba(148,163,184,0.10)")">

                        <span class="material-symbols-outlined
                            text-base">
                            @changeIcon
                        </span>

                        <span class="text-xs font-semibold">
                            @FormatPercent(gold.Percent)
                        </span>
                    </div>
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="flex flex-col items-center
                justify-center py-12
                text-dark-text-muted">

                <span class="material-symbols-outlined
                    text-4xl text-[#f59e0b] mb-2">
                    diamond
                </span>

                <p class="text-sm">
                    Altın fiyatları alınamadı.
                </p>
            </div>
        }
    </div>

    <!-- Alt bilgi -->
    <div class="flex items-center justify-between
        border-t border-dark-border
        pt-3 mt-2 text-xs text-dark-text-muted">

        <span class="flex items-center gap-2">

            <span class="material-symbols-outlined text-sm">
                info
            </span>

            Fiyatlar piyasa koşullarına göre değişebilir.
        </span>

        <span class="hidden sm:flex items-center gap-1">

            <span class="material-symbols-outlined text-sm">
                currency_lira
            </span>

            Türk Lirası
        </span>
    </div>
</div>