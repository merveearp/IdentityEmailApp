@*
    _TranslateHeaderComponent
*@

@{
    var fullName =
        ViewBag.FullName as string ?? "Notika Kullanıcısı";

    var imageUrl =
        ViewBag.ImageUrl as string;
}

<header class="w-full h-16 sticky top-0 z-50
    bg-white/40 dark:bg-surface-container/40
    backdrop-blur-xl
    border-b border-white/20 dark:border-white/10
    shadow-sm flex items-center justify-between
    px-4 md:px-8">

    <!-- Mobil logo ve menü -->
    <div class="flex items-center md:hidden">

        <button type="button"
                id="translateMobileMenuButton"
                title="Menüyü aç"
                class="mr-3 text-primary
            hover:bg-white/30 rounded-full
            transition-all active:scale-95
            p-2 flex items-center justify-center">

            <span class="material-symbols-outlined">
                menu
            </span>
        </button>

        <div>
            <span class="block text-primary
                font-bold text-base leading-tight">
                NOTİKA
            </span>

            <span class="block text-[10px]
                text-on-surface-variant">
                Translate
            </span>
        </div>
    </div>

    <!-- Desktop boş alan -->
    <div class="hidden md:flex flex-1"></div>

    <!-- Sağ menü -->
    <div class="flex items-center gap-1 md:gap-3
        text-primary dark:text-inverse-primary">

        <!-- AI Destek -->
        <a asp-controller="AISupport"
               asp-action="Index"
               title="AI Destek"
               class="w-10 h-10 rounded-full
            flex items-center justify-center
            text-primary
            hover:bg-white/30
            dark:hover:bg-white/10
            transition-all active:scale-95"
               style="text-decoration:none;">

            <span class="material-symbols-outlined">
                support_agent
            </span>
        </a>

        <!-- Notika Mail -->
        <a asp-controller="Message"
               asp-action="Inbox"
               title="Notika Mail"
               class="w-10 h-10 rounded-full
            flex items-center justify-center
            text-primary
            hover:bg-white/30
            dark:hover:bg-white/10
            transition-all active:scale-95"
               style="text-decoration:none;">

            <span class="material-symbols-outlined">
                mail
            </span>
        </a>

        <!-- Uygulamalar -->
        <div id="translateAppsWrapper"
             class="relative">

            <button type="button"
                    id="translateAppsButton"
                    title="Notika Uygulamaları"
                    aria-expanded="false"
                    aria-controls="translateAppsMenu"
                    class="w-10 h-10 rounded-full
                flex items-center justify-center
                text-primary
                hover:bg-white/30
                dark:hover:bg-white/10
                transition-all active:scale-95">

                <span class="material-symbols-outlined">
                    apps
                </span>
            </button>

            <!-- Uygulama menüsü -->
            <div id="translateAppsMenu"
                 class="hidden absolute right-0 top-full mt-3
                w-[350px] max-w-[calc(100vw-24px)]
                bg-white rounded-2xl
                border border-slate-200
                shadow-[0_20px_60px_rgba(32,55,110,0.20)]
                overflow-hidden z-[100]">

                <!-- Menü oku -->
                <div class="absolute -top-2 right-3
                    w-4 h-4 rotate-45
                    bg-white border-l border-t
                    border-slate-200">
                </div>

                <!-- Başlık -->
                <div class="relative px-5 py-4
                    flex items-center gap-3
                    bg-gradient-to-r from-blue-50 to-white
                    border-b border-slate-100">

                    <div class="w-11 h-11 rounded-xl
                        bg-primary text-white
                        flex items-center justify-center
                        shadow-md">

                        <span class="material-symbols-outlined">
                            apps
                        </span>
                    </div>

                    <div>
                        <h3 class="m-0 text-base
                            font-bold text-slate-900">
                            Notika Uygulamaları
                        </h3>

                        <p class="m-0 mt-1 text-xs text-slate-500">
                            Kullanmak istediğiniz servisi seçin
                        </p>
                    </div>
                </div>

                <!-- Uygulamalar -->
                <div class="grid grid-cols-3 gap-2 p-4">

                    <!-- Mail -->
                    <a asp-controller="Message"
                           asp-action="Inbox"
                           class="group rounded-xl p-3
                        flex flex-col items-center gap-2
                        text-slate-600 hover:bg-blue-50
                        transition-colors"
                           style="text-decoration:none;">

                        <div class="w-11 h-11 rounded-xl
                            bg-blue-600 text-white
                            flex items-center justify-center
                            shadow-sm group-hover:scale-105
                            transition-transform">

                            <span class="material-symbols-outlined">
                                mail
                            </span>
                        </div>

                        <span class="text-xs font-medium">
                            Mail
                        </span>
                    </a>

                    <!-- Haberler -->
                    <a asp-controller="News"
                           asp-action="Index"
                           asp-route-category="latest"
                           class="group rounded-xl p-3
                        flex flex-col items-center gap-2
                        text-slate-600 hover:bg-sky-50
                        transition-colors"
                           style="text-decoration:none;">

                        <div class="w-11 h-11 rounded-xl
                            bg-sky-500 text-white
                            flex items-center justify-center
                            shadow-sm group-hover:scale-105
                            transition-transform">

                            <span class="material-symbols-outlined">
                                newspaper
                            </span>
                        </div>

                        <span class="text-xs font-medium">
                            Haberler
                        </span>
                    </a>

                    <!-- Finans -->
                    <a asp-controller="Finance"
                           asp-action="Index"
                           class="group rounded-xl p-3
                        flex flex-col items-center gap-2
                        text-slate-600 hover:bg-purple-50
                        transition-colors"
                           style="text-decoration:none;">

                        <div class="w-11 h-11 rounded-xl
                            bg-purple-500 text-white
                            flex items-center justify-center
                            shadow-sm group-hover:scale-105
                            transition-transform">

                            <span class="material-symbols-outlined">
                                monitoring
                            </span>
                        </div>

                        <span class="text-xs font-medium">
                            Finans
                        </span>
                    </a>

                    <!-- Görevler -->
                    <a asp-controller="Task"
                           asp-action="Index"
                           class="group rounded-xl p-3
                        flex flex-col items-center gap-2
                        text-slate-600 hover:bg-orange-50
                        transition-colors"
                           style="text-decoration:none;">

                        <div class="w-11 h-11 rounded-xl
                            bg-orange-500 text-white
                            flex items-center justify-center
                            shadow-sm group-hover:scale-105
                            transition-transform">

                            <span class="material-symbols-outlined">
                                task_alt
                            </span>
                        </div>

                        <span class="text-xs font-medium">
                            Görevler
                        </span>
                    </a>

                    <!-- Translate -->
                    <a asp-controller="Translate"
                           asp-action="Index"
                           class="group rounded-xl p-3
                        flex flex-col items-center gap-2
                        text-slate-600 bg-teal-50
                        hover:bg-teal-100
                        transition-colors"
                           style="text-decoration:none;">

                        <div class="w-11 h-11 rounded-xl
                            bg-teal-500 text-white
                            flex items-center justify-center
                            shadow-sm group-hover:scale-105
                            transition-transform">

                            <span class="material-symbols-outlined">
                                translate
                            </span>
                        </div>

                        <span class="text-xs font-medium">
                            Translate
                        </span>
                    </a>

                    <!-- Dashboard -->
                    <a asp-controller="Dashboard"
                           asp-action="Index"
                           class="group rounded-xl p-3
                        flex flex-col items-center gap-2
                        text-slate-600 hover:bg-emerald-50
                        transition-colors"
                           style="text-decoration:none;">

                        <div class="w-11 h-11 rounded-xl
                            bg-emerald-500 text-white
                            flex items-center justify-center
                            shadow-sm group-hover:scale-105
                            transition-transform">

                            <span class="material-symbols-outlined">
                                bar_chart
                            </span>
                        </div>

                        <span class="text-xs font-medium">
                            Panel
                        </span>
                    </a>

                    <!-- Ayarlar -->
                    <a asp-controller="Settings"
                           asp-action="Index"
                           class="group rounded-xl p-3
                        flex flex-col items-center gap-2
                        text-slate-600 hover:bg-slate-100
                        transition-colors"
                           style="text-decoration:none;">

                        <div class="w-11 h-11 rounded-xl
                            bg-slate-500 text-white
                            flex items-center justify-center
                            shadow-sm group-hover:scale-105
                            transition-transform">

                            <span class="material-symbols-outlined">
                                settings
                            </span>
                        </div>

                        <span class="text-xs font-medium">
                            Ayarlar
                        </span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Profil: tıklanabilir değil -->
        <div title="@fullName"
             class="w-10 h-10 rounded-full
            overflow-hidden border-2
            border-primary/30 shadow-sm
            ml-1 cursor-default
            flex items-center justify-center
            bg-primary/10">

            @if (!string.IsNullOrWhiteSpace(imageUrl))
            {
                <img alt="@fullName"
                     class="w-full h-full object-cover"
                     src="@imageUrl" />
            }
            else
            {
                <span class="material-symbols-outlined
                    text-primary text-[22px]">
                    person
                </span>
            }
        </div>
    </div>
</header>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const wrapper =
            document.getElementById("translateAppsWrapper");

        const button =
            document.getElementById("translateAppsButton");

        const menu =
            document.getElementById("translateAppsMenu");

        if (!wrapper || !button || !menu) {
            return;
        }

        function closeAppsMenu() {
            menu.classList.add("hidden");
            button.setAttribute("aria-expanded", "false");
        }

        button.addEventListener("click", function (event) {
            event.stopPropagation();

            const willOpen =
                menu.classList.contains("hidden");

            menu.classList.toggle("hidden");

            button.setAttribute(
                "aria-expanded",
                willOpen ? "true" : "false"
            );
        });

        menu.addEventListener("click", function (event) {
            event.stopPropagation();
        });

        document.addEventListener("click", function () {
            closeAppsMenu();
        });

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") {
                closeAppsMenu();
            }
        });
    });
</script>