@*
    _TranslateHeaderComponent
*@

@{
    var fullName =
        ViewBag.FullName as string ?? "Notika Kullanıcısı";

    var imageUrl =
        ViewBag.ImageUrl as string;
}

<header class="w-full h-16 sticky top-0 z-50
    bg-white/40 dark:bg-surface-container/40
    backdrop-blur-xl
    border-b border-white/20 dark:border-white/10
    shadow-sm flex items-center justify-between
    px-4 md:px-8">

    <!-- Mobil logo ve menü -->
    <div class="flex items-center md:hidden">

        <button type="button"
                id="translateMobileMenuButton"
                title="Menüyü aç"
                class="mr-3 text-primary
            hover:bg-white/30 rounded-full
            transition-all active:scale-95
            p-2 flex items-center justify-center">

            <span class="material-symbols-outlined">
                menu
            </span>
        </button>

        <div>
            <span class="block text-primary
                font-bold text-base leading-tight">
                NOTİKA
            </span>

            <span class="block text-[10px]
                text-on-surface-variant">
                Translate
            </span>
        </div>
    </div>

    <!-- Desktop boş alan -->
    <div class="hidden md:flex flex-1"></div>

    <!-- Sağ menü -->
    <div class="flex items-center gap-1 md:gap-3
        text-primary dark:text-inverse-primary">

        <!-- AI Destek -->
        <a asp-controller="AISupport"
               asp-action="Index"
               title="AI Destek"
               class="w-10 h-10 rounded-full
            flex items-center justify-center
            text-primary
            hover:bg-white/30
            dark:hover:bg-white/10
            transition-all active:scale-95"
               style="text-decoration:none;">

            <span class="material-symbols-outlined">
                support_agent
            </span>
        </a>

        <!-- Notika Mail -->
        <a asp-controller="Message"
               asp-action="Inbox"
               title="Notika Mail"
               class="w-10 h-10 rounded-full
            flex items-center justify-center
            text-primary
            hover:bg-white/30
            dark:hover:bg-white/10
            transition-all active:scale-95"
               style="text-decoration:none;">

            <span class="material-symbols-outlined">
                mail
            </span>
        </a>
        <!-- Uygulamalar -->
        <div id="translateAppsWrapper" class="relative">

            <button type="button"
                    id="translateAppsButton"
                    title="Notika Uygulamaları"
                    aria-expanded="false"
                    aria-controls="translateAppsMenu"
                    class="w-10 h-10 rounded-full
                flex items-center justify-center
                text-primary
                hover:bg-white/30
                dark:hover:bg-white/10
                transition-all active:scale-95">

                <span class="material-symbols-outlined">
                    apps
                </span>
            </button>

            <!-- Uygulamalar Menüsü -->
            <div id="translateAppsMenu"
                 class="hidden absolute right-0 top-full mt-3
                w-[360px] sm:w-[390px]
                max-w-[calc(100vw-24px)]
                bg-[#182236] rounded-2xl
                border border-[#344158]
                shadow-[0_20px_55px_rgba(0,0,0,0.45)]
                z-[100]">

                <!-- Menü Oku -->
                <div class="absolute -top-2 right-3
                    w-4 h-4 rotate-45
                    bg-[#182236]
                    border-l border-t border-[#344158]">
                </div>

                <!-- Başlık -->
                <div class="relative flex items-center gap-4
                    px-5 py-5
                    border-b border-[#344158]
                    rounded-t-2xl">

                    <div class="w-12 h-12 shrink-0 rounded-xl
                        bg-gradient-to-br
                        from-indigo-400 to-violet-500
                        text-white
                        flex items-center justify-center
                        shadow-lg shadow-indigo-500/20">

                        <span class="material-symbols-outlined text-[28px]">
                            apps
                        </span>
                    </div>

                    <div>
                        <h3 class="m-0 text-[18px] leading-tight
                            font-bold text-white">
                            Notika Uygulamaları
                        </h3>

                        <p class="mt-1 mb-0 text-[13px] text-slate-400">
                            Kullanmak istediğiniz servisi seçin
                        </p>
                    </div>
                </div>

                <!-- Uygulama Kartları -->
                <div class="grid grid-cols-3 gap-x-2 gap-y-4 px-5 py-6">

                    <!-- Mail -->
                    <a asp-controller="Message"
                           asp-action="Inbox"
                           class="group min-h-[105px] rounded-xl p-2
                        flex flex-col items-center justify-center gap-3
                        text-slate-300 hover:text-white
                        hover:bg-white/5
                        transition-all duration-200"
                           style="text-decoration: none;">

                        <div class="w-[52px] h-[52px] rounded-2xl
                            bg-blue-600 text-white
                            flex items-center justify-center
                            shadow-md
                            transition-transform duration-200
                            group-hover:-translate-y-1">

                            <span class="material-symbols-outlined text-[27px]">
                                mail
                            </span>
                        </div>

                        <span class="text-[14px] font-semibold">
                            Mail
                        </span>
                    </a>

                    <!-- Haberler -->
                    <a asp-controller="News"
                           asp-action="Index"
                           asp-route-category="latest"
                           class="group min-h-[105px] rounded-xl p-2
                        flex flex-col items-center justify-center gap-3
                        text-slate-300 hover:text-white
                        hover:bg-white/5
                        transition-all duration-200"
                           style="text-decoration: none;">

                        <div class="w-[52px] h-[52px] rounded-2xl
                            bg-sky-500 text-white
                            flex items-center justify-center
                            shadow-md
                            transition-transform duration-200
                            group-hover:-translate-y-1">

                            <span class="material-symbols-outlined text-[27px]">
                                newspaper
                            </span>
                        </div>

                        <span class="text-[14px] font-semibold">
                            Haberler
                        </span>
                    </a>

                    <!-- Finans -->
                    <a asp-controller="Finance"
                           asp-action="Index"
                           class="group min-h-[105px] rounded-xl p-2
                        flex flex-col items-center justify-center gap-3
                        text-slate-300 hover:text-white
                        hover:bg-white/5
                        transition-all duration-200"
                           style="text-decoration: none;">

                        <div class="w-[52px] h-[52px] rounded-2xl
                            bg-purple-500 text-white
                            flex items-center justify-center
                            shadow-md
                            transition-transform duration-200
                            group-hover:-translate-y-1">

                            <span class="material-symbols-outlined text-[27px]">
                                monitoring
                            </span>
                        </div>

                        <span class="text-[14px] font-semibold">
                            Finans
                        </span>
                    </a>

                    <!-- Görevler -->
                    <a asp-controller="Task"
                           asp-action="Index"
                           class="group min-h-[105px] rounded-xl p-2
                        flex flex-col items-center justify-center gap-3
                        text-slate-300 hover:text-white
                        hover:bg-white/5
                        transition-all duration-200"
                           style="text-decoration: none;">

                        <div class="w-[52px] h-[52px] rounded-2xl
                            bg-orange-500 text-white
                            flex items-center justify-center
                            shadow-md
                            transition-transform duration-200
                            group-hover:-translate-y-1">

                            <span class="material-symbols-outlined text-[27px]">
                                task_alt
                            </span>
                        </div>

                        <span class="text-[14px] font-semibold">
                            Görevler
                        </span>
                    </a>

                    <!-- Translate -->
                    <a asp-controller="Translate"
                           asp-action="Index"
                           class="group min-h-[105px] rounded-xl p-2
                        flex flex-col items-center justify-center gap-3
                        text-slate-300 hover:text-white
                        bg-white/5 hover:bg-white/10
                        transition-all duration-200"
                           style="text-decoration: none;">

                        <div class="w-[52px] h-[52px] rounded-2xl
                            bg-teal-500 text-white
                            flex items-center justify-center
                            shadow-md
                            transition-transform duration-200
                            group-hover:-translate-y-1">

                            <span class="material-symbols-outlined text-[27px]">
                                translate
                            </span>
                        </div>

                        <span class="text-[14px] font-semibold">
                            Translate
                        </span>
                    </a>

                    <!-- Panel -->
                    <a asp-controller="Dashboard"
                           asp-action="Index"
                           class="group min-h-[105px] rounded-xl p-2
                        flex flex-col items-center justify-center gap-3
                        text-slate-300 hover:text-white
                        hover:bg-white/5
                        transition-all duration-200"
                           style="text-decoration: none;">

                        <div class="w-[52px] h-[52px] rounded-2xl
                            bg-emerald-500 text-white
                            flex items-center justify-center
                            shadow-md
                            transition-transform duration-200
                            group-hover:-translate-y-1">

                            <span class="material-symbols-outlined text-[27px]">
                                bar_chart
                            </span>
                        </div>

                        <span class="text-[14px] font-semibold">
                            Panel
                        </span>
                    </a>

                </div>
            </div>
        </div>

        <!-- Profil: tıklanabilir değil -->
        <div title="@fullName"
             class="w-10 h-10 rounded-full
            overflow-hidden border-2
            border-primary/30 shadow-sm
            ml-1 cursor-default
            flex items-center justify-center
            bg-primary/10">

            @if (!string.IsNullOrWhiteSpace(imageUrl))
            {
                <img alt="@fullName"
                     class="w-full h-full object-cover"
                     src="@imageUrl" />
            }
            else
            {
                <span class="material-symbols-outlined
                    text-primary text-[22px]">
                    person
                </span>
            }
        </div>
    </div>
</header>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const wrapper =
            document.getElementById("translateAppsWrapper");

        const button =
            document.getElementById("translateAppsButton");

        const menu =
            document.getElementById("translateAppsMenu");

        if (!wrapper || !button || !menu) {
            return;
        }

        function closeAppsMenu() {
            menu.classList.add("hidden");
            button.setAttribute("aria-expanded", "false");
        }

        button.addEventListener("click", function (event) {
            event.stopPropagation();

            const willOpen =
                menu.classList.contains("hidden");

            menu.classList.toggle("hidden");

            button.setAttribute(
                "aria-expanded",
                willOpen ? "true" : "false"
            );
        });

        menu.addEventListener("click", function (event) {
            event.stopPropagation();
        });

        document.addEventListener("click", function () {
            closeAppsMenu();
        });

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") {
                closeAppsMenu();
            }
        });
    });
</script>