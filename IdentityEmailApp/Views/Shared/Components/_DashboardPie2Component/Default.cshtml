@using System.Globalization

@*
    _DashboardPie2Component
*@

@{
    var totalTasks =
        Convert.ToInt32(ViewBag.TotalTasks ?? 0);

    var completedCount =
        Convert.ToInt32(ViewBag.CompletedTasks ?? 0);

    var overdueCount =
        Convert.ToInt32(ViewBag.OverdueTasks ?? 0);

    var todayCount =
        Convert.ToInt32(ViewBag.TodayTasks ?? 0);

    var upcomingCount =
        Convert.ToInt32(ViewBag.UpcomingTasks ?? 0);

    var noDueDateCount =
        Convert.ToInt32(ViewBag.NoDueDateTasks ?? 0);

    var importantCount =
        Convert.ToInt32(ViewBag.ImportantTasks ?? 0);

    var tomorrowCount =
        Convert.ToInt32(ViewBag.TomorrowTasks ?? 0);


    var totalStatusCount =
        completedCount +
        overdueCount +
        todayCount +
        upcomingCount +
        noDueDateCount;


    double GetPercent(int count)
    {
        return totalStatusCount == 0
            ? 0
            : count * 100.0 / totalStatusCount;
    }


    string CssNumber(double value)
    {
        return value.ToString(
            "0.##",
            CultureInfo.InvariantCulture
        );
    }


    var completedPercent = GetPercent(completedCount);
    var overduePercent = GetPercent(overdueCount);
    var todayPercent = GetPercent(todayCount);
    var upcomingPercent = GetPercent(upcomingCount);
    var noDueDatePercent = GetPercent(noDueDateCount);


    var completedEnd = completedPercent;

    var overdueEnd =
        completedEnd + overduePercent;

    var todayEnd =
        overdueEnd + todayPercent;

    var upcomingEnd =
        todayEnd + upcomingPercent;


    var chartBackground = totalStatusCount == 0
        ? "conic-gradient(rgba(255,255,255,0.12) 0% 100%)"
        : $@"conic-gradient(
                #22c55e 0% {CssNumber(completedEnd)}%,
                #ef4444 {CssNumber(completedEnd)}% {CssNumber(overdueEnd)}%,
                #f59e0b {CssNumber(overdueEnd)}% {CssNumber(todayEnd)}%,
                #38bdf8 {CssNumber(todayEnd)}% {CssNumber(upcomingEnd)}%,
                #64748b {CssNumber(upcomingEnd)}% 100%
            )";
}

<div class="glass-card rounded-2xl p-6 xl:col-span-6
    flex flex-col min-h-[430px] h-full">

    <!-- Başlık -->
    <div class="mb-5">
        <h2 class="text-base font-semibold text-white">
            Görev Durumları
        </h2>

        <p class="text-xs text-glacier-text-muted mt-1">
            Görevlerinizin tamamlanma ve tarih özeti
        </p>
    </div>


    <!-- Görev özetleri -->
    <div class="grid grid-cols-2 gap-3 mb-6">

        <!-- Önemli görevler -->
        <div class="rounded-xl border border-white/5
            bg-white/[0.03] px-4 py-3">

            <div class="flex items-center gap-2 mb-1">

                <span class="material-symbols-outlined
                    text-[17px] text-[#f59e0b]">
                    star
                </span>

                <span class="text-xs text-glacier-text-muted">
                    Önemli
                </span>
            </div>

            <span class="text-xl font-bold text-white">
                @importantCount
            </span>
        </div>


        <!-- Yarın bitecek görevler -->
        <div class="rounded-xl border border-white/5
            bg-white/[0.03] px-4 py-3">

            <div class="flex items-center gap-2 mb-1">

                <span class="material-symbols-outlined
                    text-[17px] text-[#a855f7]">
                    event_upcoming
                </span>

                <span class="text-xs text-glacier-text-muted">
                    Yarın Bitecek
                </span>
            </div>

            <span class="text-xl font-bold text-white">
                @tomorrowCount
            </span>
        </div>

    </div>


    <div class="flex-1 flex flex-col items-center justify-center">

        <!-- Dinamik donut grafik -->
        <div class="w-40 h-40 rounded-full relative
            shadow-[0_0_30px_rgba(34,197,94,0.12)]
            flex items-center justify-center"
             style="background:@chartBackground;">

            <div class="w-28 h-28 bg-[#001113] rounded-full
                absolute flex flex-col items-center justify-center
                border border-white/5">

                <span class="text-2xl font-bold text-white">
                    @totalTasks
                </span>

                <span class="text-[10px] text-glacier-text-muted
                    uppercase tracking-wider">
                    Görev
                </span>
            </div>
        </div>


        <!-- Grafik açıklamaları -->
        <div class="w-full grid grid-cols-2
            gap-x-5 gap-y-4 mt-8">

            <!-- Tamamlanan -->
            <div class="flex items-center gap-3">

                <div class="w-3 h-3 rounded-sm bg-[#22c55e]">
                </div>

                <div class="flex flex-col">
                    <span class="text-xs text-glacier-text-muted">
                        Tamamlanan
                    </span>

                    <span class="text-sm font-semibold text-white">
                        @completedCount

                        <small class="text-glacier-text-muted">
                            (@($"{completedPercent:0}%"))
                        </small>
                    </span>
                </div>
            </div>


            <!-- Geciken -->
            <div class="flex items-center gap-3">

                <div class="w-3 h-3 rounded-sm bg-[#ef4444]">
                </div>

                <div class="flex flex-col">
                    <span class="text-xs text-glacier-text-muted">
                        Geciken
                    </span>

                    <span class="text-sm font-semibold text-white">
                        @overdueCount

                        <small class="text-glacier-text-muted">
                            (@($"{overduePercent:0}%"))
                        </small>
                    </span>
                </div>
            </div>


            <!-- Bugün bitecek -->
            <div class="flex items-center gap-3">

                <div class="w-3 h-3 rounded-sm bg-[#f59e0b]">
                </div>

                <div class="flex flex flex-col">
                    <span class="text-xs text-glacier-text-muted">
                        Bugün Bitecek
                    </span>

                    <span class="text-sm font-semibold text-white">
                        @todayCount

                        <small class="text-glacier-text-muted">
                            (@($"{todayPercent:0}%"))
                        </small>
                    </span>
                </div>
            </div>


            <!-- Yaklaşan -->
            <div class="flex items-center gap-3">

                <div class="w-3 h-3 rounded-sm bg-[#38bdf8]">
                </div>

                <div class="flex flex-col">
                    <span class="text-xs text-glacier-text-muted">
                        Yaklaşan
                    </span>

                    <span class="text-sm font-semibold text-white">
                        @upcomingCount

                        <small class="text-glacier-text-muted">
                            (@($"{upcomingPercent:0}%"))
                        </small>
                    </span>
                </div>
            </div>


            <!-- Tarihsiz -->
            <div class="flex items-center gap-3">

                <div class="w-3 h-3 rounded-sm bg-[#64748b]">
                </div>

                <div class="flex flex-col">
                    <span class="text-xs text-glacier-text-muted">
                        Tarih Belirlenmemiş
                    </span>

                    <span class="text-sm font-semibold text-white">
                        @noDueDateCount

                        <small class="text-glacier-text-muted">
                            (@($"{noDueDatePercent:0}%"))
                        </small>
                    </span>
                </div>
            </div>

        </div>
    </div>
</div>

</div>