@{
    var dayNames =
        ViewBag.DayNames as string[]
        ?? new[] { "Pzt", "Sal", "Çar", "Per", "Cum", "Cmt", "Paz" };

    var thisWeek =
        ViewBag.ThisWeek as int[]
        ?? new int[7];

    var lastWeek =
        ViewBag.LastWeek as int[]
        ?? new int[7];

    var maximumValue = Math.Max(
        thisWeek.DefaultIfEmpty(0).Max(),
        lastWeek.DefaultIfEmpty(0).Max());

    // Sıfıra bölme hatasını önler
    if (maximumValue == 0)
    {
        maximumValue = 1;
    }
}

<div class="glass-card rounded-2xl p-6
    xl:col-span-8 flex flex-col min-h-[320px]">

    <div class="flex justify-between items-center mb-6">

        <h2 class="text-base font-semibold text-white">
            Haftalık Mesaj Aktivitesi
        </h2>

        <div class="flex gap-3">

            <span class="flex items-center gap-1
                text-xs text-glacier-text-muted">

                <span class="w-2 h-2 rounded-full
                    bg-glacier-accent
                    shadow-[0_0_5px_#7dd3fc]">
                </span>

                Bu Hafta
            </span>

            <span class="flex items-center gap-1
                text-xs text-glacier-text-muted">

                <span class="w-2 h-2 rounded-full bg-white/20">
                </span>

                Geçen Hafta
            </span>

        </div>
    </div>

    <div class="flex-1 flex items-end justify-between
        gap-2 md:gap-4 pt-4 px-2">

        @for (var index = 0; index < 7; index++)
        {
            var thisWeekValue = thisWeek[index];
            var lastWeekValue = lastWeek[index];

            var thisWeekHeight = thisWeekValue == 0
                ? 0
                : Math.Max(
                    6,
                    (int)Math.Round(
                        (double)thisWeekValue / maximumValue * 100));

            var lastWeekHeight = lastWeekValue == 0
                ? 0
                : Math.Max(
                    6,
                    (int)Math.Round(
                        (double)lastWeekValue / maximumValue * 100));

            var thisWeekStyle =
                $"height: {thisWeekHeight}%";

            var lastWeekStyle =
                $"height: {lastWeekHeight}%";

            <div class="flex flex-col items-center
                gap-2 w-full group">

                <div class="w-full flex items-end justify-center
                    gap-1 h-[200px]">

                    <!-- Geçen hafta -->
                    <div class="relative w-1/2 bg-white/10
                        rounded-t-sm transition-all
                        group-hover:bg-white/20"
                         style="@lastWeekStyle"
                         title="Geçen hafta: @lastWeekValue mesaj">

                        @if (lastWeekValue > 0)
                        {
                            <span class="absolute -top-5 left-1/2
                                -translate-x-1/2 text-[10px]
                                text-glacier-text-muted
                                opacity-0 group-hover:opacity-100
                                transition-opacity">

                                @lastWeekValue
                            </span>
                        }
                    </div>

                    <!-- Bu hafta -->
                    <div class="relative w-1/2 chart-bar
                        rounded-t-sm
                        shadow-[0_0_15px_rgba(125,211,252,0.3)]
                        transition-all"
                         style="@thisWeekStyle"
                         title="Bu hafta: @thisWeekValue mesaj">

                        @if (thisWeekValue > 0)
                        {
                            <span class="absolute -top-5 left-1/2
                                -translate-x-1/2 text-[10px]
                                text-glacier-accent
                                opacity-0 group-hover:opacity-100
                                transition-opacity">

                                @thisWeekValue
                            </span>
                        }
                    </div>

                </div>

                <span class="text-xs text-glacier-text-muted">
                    @dayNames[index]
                </span>

            </div>
        }

    </div>
</div>