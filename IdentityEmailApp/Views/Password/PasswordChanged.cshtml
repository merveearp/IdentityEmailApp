@{
    ViewData["Title"] = "Şifre Güncellendi";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Şifre Güncellendi | Notika Email App</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 24px;
                font-family: "Montserrat", Arial, sans-serif;
                background: linear-gradient(135deg, #f5f8f7, #e9f7f3);
            }

            .success-card {
                width: 100%;
                max-width: 470px;
                padding: 45px 38px;
                text-align: center;
                background-color: #ffffff;
                border-radius: 18px;
                box-shadow: 0 18px 50px rgba(0, 0, 0, 0.10);
            }

            .success-icon {
                width: 90px;
                height: 90px;
                margin: 0 auto 25px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                color: #ffffff;
                background-color: #00c292;
                font-size: 42px;
            }

            .success-card h1 {
                margin: 0 0 15px;
                color: #333333;
                font-size: 28px;
                font-weight: 700;
            }

            .success-card p {
                margin: 0 0 30px;
                color: #737373;
                font-size: 15px;
                line-height: 1.7;
            }

            .login-button {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                min-width: 190px;
                padding: 13px 24px;
                color: #ffffff;
                background-color: #00c292;
                border: none;
                border-radius: 8px;
                text-decoration: none;
                font-size: 15px;
                font-weight: 600;
                transition: all 0.25s ease;
            }

                .login-button:hover {
                    color: #ffffff;
                    background-color: #00a87e;
                    text-decoration: none;
                    transform: translateY(-2px);
                    box-shadow: 0 8px 20px rgba(0, 194, 146, 0.25);
                }

            .brand {
                margin-top: 35px;
                color: #aaaaaa;
                font-size: 12px;
                letter-spacing: 2px;
            }
    </style>
</head>

<body>

    <div class="success-card">

        <div class="success-icon">
            <i class="fa-solid fa-check"></i>
        </div>

        <h1>Şifreniz Güncellendi</h1>

        <p>
            Şifreniz başarıyla değiştirildi ve güvenliğiniz için
            mevcut oturumunuz sonlandırıldı. Yeni şifrenizle tekrar
            giriş yapabilirsiniz.
        </p>

        <a asp-controller="Login"
               asp-action="SignIn"
               class="login-button">

            <i class="fa-solid fa-right-to-bracket"></i>
            Giriş Sayfasına Git
        </a>

        <div class="brand">
            NOTIKA EMAIL APP
        </div>

    </div>

</body>
</html>