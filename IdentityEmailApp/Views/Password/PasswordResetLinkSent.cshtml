
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=block" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        try{
        tailwind.config = {
        darkMode: "class",
        theme: {
        extend: {
        "colors": {
        "on-primary-container": "#004935",
        "surface-tint": "#006c50",
        "tertiary": "#9f412a",
        "on-primary-fixed": "#002116",
        "surface-container": "#ebeeed",
        "on-background": "#181c1c",
        "primary-container": "#00c292",
        "text-muted": "#777777",
        "surface": "#f7faf9",
        "outline-variant": "#bbcac1",
        "tertiary-fixed": "#ffdad2",
        "on-tertiary-fixed": "#3d0700",
        "on-secondary": "#ffffff",
        "secondary-fixed": "#d1e4fb",
        "inverse-on-surface": "#eef1f0",
        "surface-container-lowest": "#ffffff",
        "surface-glass": "rgba(255, 255, 255, 0.8)",
        "error": "#ba1a1a",
        "on-surface": "#181c1c",
        "background": "#f7faf9",
        "on-primary": "#ffffff",
        "secondary": "#4e6073",
        "text-main": "#333333",
        "surface-container-low": "#f1f4f3",
        "secondary-container": "#cfe2f9",
        "on-error-container": "#93000a",
        "on-tertiary-container": "#75220f",
        "on-tertiary": "#ffffff",
        "on-secondary-container": "#526478",
        "outline": "#6c7a73",
        "inverse-primary": "#41dfac",
        "inverse-surface": "#2d3131",
        "input-border": "#e1e1e1",
        "surface-dim": "#d7dbda",
        "on-secondary-fixed": "#091d2e",
        "on-error": "#ffffff",
        "surface-variant": "#e0e3e2",
        "primary-fixed": "#65fcc7",
        "tertiary-container": "#ff8a6e",
        "on-primary-fixed-variant": "#00513b",
        "primary": "#006c50",
        "on-secondary-fixed-variant": "#36485b",
        "error-container": "#ffdad6",
        "surface-container-highest": "#e0e3e2",
        "on-surface-variant": "#3c4a43",
        "primary-fixed-dim": "#41dfac",
        "surface-container-high": "#e6e9e8",
        "on-tertiary-fixed-variant": "#7f2a16",
        "tertiary-fixed-dim": "#ffb4a3",
        "surface-bright": "#f7faf9",
        "secondary-fixed-dim": "#b5c8df"
        },
        "borderRadius": {
        "DEFAULT": "0.25rem",
        "lg": "0.5rem",
        "xl": "0.75rem",
        "full": "9999px"
        },
        "spacing": {
        "xs": "4px",
        "margin-desktop": "32px",
        "sm": "12px",
        "md": "24px",
        "base": "8px",
        "lg": "48px",
        "max-width-auth": "420px",
        "gutter": "24px",
        "margin-mobile": "16px",
        "xl": "64px"
        },
        "fontFamily": {
        "headline-lg": ["Roboto"],
        "body-sm": ["Roboto"],
        "label-md": ["Roboto"],
        "display-lg": ["Roboto"],
        "title-md": ["Roboto"],
        "body-lg": ["Roboto"],
        "headline-lg-mobile": ["Roboto"]
        },
        "fontSize": {
        "headline-lg": ["32px", { "lineHeight": "40px", "fontWeight": "700" }],
        "body-sm": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
        "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "700" }],
        "display-lg": ["48px", { "lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
        "title-md": ["20px", { "lineHeight": "28px", "fontWeight": "500" }],
        "body-lg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
        "headline-lg-mobile": ["24px", { "lineHeight": "32px", "fontWeight": "700" }]
        }
        },
        },
        }
        }catch(_e){}</script>
        <meta charset="utf-8">
    </head>
    <body class="bg-background text-on-background font-body-lg min-h-screen flex flex-col overflow-x-hidden">
        <!-- Top AppBar (Injected from Shared Components) -->
        <nav class="fixed top-0 left-0 w-full z-50 bg-transparent flex justify-between items-center px-gutter py-md max-w-7xl mx-auto">
            <div class="font-headline-lg text-headline-lg font-bold text-primary dark:text-primary-fixed-dim">
                Notika Mail
            </div>
            <div class="flex items-center gap-md">
                <div class="flex items-center gap-xs px-sm py-xs bg-surface-container-low rounded-full border border-outline-variant/30">
                    <span class="w-2 h-2 rounded-full bg-primary-container animate-pulse"></span>
                    <span class="font-label-md text-label-md text-on-surface-variant">System Online</span>
                </div>
                <div class="flex items-center gap-sm">
                    <button class="material-symbols-outlined text-secondary hover:text-primary transition-colors p-xs rounded-full hover:bg-surface-variant">help_outline</button>
                    <button class="material-symbols-outlined text-secondary hover:text-primary transition-colors p-xs rounded-full hover:bg-surface-variant">dark_mode</button>
                </div>
            </div>
        </nav>
        <main class="flex-grow flex flex-col md:flex-row min-h-screen">
            <!-- Left Side: Hero Section -->
            <section class="hidden md:flex w-1/2 relative items-center justify-center overflow-hidden">
                <div class="absolute inset-0 z-0">

                    <div class="absolute inset-0 bg-primary/20 mix-blend-overlay"></div>
                </div>
                <!-- Glassmorphism Card -->
                <div class="z-10 glass-panel p-lg rounded-xl flex flex-col items-center gap-md max-w-sm text-center">
                    <div class="w-16 h-16 rounded-full bg-white/20 flex items-center justify-center mb-base">
                        <span class="material-symbols-outlined text-white text-[40px]" style="font-variation-settings: 'FILL' 1;">mail</span>
                    </div>
                    <h2 class="font-headline-lg text-headline-lg text-white">Check Your Inbox</h2>
                    <p class="text-white/80 font-body-lg">We've sent a secure authentication link to your registered email address.</p>
                </div>
                <!-- Floating Decorative Elements -->
                <div class="absolute top-1/4 right-1/4 w-32 h-32 bg-primary-fixed opacity-10 blur-3xl rounded-full pulse-slow"></div>
                <div class="absolute bottom-1/3 left-1/4 w-48 h-48 bg-primary-container opacity-10 blur-3xl rounded-full pulse-slow" style="animation-delay: 2s;"></div>
            </section>
            <!-- Right Side: Content Section -->
            <section class="w-full md:w-1/2 bg-surface flex flex-col items-center justify-center px-margin-mobile md:px-lg py-xl">
                <div class="w-full max-w-max-auth">
                    <!-- Confirmation Card -->
                    <div class="bg-surface-container-lowest p-lg rounded-xl shadow-[0_15px_30px_-10px_rgba(0,0,0,0.05)] border border-input-border text-center flex flex-col items-center gap-md">
                        <!-- Success Icon Container -->
                        <div class="mb-sm relative">
                            <div class="absolute inset-0 bg-primary-container opacity-20 blur-xl rounded-full scale-150"></div>
                            <span class="material-symbols-outlined text-primary-container text-[80px] relative z-10" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                        </div>
                        <!-- Typography -->
                        <div class="space-y-sm">
                            <h1 class="font-headline-lg text-headline-lg text-on-background">
                                Şifre Yenileme Bağlantısı Gönderildi
                            </h1>
                            <p class="font-title-md text-title-md text-primary font-medium">
                                Şifre yenileme bağlantısı e-posta adresinize iletilmiştir.
                            </p>
                        </div>
                        <p class="text-text-muted font-body-lg leading-relaxed">
                            Lütfen gelen kutunuzu kontrol edin. E-postayı göremiyorsanız spam veya gereksiz klasörünü de incelemeyi unutmayın.
                        </p>
                        <!-- Actions -->
                        <div class="w-full space-y-md mt-sm">
                            <button class="waves-effect w-full bg-primary-container text-on-primary-container font-title-md py-sm rounded-lg hover:shadow-lg hover:scale-[1.02] transition-all duration-300 flex items-center justify-center gap-sm group" onclick="window.location.href='#'">
                                Giriş Sayfasına Dön
                                <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform">arrow_forward</span>
                            </button>
                            <div class="pt-sm border-t border-input-border">
                                <p class="font-body-sm text-body-sm text-secondary">
                                    E-posta gelmedi mi?
                                    <button class="text-primary font-bold hover:underline ml-xs transition-colors">Tekrar gönder</button>
                                </p>
                            </div>
                        </div>
                    </div>
                    <!-- Assistance Note -->
                    <div class="mt-xl text-center">
                        <p class="font-body-sm text-body-sm text-text-muted">
                            Yardıma mı ihtiyacınız var? <a class="text-secondary hover:text-primary underline" href="#">Destek Merkezi</a> ile iletişime geçin.
                        </p>
                    </div>
                </div>
            </section>
        </main>
        <!-- Footer (Injected from Shared Components)-->
        <footer class="bg-surface dark:bg-inverse-surface border-t border-input-border dark:border-outline w-full px-gutter py-md mt-auto flex flex-col md:flex-row justify-between items-center z-20">
            <div class="font-title-md text-title-md text-on-surface dark:text-on-secondary-fixed mb-sm md:mb-0">
                Notika Productivity
            </div>
            <div class="flex gap-md mb-sm md:mb-0">
                <a class="font-body-sm text-body-sm text-secondary dark:text-secondary-fixed-dim hover:text-primary transition-colors" href="#">Privacy Policy</a>
                <a class="font-body-sm text-body-sm text-secondary dark:text-secondary-fixed-dim hover:text-primary transition-colors" href="#">Terms of Service</a>
                <a class="font-body-sm text-body-sm text-secondary dark:text-secondary-fixed-dim hover:text-primary transition-colors" href="#">Security</a>
                <a class="font-body-sm text-body-sm text-secondary dark:text-secondary-fixed-dim hover:text-primary transition-colors" href="#">Status</a>
            </div>
            <div class="font-body-sm text-body-sm text-secondary dark:text-secondary-fixed-dim opacity-80">
                © 2026 Notika Productivity. All rights reserved.
            </div>
        </footer>
        <!-- Micro-interaction script -->
        <script class="">
            document.querySelectorAll('button').forEach(button => {
            button.addEventListener('mousedown', function() {
            this.classList.add('scale-95');
            });
            button.addEventListener('mouseup', function() {
            this.classList.remove('scale-95');
            });
            button.addEventListener('mouseleave', function() {
            this.classList.remove('scale-95');
            });
            });
        </script>

    </body>
</html>
