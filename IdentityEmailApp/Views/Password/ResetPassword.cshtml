@using IdentityEmailApp.Models.PasswordModels
@model ResetPasswordViewModel
@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="tr" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=block" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&amp;display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        try{
        tailwind.config = {
        darkMode: "class",
        theme: {
        extend: {
        "colors": {
        "primary": "#006c50",
        "surface-tint": "#006c50",
        "on-error-container": "#93000a",
        "input-border": "#e1e1e1",
        "tertiary-container": "#ff8a6e",
        "primary-container": "#00c292",
        "on-surface": "#181c1c",
        "on-secondary-fixed": "#091d2e",
        "on-secondary": "#ffffff",
        "inverse-on-surface": "#eef1f0",
        "on-tertiary-container": "#75220f",
        "inverse-primary": "#41dfac",
        "on-background": "#181c1c",
        "secondary-container": "#cfe2f9",
        "on-tertiary": "#ffffff",
        "on-secondary-container": "#526478",
        "surface-container-low": "#f1f4f3",
        "surface-container": "#ebeeed",
        "error": "#ba1a1a",
        "secondary": "#4e6073",
        "secondary-fixed-dim": "#b5c8df",
        "inverse-surface": "#2d3131",
        "tertiary": "#9f412a",
        "error-container": "#ffdad6",
        "secondary-fixed": "#d1e4fb",
        "surface-variant": "#e0e3e2",
        "surface-bright": "#f7faf9",
        "tertiary-fixed-dim": "#ffb4a3",
        "outline": "#6c7a73",
        "text-main": "#333333",
        "primary-fixed-dim": "#41dfac",
        "surface-container-lowest": "#ffffff",
        "on-secondary-fixed-variant": "#36485b",
        "surface-glass": "rgba(255, 255, 255, 0.8)",
        "surface": "#f7faf9",
        "surface-dim": "#d7dbda",
        "on-surface-variant": "#3c4a43",
        "on-tertiary-fixed": "#3d0700",
        "background": "#f7faf9",
        "surface-container-highest": "#e0e3e2",
        "on-primary-container": "#004935",
        "primary-fixed": "#65fcc7",
        "text-muted": "#777777",
        "on-error": "#ffffff",
        "tertiary-fixed": "#ffdad2",
        "on-primary-fixed-variant": "#00513b",
        "on-primary": "#ffffff",
        "outline-variant": "#bbcac1",
        "on-tertiary-fixed-variant": "#7f2a16",
        "surface-container-high": "#e6e9e8",
        "on-primary-fixed": "#002116"
        },
        "borderRadius": {
        "DEFAULT": "0.25rem",
        "lg": "0.5rem",
        "xl": "0.75rem",
        "full": "9999px"
        },
        "spacing": {
        "xs": "4px",
        "sm": "12px",
        "md": "24px",
        "margin-mobile": "16px",
        "lg": "48px",
        "gutter": "24px",
        "xl": "64px",
        "base": "8px",
        "max-width-auth": "420px",
        "margin-desktop": "32px"
        },
        "fontFamily": {
        "headline-lg-mobile": ["Roboto"],
        "body-lg": ["Roboto"],
        "title-md": ["Roboto"],
        "headline-lg": ["Roboto"],
        "body-sm": ["Roboto"],
        "label-md": ["Roboto"],
        "display-lg": ["Roboto"]
        },
        "fontSize": {
        "headline-lg-mobile": ["24px", {"lineHeight": "32px", "fontWeight": "700"}],
        "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
        "title-md": ["20px", {"lineHeight": "28px", "fontWeight": "500"}],
        "headline-lg": ["32px", {"lineHeight": "40px", "fontWeight": "700"}],
        "body-sm": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
        "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "700"}],
        "display-lg": ["48px", {"lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700"}]
        }
        },
        },
        }
        }catch(_e){}</script>
    </head>
    <body class="bg-background text-on-background min-h-screen flex flex-col">

        <!-- Top Navigation Bar -->
        <header class="fixed top-0 left-0 w-full flex justify-between items-center px-margin-mobile md:px-margin-desktop py-4 z-50 bg-surface-glass backdrop-blur-md shadow-sm">
            <div class="font-headline-lg text-headline-lg-mobile md:text-headline-lg font-bold text-primary">Notika Mail</div>
            <div class="flex items-center gap-2">
                <span class="flex h-2 w-2 rounded-full bg-primary-container animate-pulse"></span>
                <span class="font-label-md text-label-md text-primary uppercase tracking-widest">Sistem Çevrimiçi</span>
                <span class="material-symbols-outlined text-primary ml-2" data-icon="sensors">sensors</span>
            </div>
        </header>

        <main class="flex-grow flex flex-col md:flex-row pt-16 min-h-screen">
            <!-- Left Side: Visual/Branding -->
            <div class="hidden md:flex md:w-1/2 relative overflow-hidden bg-primary items-center justify-center p-xl">
                <div class="absolute inset-0 z-0">
                    <img src="https://lh3.googleusercontent.com/aida/AP1WRLts7b-a1IIGuaG8lJR3zBseR6acR12LAw6q9W56BdBAPzTSVx0xwEw_-qDaTU8InZMEdoWLCIFMVPGYHD21L83YX-lyhbnVIVHduDaPnXPleQ-17VnEFNeFmBsCrwpLl6j5zSm4eqF-86x-mw5ud0z-fqqzSsxKmK-1s5_bt-eSRicqj4IKc73XnvYoRvfmCHkoDLwnnoPCanTDZuNJXNl2ZwYO3ufT4gzhG4wFjhvShTyaJpcqShxi-K0" class="w-full h-full object-cover opacity-60" alt="Güvenli Altyapı Görseli">
                </div>
                <!-- Glassmorphism Overlay-->
                <div class="relative z-10 glass-card p-lg rounded-xl max-w-md text-center">
                    <div class="mb-sm">
                        <span class="material-symbols-outlined text-primary text-6xl" style="font-variation-settings: 'FILL' 1;" data-icon="shield_lock" data-weight="fill">shield_lock</span>
                    </div>
                    <h1 class="font-headline-lg text-headline-lg text-on-surface mb-md">Güvenli Altyapı</h1>
                    <p class="font-body-lg text-body-lg text-on-surface-variant">
                        Verileriniz şifreleme ile korunmaktadır. Şifrenizi güncelleyerek hesabınızın güvenliğini en üst düzeye çıkarın.
                    </p>
                    <div class="mt-md flex justify-center gap-4">
                        <div class="h-1 w-12 bg-primary rounded-full"></div>
                        <div class="h-1 w-4 bg-primary/30 rounded-full"></div>
                        <div class="h-1 w-4 bg-primary/30 rounded-full"></div>
                    </div>
                </div>
            </div>

            <!-- Right Side: Reset Password Form -->
            <div class="w-full md:w-1/2 flex items-center justify-center p-margin-mobile md:p-margin-desktop bg-surface">

                <div class="w-full max-w-max-width-auth">

                    <div class="mb-xl text-center md:text-left">

                        <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface mb-2">
                            Şifre Sıfırla
                        </h2>

                        <p class="font-body-sm text-body-sm text-text-muted">
                            Lütfen hesabınız için yeni ve güçlü bir şifre belirleyin.
                        </p>

                    </div>

                    <form id="resetForm"
                          asp-controller="Password"
                          asp-action="ResetPassword"
                          method="post"
                          class="space-y-md">

                        @Html.AntiForgeryToken()

                        <input asp-for="UserId" type="hidden" />
                        <input asp-for="Token" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-red-500 text-sm mb-4">
                        </div>

                        <!-- Yeni Şifre -->
                        <div class="space-y-1">

                            <label asp-for="Password"
                                   class="font-label-md text-label-md text-on-surface-variant">
                                Yeni Şifre
                            </label>

                            <div class="relative flex items-center group">

                                <span class="absolute left-4 material-symbols-outlined text-text-muted group-focus-within:text-primary transition-colors">
                                    lock
                                </span>

                                <input asp-for="Password"
                                       type="password"
                                       id="new_password"
                                       placeholder="••••••••"
                                       autocomplete="new-password"
                                       class="w-full pl-12 pr-12 py-4 bg-white border border-input-border rounded-lg focus:ring-2 focus:ring-primary-container focus:border-primary transition-all font-body-lg text-body-lg outline-none" />
                                <button type="button"
                                        onclick="togglePassword('new_password', this)"
                                        class="absolute right-4 text-text-muted hover:text-primary transition-colors focus:outline-none"
                                        aria-label="Şifreyi Göster / Gizle">
                            </div>

                            <span asp-validation-for="Password"
                                  class="block text-red-500 text-sm">
                            </span>

                        </div>

                        <!-- Şifre Tekrar -->
                        <div class="space-y-1">

                            <label asp-for="ConfirmPassword"
                                   class="font-label-md text-label-md text-on-surface-variant">
                                Yeni Şifre Tekrar
                            </label>

                            <div class="relative flex items-center group">

                                <span class="absolute left-4 material-symbols-outlined text-text-muted group-focus-within:text-primary transition-colors">
                                    lock_reset
                                </span>

                                <input asp-for="ConfirmPassword"
                                       type="password"
                                       id="confirm_password"
                                       placeholder="••••••••"
                                       autocomplete="new-password"
                                       class="w-full pl-12 pr-12 py-4 bg-white border border-input-border rounded-lg focus:ring-2 focus:ring-primary-container focus:border-primary transition-all font-body-lg text-body-lg outline-none" />

                                    <button type="button"
                                            onclick="togglePassword('new_password', this)"
                                            class="absolute right-4 text-text-muted hover:text-primary transition-colors focus:outline-none"
                                            aria-label="Şifreyi Göster / Gizle">

                            </div>

                            <span asp-validation-for="ConfirmPassword"
                                  class="block text-red-500 text-sm">
                            </span>

                        </div>

                        <!-- Şifre Kuralları -->
                        <div class="rounded-lg bg-surface-container-low p-4">

                            <p class="font-label-md text-label-md text-on-surface-variant mb-2">
                                Şifreniz:
                            </p>

                            <ul class="text-sm text-text-muted space-y-1">
                                <li>En az 6 karakterden oluşmalıdır.</li>
                                <li>En az 1 büyük harf içermelidir.</li>
                                <li>En az 1 küçük harf içermelidir.</li>
                                <li>En az 1 rakam içermelidir.</li>
                                <li>En az 1 sembol içermelidir.</li>
                                <li>Mevcut şifrenizle aynı olmamalıdır.</li>
                            </ul>

                        </div>

                        <!-- Şifreyi Sıfırla -->
                        <button type="submit"
                                class="waves-effect w-full py-4 bg-primary text-on-primary font-title-md text-title-md rounded-lg shadow-lg hover:opacity-90 active:scale-95 transition-all flex items-center justify-center gap-2 mt-4">

                            <span class="material-symbols-outlined">
                                check_circle
                            </span>

                            <span>Şifreyi Sıfırla</span>

                        </button>

                        <!-- Giriş Sayfasına Dön -->
                        <div class="pt-4 text-center">

                            <a asp-controller="Login"
                                   asp-action="SignIn"
                                   class="font-body-sm text-body-sm text-primary font-medium hover:underline flex items-center justify-center gap-1">

                                <span class="material-symbols-outlined text-[18px]">
                                    arrow_back
                                </span>

                                Giriş Sayfasına Dön

                            </a>

                        </div>

                    </form>

                </div>

            </div>
        </main>

        <script>
            function togglePassword(inputId, button) {

            const input = document.getElementById(inputId);
            const icon = button.querySelector('.material-symbols-outlined');

            if (input.type === 'password') {
            input.type = 'text';
            icon.innerText = 'visibility_off';
            } else {
            input.type = 'password';
            icon.innerText = 'visibility';
            }
            }

            const resetForm = document.getElementById('resetForm');

            resetForm.addEventListener('submit', function () {

            if (!resetForm.checkValidity()) {
            return;
            }

            const button =
            resetForm.querySelector('button[type="submit"]');

            button.disabled = true;

            button.innerHTML = `
            <span class="material-symbols-outlined animate-spin">
            sync
            </span>

            <span>Şifre Güncelleniyor...</span>
            `;
            });
        </script>

            
            </body>
        </html>