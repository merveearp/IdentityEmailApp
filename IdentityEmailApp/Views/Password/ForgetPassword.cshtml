@using IdentityEmailApp.Models.PasswordModels
@model ForgetPasswordViewModel

@{
    Layout = null;
}
<!DOCTYPE html><html lang="en"><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>Şifremi Unuttum | Notika Mail</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-primary-fixed": "#002116",
                        "text-main": "#333333",
                        "surface-container-lowest": "#ffffff",
                        "on-tertiary-container": "#75220f",
                        "inverse-surface": "#2d3131",
                        "text-muted": "#777777",
                        "surface-container-highest": "#e0e3e2",
                        "on-background": "#181c1c",
                        "surface-dim": "#d7dbda",
                        "background": "#f7faf9",
                        "surface-container-high": "#e6e9e8",
                        "on-primary-container": "#004935",
                        "primary-container": "#00c292",
                        "on-primary-fixed-variant": "#00513b",
                        "surface-bright": "#f7faf9",
                        "on-secondary-container": "#526478",
                        "surface-container": "#ebeeed",
                        "tertiary-fixed": "#ffdad2",
                        "on-surface": "#181c1c",
                        "on-secondary-fixed": "#091d2e",
                        "on-error-container": "#93000a",
                        "outline": "#6c7a73",
                        "inverse-on-surface": "#eef1f0",
                        "error": "#ba1a1a",
                        "secondary-container": "#cfe2f9",
                        "surface-tint": "#006c50",
                        "error-container": "#ffdad6",
                        "outline-variant": "#bbcac1",
                        "input-border": "#e1e1e1",
                        "tertiary-fixed-dim": "#ffb4a3",
                        "on-error": "#ffffff",
                        "on-surface-variant": "#3c4a43",
                        "on-tertiary-fixed-variant": "#7f2a16",
                        "surface-container-low": "#f1f4f3",
                        "primary": "#006c50",
                        "inverse-primary": "#41dfac",
                        "primary-fixed-dim": "#41dfac",
                        "on-tertiary": "#ffffff",
                        "secondary": "#4e6073",
                        "on-secondary": "#ffffff",
                        "surface-glass": "rgba(255, 255, 255, 0.8)",
                        "tertiary-container": "#ff8a6e",
                        "on-tertiary-fixed": "#3d0700",
                        "tertiary": "#9f412a",
                        "surface": "#f7faf9",
                        "secondary-fixed": "#d1e4fb",
                        "secondary-fixed-dim": "#b5c8df",
                        "on-primary": "#ffffff",
                        "on-secondary-fixed-variant": "#36485b",
                        "surface-variant": "#e0e3e2",
                        "primary-fixed": "#65fcc7"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "sm": "12px",
                        "lg": "48px",
                        "margin-desktop": "32px",
                        "max-width-auth": "420px",
                        "margin-mobile": "16px",
                        "xs": "4px",
                        "gutter": "24px",
                        "base": "8px",
                        "xl": "64px",
                        "md": "24px"
                    },
                    "fontFamily": {
                        "title-md": ["Roboto"],
                        "headline-lg": ["Roboto"],
                        "display-lg": ["Roboto"],
                        "body-sm": ["Roboto"],
                        "headline-lg-mobile": ["Roboto"],
                        "body-lg": ["Roboto"],
                        "label-md": ["Roboto"]
                    },
                    "fontSize": {
                        "title-md": ["20px", {"lineHeight": "28px", "fontWeight": "500"}],
                        "headline-lg": ["32px", {"lineHeight": "40px", "fontWeight": "700"}],
                        "display-lg": ["48px", {"lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "body-sm": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                        "headline-lg-mobile": ["24px", {"lineHeight": "32px", "fontWeight": "700"}],
                        "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                        "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "700"}]
                    }
                },
            },
        }
    </script>
<style>
        body { font-family: 'Roboto', sans-serif; }
        .glass-effect {
            backdrop-filter: blur(10px);
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .waves-effect {
            position: relative;
            overflow: hidden;
        }
        .waves-effect::after {
            content: "";
            display: block;
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            pointer-events: none;
            background-image: radial-gradient(circle, #fff 10%, transparent 10.01%);
            background-repeat: no-repeat;
            background-position: 50%;
            transform: scale(10, 10);
            opacity: 0;
            transition: transform .5s, opacity 1s;
        }
        .waves-effect:active::after {
            transform: scale(0, 0);
            opacity: .3;
            transition: 0s;
        }
    </style>
</head>
<body class="bg-background text-text-main min-h-screen flex flex-col selection:bg-primary-container selection:text-on-primary-container">
<!-- Top Status Bar (Not a full nav shell as per Transactional rule, but keeps identity) -->

<main class="flex-grow flex flex-col md:flex-row min-h-screen">
<!-- Left Side: Visual Anchor -->
<div class="relative w-full md:w-1/2 min-h-[40vh] md:min-h-screen overflow-hidden flex items-center justify-center p-xl">
<!-- Background Image -->
<div class="absolute inset-0 z-0">

<!-- Overlay for depth -->
<div class="absolute inset-0 bg-gradient-to-tr from-primary/40 to-transparent"></div>
</div>

<!-- Content Branding --> 
            <div class="relative z-10 max-w-md text-center md:text-left space-y-6">

                <div class="inline-block px-4 py-2 glass-effect rounded-xl mb-4">

                    <h1 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-white font-bold tracking-tight">
                        Notika Mail
                    </h1>

                </div>

                <div class="space-y-4">

                    <h2 class="font-display-lg text-headline-lg md:text-display-lg text-white leading-tight">
                        Güvenliğiniz Önceliğimiz.
                    </h2>

                    <p class="font-title-md text-title-md text-white/90">
                        Hesabınıza yeniden erişebilmeniz için kayıtlı e-posta
                        adresinize güvenli bir şifre yenileme bağlantısı göndereceğiz.
                    </p>

                </div>

                <div class="hidden lg:block absolute -bottom-20 -left-10 w-48 h-64 glass-effect rounded-3xl rotate-12 -z-10 animate-pulse"></div>

                <div class="hidden lg:block absolute -top-10 -right-10 w-32 h-32 glass-effect rounded-full -z-10"></div>

            </div>

</div>
<!-- Right Side: Interaction Center -->
<div class="w-full md:w-1/2 flex items-center justify-center p-margin-mobile md:p-margin-desktop bg-surface dark:bg-background">
<div class="w-full max-w-max-width-auth bg-surface-container-lowest dark:bg-inverse-surface rounded-xl shadow-xl p-lg border border-outline-variant/30">

                <div class="text-center md:text-left mb-8">

                    <h3 class="font-headline-lg text-headline-lg-mobile text-on-surface mb-2">
                        Şifrenizi mi unuttunuz?
                    </h3>

                    <p class="font-body-lg text-body-lg text-on-surface-variant">
                        Kayıtlı e-posta adresinizi girin. Şifrenizi yenileyebilmeniz
                        için size bir bağlantı gönderelim.
                    </p>

                </div>


                <form asp-action="ForgetPassword"
                      asp-controller="Password"
                      method="post"
                      class="space-y-6">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-sm text-red-600">
                    </div>

                    <div class="space-y-2">

                        <label asp-for="Email"
                               class="font-label-md text-label-md text-on-surface-variant ml-1">
                            E-posta Adresi
                        </label>

                        <div class="relative group">

                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">

                                <span class="material-symbols-outlined text-on-surface-variant group-focus-within:text-primary transition-colors">
                                    alternate_email
                                </span>

                            </div>

                            <input asp-for="Email"
                                   class="block w-full pl-12 pr-4 py-4 bg-surface-container-low border border-input-border rounded-lg font-body-lg text-body-lg focus:ring-2 focus:ring-primary-container focus:border-primary outline-none transition-all placeholder:text-text-muted"
                                   placeholder="ornek@mail.com"
                                   autocomplete="email" />

                        </div>

                        <span asp-validation-for="Email"
                              class="block text-sm text-red-600">
                        </span>
                    </div>

                    <button class="waves-effect w-full py-4 bg-primary-container hover:bg-[#00d8a3] text-on-primary-container font-title-md text-title-md rounded-lg shadow-lg hover:shadow-xl transition-all transform active:scale-[0.98] flex items-center justify-center space-x-2"
                            style="background-color: #00c292;"
                            type="submit">

                        <span>Şifre Yenileme Linki Gönder</span>

                        <span class="material-symbols-outlined">
                            send
                        </span>

                    </button>

                </form>

                <div class="mt-10 pt-6 border-t border-outline-variant flex flex-col items-center space-y-4">

                    <a asp-controller="Login"
                           asp-action="SignIn"
                           class="font-label-md text-label-md text-primary hover:text-on-primary-container transition-colors flex items-center group">

                        <span class="material-symbols-outlined text-sm mr-2 group-hover:-translate-x-1 transition-transform">
                            arrow_back
                        </span>

                        Giriş Sayfasına Dön

                    </a>

                </div>

</div>
</div>
</div>
</main>
<!-- Footer Cluster (Simplified for Auth) -->

    <footer class="w-full md:fixed md:bottom-0 md:left-0 z-40 bg-transparent px-margin-mobile md:px-margin-desktop py-6">

        <div class="flex flex-col md:flex-row justify-between items-center text-on-surface-variant font-label-md text-label-md space-y-4 md:space-y-0">

            <p>
                © 2026 Notika Mail. Tüm hakları saklıdır.
            </p>

        </div>

    </footer>

<script>
        // Simple interactive handling for the input highlight
        document.querySelectorAll('input').forEach(input => {
            input.addEventListener('focus', () => {
                input.parentElement.classList.add('shadow-md');
            });
            input.addEventListener('blur', () => {
                input.parentElement.classList.remove('shadow-md');
            });
        });

       
   const form = document.querySelector('form');

form.addEventListener('submit', () => {

    if (!form.checkValidity()) {
        return;
    }

    const button = form.querySelector('button[type="submit"]');

    button.disabled = true;

    button.innerHTML = `
        <span class="material-symbols-outlined animate-spin">
            sync
        </span>

        <span>Gönderiliyor...</span>
    `;
});
    </script>


</body></html>

