@using System.Globalization
@model List<TranslationHistory>

@{
    ViewData["Title"] = "Kaydedilen Çeviriler";
    Layout = "~/Views/Translate/Layout.cshtml";

    var culture = new CultureInfo("tr-TR");

    string GetLanguageName(string code)
    {
        return code switch
        {
            "auto" => "Algılanan Dil",
            "tr" => "Türkçe",
            "en" => "İngilizce",
            "de" => "Almanca",
            "fr" => "Fransızca",
            "es" => "İspanyolca",
            "it" => "İtalyanca",
            "ru" => "Rusça",
            "ar" => "Arapça",
            _ => code?.ToUpper() ?? "Bilinmiyor"
        };
    }
}

<div class="w-full">

    <!-- Sayfa başlığı -->
    <div class="mb-7 flex flex-col
        sm:flex-row sm:items-center
        justify-between gap-4">

        <div>
            <div class="flex items-center gap-3">

                <div class="w-11 h-11 rounded-xl
                    bg-amber-100 text-amber-500
                    flex items-center justify-center">

                    <span class="material-symbols-outlined text-[26px]">
                        star
                    </span>
                </div>

                <div>
                    <h1 class="text-3xl font-bold text-primary">
                        Kaydedilen Çeviriler
                    </h1>

                    <p class="text-on-surface-variant mt-1">
                        Daha sonra görüntülemek için kaydettiğiniz çeviriler
                    </p>
                </div>
            </div>
        </div>

        <!-- Sayfa yönlendirmeleri -->
        <div class="flex items-center gap-2">

            <a asp-controller="Translate"
                   asp-action="TranslationHistory"
                   title="Çeviri geçmişine git"
                   class="w-11 h-11 rounded-xl
                bg-white/60 border border-white/80
                text-primary flex items-center justify-center
                hover:bg-primary/10 transition-colors
                shadow-sm"
                   style="text-decoration:none;">

                <span class="material-symbols-outlined">
                    history
                </span>
            </a>

            <a asp-controller="Translate"
                   asp-action="Index"
                   title="Çeviri ekranına dön"
                   class="w-11 h-11 rounded-xl
                bg-primary text-white
                flex items-center justify-center
                hover:opacity-90 transition-opacity
                shadow-sm"
                   style="text-decoration:none;">

                <span class="material-symbols-outlined">
                    home
                </span>
            </a>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <!-- Boş liste görünümü -->
        <div class="min-h-[380px] rounded-2xl
            bg-white/50 border border-white/70
            flex flex-col items-center justify-center
            text-center shadow-sm px-5">

            <div class="w-20 h-20 rounded-full
                bg-amber-100 text-amber-500
                flex items-center justify-center mb-5">

                <span class="material-symbols-outlined text-[38px]">
                    star
                </span>
            </div>

            <h2 class="text-xl font-semibold text-on-surface">
                Henüz kaydedilmiş çeviri yok
            </h2>

            <p class="text-sm text-on-surface-variant
                mt-2 max-w-md">
                Önemli çevirilerinizi yıldızlayarak daha sonra
                bu sayfadan kolayca görüntüleyebilirsiniz.
            </p>

            <a asp-controller="Translate"
                   asp-action="TranslationHistory"
                   class="mt-6 px-5 py-2.5 rounded-xl
                bg-primary text-white
                inline-flex items-center gap-2
                hover:opacity-90 transition-opacity"
                   style="text-decoration:none;">

                <span class="material-symbols-outlined text-[20px]">
                    history
                </span>

                Çeviri geçmişine git
            </a>
        </div>
    }
    else
    {
        <!-- Özet alanı -->
        <div class="mb-5 rounded-2xl
            bg-gradient-to-r from-amber-50 to-white/60
            border border-amber-100
            px-5 py-4
            flex items-center justify-between gap-4">

            <div class="flex items-center gap-3">

                <span class="material-symbols-outlined text-amber-500">
                    bookmark
                </span>

                <p class="text-sm text-on-surface">
                    Toplam
                    <strong>@Model.Count</strong>
                    kaydedilmiş çeviriniz bulunuyor.
                </p>
            </div>
        </div>

        <!-- Çeviri kartları -->
        <div class="grid grid-cols-1 xl:grid-cols-2 gap-5">

            @foreach (var translation in Model
                            .OrderByDescending(x => x.CreatedDate))
            {
                <article role="button"
                         tabindex="0"
                         data-translation-card
                         data-source-language="@GetLanguageName(translation.SourceLanguage)"
                         data-target-language="@GetLanguageName(translation.TargetLanguage)"
                         data-source-text="@translation.SourceText"
                         data-translated-text="@translation.TranslatedText"
                         data-created-date="@translation.CreatedDate.ToString("dd MMMM yyyy dddd HH:mm", culture)"
                         class="group relative rounded-2xl
                    bg-white/60 border border-white/80
                    shadow-[0_8px_30px_rgba(44,77,160,0.07)]
                    hover:shadow-[0_12px_35px_rgba(44,77,160,0.13)]
                    hover:-translate-y-0.5
                    transition-all duration-200
                    cursor-pointer overflow-hidden
                    focus:outline-none focus:ring-2
                    focus:ring-primary/30">

                    <!-- Üst renk çizgisi -->
                    <div class="h-1 bg-gradient-to-r
                        from-amber-400 via-primary
                        to-sky-400">
                    </div>

                    <div class="p-5">

                        <!-- Dil ve yıldız -->
                        <div class="flex items-start
                            justify-between gap-4 mb-5">

                            <div class="inline-flex items-center
                                flex-wrap gap-2
                                text-sm font-semibold text-primary">

                                <span class="px-3 py-1 rounded-full
                                    bg-primary/10">
                                    @GetLanguageName(
                                        translation.SourceLanguage)
                                </span>

                                <span class="material-symbols-outlined
                                    text-[18px]">
                                    arrow_forward
                                </span>

                                <span class="px-3 py-1 rounded-full
                                    bg-primary/10">
                                    @GetLanguageName(
                                        translation.TargetLanguage)
                                </span>
                            </div>

                            <form asp-controller="Translate"
                                  asp-action="ToggleSaved"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@translation.TranslationHistoryId" />

                                <button type="submit"
                                        title="Kaydedilenlerden çıkar"
                                        class="w-10 h-10 rounded-full
                                    bg-amber-100 text-amber-500
                                    flex items-center justify-center
                                    hover:bg-red-50 hover:text-red-500
                                    transition-colors">

                                    <span class="material-symbols-outlined">
                                        star
                                    </span>
                                </button>
                            </form>
                        </div>

                        <!-- Kaynak metin -->
                        <div class="mb-4">

                            <div class="flex items-center gap-2 mb-2">
                                <span class="material-symbols-outlined
                                    text-[18px]
                                    text-on-surface-variant">
                                    subject
                                </span>

                                <span class="text-xs font-semibold
                                    uppercase tracking-wide
                                    text-on-surface-variant">
                                    Kaynak metin
                                </span>
                            </div>

                            <p class="text-sm font-medium
                                text-on-surface
                                line-clamp-2 leading-6">
                                @translation.SourceText
                            </p>
                        </div>

                        <!-- Çeviri -->
                        <div class="rounded-xl bg-primary/5
                            border border-primary/10
                            px-4 py-3">

                            <div class="flex items-center gap-2 mb-2">

                                <span class="material-symbols-outlined
                                    text-[18px] text-primary">
                                    translate
                                </span>

                                <span class="text-xs font-semibold
                                    uppercase tracking-wide
                                    text-primary">
                                    Çeviri
                                </span>
                            </div>

                            <p class="text-sm text-on-surface-variant
                                line-clamp-3 leading-6">
                                @translation.TranslatedText
                            </p>
                        </div>

                        <!-- Alt bilgi -->
                        <div class="mt-4 pt-4
                            border-t border-primary/10
                            flex items-center
                            justify-between gap-3">

                            <div class="flex items-center gap-2
                                text-xs text-on-surface-variant">

                                <span class="material-symbols-outlined
                                    text-[17px]">
                                    schedule
                                </span>

                                @translation.CreatedDate.ToString(
                                    "dd MMMM yyyy HH:mm",
                                    culture)
                            </div>

                            <div class="inline-flex items-center gap-1
                                text-xs font-medium text-primary
                                group-hover:gap-2
                                transition-all">

                                Detayı görüntüle

                                <span class="material-symbols-outlined
                                    text-[17px]">
                                    open_in_new
                                </span>
                            </div>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>

<!-- Çeviri detay modalı -->
<div id="savedTranslationModal"
     class="fixed inset-0 z-[9999] hidden
    items-center justify-center
    bg-slate-900/50 backdrop-blur-sm
    px-4 py-6"
     aria-hidden="true">

    <div id="savedTranslationModalPanel"
         role="dialog"
         aria-modal="true"
         aria-labelledby="savedTranslationModalTitle"
         class="w-full max-w-3xl max-h-[90vh]
        rounded-2xl bg-white shadow-2xl
        overflow-hidden flex flex-col">

        <!-- Modal başlığı -->
        <div class="px-6 py-5
            border-b border-primary/10
            flex items-center
            justify-between gap-4">

            <div>
                <h2 id="savedTranslationModalTitle"
                    class="text-xl font-bold text-on-surface">
                    Kaydedilen Çeviri
                </h2>

                <div class="flex flex-wrap items-center
                    gap-2 mt-2
                    text-sm font-semibold text-primary">

                    <span id="savedModalSourceLanguage"></span>

                    <span class="material-symbols-outlined text-[18px]">
                        arrow_forward
                    </span>

                    <span id="savedModalTargetLanguage"></span>
                </div>
            </div>

            <button type="button"
                    id="closeSavedTranslationModal"
                    title="Kapat"
                    class="w-10 h-10 shrink-0 rounded-full
                flex items-center justify-center
                text-on-surface-variant
                hover:bg-slate-100
                transition-colors">

                <span class="material-symbols-outlined">
                    close
                </span>
            </button>
        </div>

        <!-- Kaydırılabilir içerik -->
        <div class="flex-1 overflow-y-auto
            px-6 py-5 space-y-5">

            <div>
                <h3 class="text-sm font-semibold
                    text-on-surface mb-2">
                    Kaynak metin
                </h3>

                <div id="savedModalSourceText"
                     class="rounded-xl bg-slate-50
                    border border-slate-200
                    px-4 py-4 text-sm leading-7
                    text-on-surface
                    whitespace-pre-wrap break-words">
                </div>
            </div>

            <div>
                <h3 class="text-sm font-semibold
                    text-on-surface mb-2">
                    Çevrilen metin
                </h3>

                <div id="savedModalTranslatedText"
                     class="rounded-xl bg-primary/5
                    border border-primary/15
                    px-4 py-4 text-sm leading-7
                    text-on-surface
                    whitespace-pre-wrap break-words">
                </div>
            </div>
        </div>

        <!-- Modal alt alanı -->
        <div class="px-6 py-4
            border-t border-primary/10
            bg-slate-50/70
            flex flex-wrap items-center
            justify-between gap-3">

            <div class="flex items-center gap-2
                text-sm text-on-surface-variant">

                <span class="material-symbols-outlined text-[19px]">
                    schedule
                </span>

                <span id="savedModalCreatedDate"></span>
            </div>

            <button type="button"
                    id="closeSavedTranslationModalButton"
                    class="px-5 py-2 rounded-lg
                bg-primary text-white
                hover:opacity-90 transition-opacity">
                Kapat
            </button>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const modal =
            document.getElementById("savedTranslationModal");

        const modalPanel =
            document.getElementById("savedTranslationModalPanel");

        const sourceLanguage =
            document.getElementById("savedModalSourceLanguage");

        const targetLanguage =
            document.getElementById("savedModalTargetLanguage");

        const sourceText =
            document.getElementById("savedModalSourceText");

        const translatedText =
            document.getElementById("savedModalTranslatedText");

        const createdDate =
            document.getElementById("savedModalCreatedDate");

        const closeTopButton =
            document.getElementById("closeSavedTranslationModal");

        const closeBottomButton =
            document.getElementById(
                "closeSavedTranslationModalButton"
            );

        let lastFocusedElement = null;

        function openModal(card) {
            lastFocusedElement = document.activeElement;

            sourceLanguage.textContent =
                card.dataset.sourceLanguage || "Bilinmiyor";

            targetLanguage.textContent =
                card.dataset.targetLanguage || "Bilinmiyor";

            sourceText.textContent =
                card.dataset.sourceText || "Kaynak metin bulunamadı.";

            translatedText.textContent =
                card.dataset.translatedText || "Çeviri bulunamadı.";

            createdDate.textContent =
                card.dataset.createdDate || "";

            modal.classList.remove("hidden");
            modal.classList.add("flex");
            modal.setAttribute("aria-hidden", "false");

            document.body.style.overflow = "hidden";
            closeTopButton.focus();
        }

        function closeModal() {
            modal.classList.add("hidden");
            modal.classList.remove("flex");
            modal.setAttribute("aria-hidden", "true");

            document.body.style.overflow = "";

            if (lastFocusedElement) {
                lastFocusedElement.focus();
            }
        }

        document
            .querySelectorAll("[data-translation-card]")
            .forEach(function (card) {

                card.addEventListener("click", function (event) {

                    if (event.target.closest(
                        "button, form, a, input"
                    )) {
                        return;
                    }

                    openModal(card);
                });

                card.addEventListener("keydown", function (event) {

                    if (event.key !== "Enter" &&
                        event.key !== " ") {
                        return;
                    }

                    if (event.target.closest(
                        "button, form, a, input"
                    )) {
                        return;
                    }

                    event.preventDefault();
                    openModal(card);
                });
            });

        closeTopButton.addEventListener("click", closeModal);
        closeBottomButton.addEventListener("click", closeModal);

        modal.addEventListener("click", function (event) {
            if (event.target === modal) {
                closeModal();
            }
        });

        modalPanel.addEventListener("click", function (event) {
            event.stopPropagation();
        });

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape" &&
                !modal.classList.contains("hidden")) {
                closeModal();
            }
        });
    });
</script>