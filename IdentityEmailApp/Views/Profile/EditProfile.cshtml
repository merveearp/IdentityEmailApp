@model EditUserViewModel
@{
    ViewData["Title"] = "EditProfile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Form Element area Start-->
<div class="form-element-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="form-element-list">
                    <div class="basic-tb-hd">
                        <h2>Profilini Düzenle</h2>
                        <p>Lütfen bilgileri eksiksiz oalrak doldurup güncelleme işlemini yapınız </p>
                    </div>
                    <form method="post" enctype="multipart/form-data">
                        <div class="row">

                            <!-- Sol Taraf -->
                            <div class="col-lg-8">

                                <div class="form-group">
                                    <div class="nk-int-st">
                                        <input type="text" class="form-control" placeholder="İsim">
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="nk-int-st">
                                        <input type="text" class="form-control" placeholder="Soyisim">
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="nk-int-st">
                                        <input type="text" class="form-control" placeholder="Şehriniz">
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="nk-int-st">
                                        <input type="text" class="form-control" placeholder="Kullanıcı Adınız">
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="nk-int-st">
                                        <input type="email" class="form-control" placeholder="Email">
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="nk-int-st">
                                        <input type="text" class="form-control" placeholder="Telefon Numaranız">
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="nk-int-st">
                                        <input type="password" class="form-control" placeholder="Şifreniz">
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="nk-int-st">
                                        <input type="password" class="form-control" placeholder="Şifre Tekrar">
                                    </div>
                                </div>

                            </div>

                            <!-- Sağ Taraf -->
                            <div class="col-lg-4 text-center">

                                <img id="previewImage"
                                     src="~/images/default.jfif"
                                     class="img-circle"
                                     style="width:180px;height:180px;object-fit:cover;border:4px solid #eee;">

                                <br /><br />

                                <input type="file"
                                       id="imageUpload"
                                       name="ProfileImage"
                                       class="form-control"
                                       accept="image/*">

                            </div>

                            <div class="col-lg-12">
                                <br />
                                <button class="btn btn-success notika-btn-success">
                                    Bilgileri Güncelle
                                </button>
                            </div>

                        </div>
                    </form>
                 
                </div>
            </div>
        </div>
    
    </div>
</div>
<!-- Form Element area End-->
<script>
    document.getElementById("imageUpload").addEventListener("change", function (e) {

        if (e.target.files.length > 0) {

            var reader = new FileReader();

            reader.onload = function (event) {
                document.getElementById("previewImage").src = event.target.result;
            };

            reader.readAsDataURL(e.target.files[0]);
        }

    });
</script>