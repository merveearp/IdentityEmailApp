
@{
    Layout = null;
}
<!DOCTYPE html>

<html class="dark" lang="tr">
  
@await Component.InvokeAsync("_FinanceHeadComponent")


<body class="min-h-screen bg-dark-bg text-dark-text">

<!-- Top Navigation -->
@await Component.InvokeAsync("_FinanceHeaderComponent")


<!-- Main Content Container -->
<main class="pt-24 pb-12 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto space-y-stack-xl">
<!-- Market Summary Section -->
     
    @await Component.InvokeAsync("_FinanceCurrencyAllComponent")

<!-- Main Content (2 Columns) -->
<section class="grid grid-cols-1 lg:grid-cols-3 gap-gutter">

      @await Component.InvokeAsync("_FinanceLiveBorsaComponent")


      @await Component.InvokeAsync("_FinanceExhangeComponent")

</section>
  
        @await Component.InvokeAsync("_FinanceFeaturedStocksComponent")

<!-- Additional Assets Sections -->
<section class="grid grid-cols-1 lg:grid-cols-2 gap-gutter">

        @await Component.InvokeAsync("_FinanceGoldComponent")

        @await Component.InvokeAsync("_FinanceCreditRatesComponent")




</section>


</main>
</body>
</html>