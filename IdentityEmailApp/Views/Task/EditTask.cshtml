@using IdentityEmailApp.DTOs.TaskDtos
@model EditTaskDto

@{
    ViewData["Title"] = "Görevi Düzenle";
    Layout = "~/Views/Task/Layout.cshtml";
}

<style>
    .edit-task-page {
        width: 100%;
        padding: 28px 36px 50px;
    }

    .edit-notebook {
        position: relative;
        max-width: 920px;
        min-height: 590px;
        margin: 0 auto;
        background-color: #fff;
        background-image: repeating-linear-gradient( to bottom, transparent 0, transparent 39px, rgba(211, 221, 237, 0.65) 40px );
        border: 1px solid #ccd5e5;
        border-radius: 12px;
        box-shadow: 0 18px 50px rgba(35, 55, 90, 0.11), 5px 5px 0 #edf1f7;
    }

        .edit-notebook::before {
            content: "";
            position: absolute;
            top: 0;
            bottom: 0;
            left: 54px;
            width: 2px;
            background: rgba(231, 76, 76, 0.62);
        }

    .notebook-holes {
        position: absolute;
        top: 43px;
        bottom: 40px;
        left: 18px;
        width: 16px;
        background-image: radial-gradient( circle, #b9c3d2 0, #b9c3d2 4px, #f5f7fa 4.5px, #f5f7fa 6px, transparent 6.5px );
        background-size: 16px 55px;
        background-repeat: repeat-y;
    }

    .paperclip {
        position: absolute;
        top: -27px;
        right: 38px;
        z-index: 10;
        color: #e53935;
        transform: rotate(11deg);
        filter: drop-shadow(2px 4px 2px rgba(0, 0, 0, 0.18));
    }

        .paperclip .material-symbols-outlined {
            font-size: 64px;
            font-variation-settings: "FILL" 0, "wght" 500, "GRAD" 0, "opsz" 48;
        }

    .edit-content {
        position: relative;
        z-index: 2;
        padding: 32px 38px 38px 78px;
    }

    .edit-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        padding-bottom: 22px;
        margin-bottom: 28px;
        border-bottom: 1px solid #d9e0ec;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 8px;
        color: #687587;
        font-size: 13px;
        text-decoration: none;
    }

        .back-link:hover {
            color: #0b63ce;
        }

    .edit-title {
        margin: 0;
        color: #172033;
        font-size: 28px;
        font-weight: 750;
    }

    .edit-subtitle {
        margin: 6px 0 0;
        color: #707b8c;
        font-size: 13px;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
    }

    .cancel-button,
    .save-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 42px;
        padding: 0 18px;
        border-radius: 22px;
        font-family: inherit;
        font-size: 14px;
        font-weight: 650;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .cancel-button {
        color: #4f5b6c;
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid #ccd5e3;
    }

        .cancel-button:hover {
            color: #263244;
            background: #f2f5f9;
        }

    .save-button {
        color: #fff;
        background: #0b63ce;
        border: 1px solid #0b63ce;
        box-shadow: 0 5px 14px rgba(11, 99, 206, 0.22);
    }

        .save-button:hover {
            background: #0758b9;
            transform: translateY(-1px);
            box-shadow: 0 7px 18px rgba(11, 99, 206, 0.28);
        }

        .save-button .material-symbols-outlined {
            font-size: 19px;
        }

    .edit-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.65fr) minmax(250px, 0.8fr);
        gap: 30px;
        align-items: start;
    }

    .title-label,
    .field-label {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 8px;
        color: #465267;
        font-size: 13px;
        font-weight: 650;
    }

        .title-label .material-symbols-outlined,
        .field-label .material-symbols-outlined {
            color: #0b63ce;
            font-size: 19px;
        }

    .task-title-input {
        width: 100%;
        box-sizing: border-box;
        padding: 12px 6px 13px;
        color: #172033;
        background: rgba(255, 255, 255, 0.86);
        border: 0;
        border-bottom: 2px solid #9db8dc;
        border-radius: 7px 7px 0 0;
        outline: none;
        font-family: inherit;
        font-size: 25px;
        font-weight: 700;
        transition: all 0.2s ease;
    }

        .task-title-input:focus {
            padding-left: 11px;
            background: #fff;
            border-bottom-color: #0b63ce;
            box-shadow: 0 5px 16px rgba(11, 99, 206, 0.08);
        }

    .form-group {
        margin-top: 25px;
    }

    .form-control {
        width: 100%;
        min-height: 46px;
        box-sizing: border-box;
        padding: 11px 13px;
        color: #263244;
        background: rgba(255, 255, 255, 0.96);
        border: 1px solid #cbd5e3;
        border-radius: 11px;
        outline: none;
        font-family: inherit;
        font-size: 14px;
        transition: all 0.2s ease;
    }

        .form-control:hover {
            border-color: #aebbd0;
        }

        .form-control:focus {
            background: #fff;
            border-color: #0b63ce;
            box-shadow: 0 0 0 3px rgba(11, 99, 206, 0.10);
        }

    textarea.form-control {
        min-height: 155px;
        resize: vertical;
        line-height: 1.6;
    }

    .settings-panel {
        padding: 21px;
        background: rgba(244, 247, 252, 0.94);
        border: 1px solid #d8e0ec;
        border-radius: 15px;
        box-shadow: 0 8px 22px rgba(41, 61, 94, 0.06);
    }

    .settings-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 20px;
        color: #263244;
        font-size: 15px;
        font-weight: 700;
    }

        .settings-title .material-symbols-outlined {
            color: #0b63ce;
            font-size: 20px;
        }

    .settings-panel .form-group {
        margin-top: 18px;
    }

        .settings-panel .form-group:first-of-type {
            margin-top: 0;
        }

    .important-option {
        position: relative;
        display: block;
        margin-top: 21px;
        cursor: pointer;
    }

        .important-option input[type="checkbox"] {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

    .important-visual {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 13px;
        color: #596678;
        background: #fff;
        border: 1px solid #d1dae7;
        border-radius: 11px;
        transition: all 0.2s ease;
    }

    .important-star {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        color: #8a94a3;
        background: #f1f4f8;
        border-radius: 50%;
    }

        .important-star .material-symbols-outlined {
            font-size: 20px;
        }

    .important-text strong {
        display: block;
        font-size: 13px;
    }

    .important-text small {
        display: block;
        margin-top: 2px;
        color: #8a94a3;
        font-size: 11px;
    }

    .important-option input:checked + .important-visual {
        color: #a66000;
        background: #fff8e8;
        border-color: #f2c76f;
        box-shadow: 0 0 0 3px rgba(242, 183, 47, 0.10);
    }

        .important-option input:checked + .important-visual .important-star {
            color: #fff;
            background: #f4b400;
        }

            .important-option input:checked + .important-visual
            .important-star
            .material-symbols-outlined {
                font-variation-settings: "FILL" 1, "wght" 500, "GRAD" 0, "opsz" 24;
            }

    .subtask-information {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-top: 27px;
        padding: 14px;
        color: #536174;
        background: rgba(237, 245, 255, 0.94);
        border: 1px solid #cfe2fa;
        border-radius: 11px;
        font-size: 12px;
        line-height: 1.5;
    }

        .subtask-information .material-symbols-outlined {
            color: #0b63ce;
            font-size: 20px;
        }

        .subtask-information a {
            color: #0b63ce;
            font-weight: 650;
            text-decoration: none;
        }

    .validation-message {
        display: block;
        margin-top: 6px;
        color: #d32f2f;
        font-size: 12px;
    }

    .validation-summary-valid {
        display: none;
    }

    .validation-summary-errors {
        margin-bottom: 20px;
        padding: 12px 15px;
        color: #b3261e;
        background: #fff1f0;
        border: 1px solid #f1c3bf;
        border-radius: 10px;
        font-size: 13px;
    }

    .mobile-actions {
        display: none;
    }

    @@media (max-width: 900px) {
        .edit-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 650px) {
        .edit-task-page {
            padding: 18px 10px 35px;
        }

        .edit-notebook::before,
        .notebook-holes {
            display: none;
        }

        .edit-content {
            padding: 25px 18px;
        }

        .edit-header {
            align-items: flex-start;
        }

        .header-actions {
            display: none;
        }

        .edit-title {
            font-size: 24px;
        }

        .task-title-input {
            font-size: 21px;
        }

        .mobile-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 25px;
            padding-top: 20px;
            border-top: 1px solid #d8e0ec;
        }
    }
</style>

<div class="edit-task-page">

    <form asp-controller="Task"
          asp-action="EditTask"
          method="post"
          class="edit-notebook">

        <input asp-for="UserTaskId" type="hidden" />

        <div class="notebook-holes"></div>

        <div class="paperclip" aria-hidden="true">
            <span class="material-symbols-outlined">
                attach_file
            </span>
        </div>

        <div class="edit-content">

            <div asp-validation-summary="ModelOnly"></div>

            <!-- Başlık -->
            <header class="edit-header">

                <div>
                    <a asp-controller="Task"
                           asp-action="TaskDetail"
                           asp-route-id="@Model.UserTaskId"
                           class="back-link">
                        <span class="material-symbols-outlined"
                              style="font-size:17px;">
                            arrow_back
                        </span>
                        Görev detayına dön
                    </a>

                    <h1 class="edit-title">
                        Görevi Düzenle
                    </h1>

                    <p class="edit-subtitle">
                        Görevin başlığını, notlarını ve tarihlerini güncelleyin.
                    </p>
                </div>

                <div class="header-actions">

                    <a asp-controller="Task"
                           asp-action="TaskDetail"
                           asp-route-id="@Model.UserTaskId"
                           class="cancel-button">
                        İptal
                    </a>

                    <button type="submit"
                            class="save-button">
                        <span class="material-symbols-outlined">
                            save
                        </span>
                        Değişiklikleri Kaydet
                    </button>

                </div>

            </header>

            <div class="edit-grid">

                <!-- Sol taraf -->
                <main>

                    <div>
                        <label asp-for="Title"
                               class="title-label">
                            <span class="material-symbols-outlined">
                                edit_note
                            </span>
                            Görev başlığı
                        </label>

                        <input asp-for="Title"
                               class="task-title-input"
                               autocomplete="off" />

                        <span asp-validation-for="Title"
                              class="validation-message">
                        </span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Description"
                               class="field-label">
                            <span class="material-symbols-outlined">
                                notes
                            </span>
                            Görev notu
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  placeholder="Görevle ilgili bir not ekleyebilirsiniz..."></textarea>

                        <span asp-validation-for="Description"
                              class="validation-message">
                        </span>
                    </div>

                    <div class="subtask-information">

                        <span class="material-symbols-outlined">
                            info
                        </span>

                        <div>
                            Alt görevler bu ekrandan değiştirilmez.
                            Ayrıntıları düzenlemek için

                            <a asp-controller="Task"
                                   asp-action="TaskDetail"
                                   asp-route-id="@Model.UserTaskId">
                                görev detayına dönün.
                            </a>
                        </div>

                    </div>

                </main>

                <!-- Sağ ayarlar -->
                <aside class="settings-panel">

                    <h2 class="settings-title">
                        <span class="material-symbols-outlined">
                            tune
                        </span>
                        Görev ayarları
                    </h2>

                    <div class="form-group">
                        <label asp-for="TaskListId"
                               class="field-label">
                            <span class="material-symbols-outlined">
                                label
                            </span>
                            Kategori
                        </label>

                        <select asp-for="TaskListId"
                                asp-items="ViewBag.TaskLists"
                                class="form-control">
                            <option value="">Kategorisiz</option>
                        </select>

                        <span asp-validation-for="TaskListId"
                              class="validation-message">
                        </span>
                    </div>

                    <div class="form-group">
                        <label asp-for="DueDate"
                               class="field-label">
                            <span class="material-symbols-outlined">
                                event
                            </span>
                            Son tarih
                        </label>

                        <input asp-for="DueDate"
                               type="datetime-local"
                               asp-format="{0:yyyy-MM-ddTHH:mm}"
                               class="form-control" />

                        <span asp-validation-for="DueDate"
                              class="validation-message">
                        </span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ReminderDate"
                               class="field-label">
                            <span class="material-symbols-outlined">
                                notifications
                            </span>
                            Hatırlatma tarihi
                        </label>

                        <input asp-for="ReminderDate"
                               type="datetime-local"
                               asp-format="{0:yyyy-MM-ddTHH:mm}"
                               class="form-control" />

                        <span asp-validation-for="ReminderDate"
                              class="validation-message">
                        </span>
                    </div>

                    <label class="important-option">

                        <input asp-for="IsImportant" />

                        <span class="important-visual">

                            <span class="important-star">
                                <span class="material-symbols-outlined">
                                    star
                                </span>
                            </span>

                            <span class="important-text">
                                <strong>Önemli görev</strong>
                                <small>Görevi yıldızlı olarak işaretle</small>
                            </span>

                        </span>

                    </label>

                </aside>

            </div>

            <!-- Mobil butonlar -->
            <div class="mobile-actions">

                <a asp-controller="Task"
                       asp-action="TaskDetail"
                       asp-route-id="@Model.UserTaskId"
                       class="cancel-button">
                    İptal
                </a>

                <button type="submit"
                        class="save-button">
                    <span class="material-symbols-outlined">
                        save
                    </span>
                    Kaydet
                </button>

            </div>

        </div>

    </form>

</div>