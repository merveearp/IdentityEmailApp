@using IdentityEmailApp.Entities
@model UserTask

@{
    ViewData["Title"] = "Görev Detayı";
    Layout = "~/Views/Task/Layout.cshtml";

    var isOverdue =
        Model.DueDate.HasValue &&
        Model.DueDate.Value < DateTime.Now &&
        !Model.IsCompleted;
}

<style>

    .subtask-delete-button {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 32px;
    height: 32px;
    padding: 0;
    color: #8a94a3;
    background: transparent;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    opacity: 0;
    transition: all 0.2s ease;
}

.subtask-item:hover .subtask-delete-button {
    opacity: 1;
}

.subtask-delete-button:hover {
    color: #d32f2f;
    background: #fff0ef;
}

.subtask-delete-button .material-symbols-outlined {
    font-size: 19px;
}

@@media (max-width: 650px) {
    .subtask-delete-button {
        opacity: 1;
    }
}
    .task-detail-page {
        width: 100%;
        padding: 28px 36px 50px;
    }

    .detail-notebook {
        position: relative;
        max-width: 920px;
        min-height: 590px;
        margin: 0 auto;
        background-color: #fff;
        background-image: repeating-linear-gradient( to bottom, transparent 0, transparent 39px, rgba(211, 221, 237, 0.65) 40px );
        border: 1px solid #ccd5e5;
        border-radius: 12px;
        box-shadow: 0 18px 50px rgba(35, 55, 90, 0.11), 5px 5px 0 #edf1f7;
    }

        .detail-notebook::before {
            content: "";
            position: absolute;
            top: 0;
            bottom: 0;
            left: 54px;
            width: 2px;
            background-color: rgba(231, 76, 76, 0.62);
        }

    .notebook-holes {
        position: absolute;
        top: 43px;
        bottom: 40px;
        left: 18px;
        width: 16px;
        background-image: radial-gradient( circle, #b9c3d2 0, #b9c3d2 4px, #f5f7fa 4.5px, #f5f7fa 6px, transparent 6.5px );
        background-size: 16px 55px;
        background-repeat: repeat-y;
    }

    .paperclip {
        position: absolute;
        top: -27px;
        right: 38px;
        z-index: 10;
        color: #e53935;
        transform: rotate(11deg);
        filter: drop-shadow(2px 4px 2px rgba(0, 0, 0, 0.18));
    }

        .paperclip .material-symbols-outlined {
            font-size: 64px;
            font-variation-settings: "FILL" 0, "wght" 500, "GRAD" 0, "opsz" 48;
        }

    .detail-content {
        position: relative;
        z-index: 2;
        padding: 32px 38px 38px 78px;
    }

    .detail-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 25px;
        padding-bottom: 22px;
        border-bottom: 1px solid #d9e0ec;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 14px;
        color: #687587;
        font-size: 13px;
        text-decoration: none;
    }

        .back-link:hover {
            color: #0b63ce;
        }

    .category-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        margin-bottom: 13px;
        color: #0758b9;
        background: #e7f1ff;
        border: 1px solid #c5ddfa;
        border-radius: 18px;
        font-size: 12px;
        font-weight: 700;
    }

        .category-badge .material-symbols-outlined {
            font-size: 16px;
        }

    .task-title {
        margin: 0;
        color: #172033;
        font-size: 30px;
        font-weight: 750;
        line-height: 1.3;
    }

        .task-title.completed {
            color: #7c8797;
            text-decoration: line-through;
        }

    .important-star {
        color: #f4b400;
        font-size: 31px;
        font-variation-settings: "FILL" 1, "wght" 500, "GRAD" 0, "opsz" 32;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .icon-action {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 41px;
        height: 41px;
        color: #647184;
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid #d1dae7;
        border-radius: 50%;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .icon-action:hover {
            color: #0b63ce;
            background: #edf5ff;
            border-color: #b9d6f7;
        }

        .icon-action.delete:hover {
            color: #d32f2f;
            background: #fff0ef;
            border-color: #f0c3bf;
        }

    .detail-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.65fr) minmax(250px, 0.8fr);
        gap: 30px;
        margin-top: 28px;
    }

    .description-card {
        padding: 17px 18px;
        color: #4f5c6e;
        background: rgba(255, 255, 255, 0.86);
        border-left: 4px solid #78aeea;
        border-radius: 4px 11px 11px 4px;
        line-height: 1.65;
        font-size: 14px;
    }

    .description-empty {
        color: #8b95a4;
        font-style: italic;
    }

    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin: 28px 0 14px;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin: 0;
        color: #263244;
        font-size: 16px;
        font-weight: 700;
    }

    .section-title-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        color: #0b63ce;
        background: #e8f1fd;
        border-radius: 50%;
    }

        .section-title-icon .material-symbols-outlined {
            font-size: 20px;
        }

    .add-detail-button {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 8px 12px;
        color: #0b63ce;
        background: #edf5ff;
        border: 1px solid #cfe2fa;
        border-radius: 18px;
        font-size: 12px;
        font-weight: 650;
        text-decoration: none;
    }

        .add-detail-button:hover {
            color: #fff;
            background: #0b63ce;
        }

        .add-detail-button .material-symbols-outlined {
            font-size: 17px;
        }

    .subtask-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .subtask-item {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 11px 13px;
        background: rgba(255, 255, 255, 0.90);
        border: 1px solid #d4ddea;
        border-radius: 11px;
        transition: all 0.2s ease;
    }

        .subtask-item:hover {
            border-color: #a9c8ec;
            transform: translateX(2px);
        }

    .subtask-status-button {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 27px;
        height: 27px;
        padding: 0;
        color: #8290a2;
        background: transparent;
        border: 0;
        border-radius: 50%;
        cursor: pointer;
    }

        .subtask-status-button:hover {
            color: #0b63ce;
        }

        .subtask-status-button.completed {
            color: #29945f;
        }

        .subtask-status-button .material-symbols-outlined {
            font-size: 22px;
        }

    .subtask-text {
        flex: 1;
        color: #354255;
        font-size: 14px;
    }

        .subtask-text.completed {
            color: #8a94a3;
            text-decoration: line-through;
        }

    .subtask-empty {
        padding: 20px;
        color: #7d8999;
        background: rgba(247, 249, 252, 0.9);
        border: 1px dashed #bec9d8;
        border-radius: 11px;
        text-align: center;
        font-size: 13px;
    }

    .settings-panel {
        padding: 21px;
        background: rgba(244, 247, 252, 0.94);
        border: 1px solid #d8e0ec;
        border-radius: 15px;
        box-shadow: 0 8px 22px rgba(41, 61, 94, 0.06);
    }

    .settings-heading {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 18px;
        color: #263244;
        font-size: 15px;
        font-weight: 700;
    }

        .settings-heading .material-symbols-outlined {
            color: #0b63ce;
            font-size: 20px;
        }

    .date-item {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        padding: 13px 0;
        border-bottom: 1px solid #dde4ee;
    }

        .date-item:last-of-type {
            border-bottom: 0;
        }

    .date-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 33px;
        height: 33px;
        color: #0b63ce;
        background: #e7f1ff;
        border-radius: 9px;
    }

        .date-icon .material-symbols-outlined {
            font-size: 19px;
        }

    .date-content span {
        display: block;
        margin-bottom: 3px;
        color: #798596;
        font-size: 11px;
    }

    .date-content strong {
        color: #354255;
        font-size: 13px;
        font-weight: 650;
    }

        .date-content strong.overdue {
            color: #d32f2f;
        }

    .overdue-warning {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-top: 15px;
        padding: 10px 11px;
        color: #b3261e;
        background: #fff0ef;
        border: 1px solid #efc5c2;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 600;
    }

        .overdue-warning .material-symbols-outlined {
            font-size: 18px;
        }

    .complete-button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        width: 100%;
        margin-top: 20px;
        padding: 11px 14px;
        color: #fff;
        background: #0b63ce;
        border: 0;
        border-radius: 22px;
        font-family: inherit;
        font-size: 13px;
        font-weight: 650;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .complete-button:hover {
            background: #0758b9;
            transform: translateY(-1px);
        }

        .complete-button.completed {
            color: #267d52;
            background: #e7f6ee;
            border: 1px solid #bfe2ce;
        }

    @@media (max-width: 900px) {
        .detail-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 650px) {
        .task-detail-page {
            padding: 18px 10px 35px;
        }

        .detail-notebook::before,
        .notebook-holes {
            display: none;
        }

        .detail-content {
            padding: 25px 18px;
        }

        .task-title {
            font-size: 24px;
        }

        .detail-header {
            flex-direction: column;
        }

        .header-actions {
            align-self: flex-end;
        }

        .section-header {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>

<div class="task-detail-page">

    <div class="detail-notebook">

        <div class="notebook-holes"></div>

        <div class="paperclip" aria-hidden="true">
            <span class="material-symbols-outlined">
                attach_file
            </span>
        </div>

        <div class="detail-content">

            <!-- Üst bölüm -->
            <header class="detail-header">

                <div>
                    <a asp-controller="Task"
                           asp-action="Index"
                           class="back-link">
                        <span class="material-symbols-outlined"
                              style="font-size: 17px;">
                            arrow_back
                        </span>
                        Görevlere dön
                    </a>

                    <div>
                        <span class="category-badge">
                            <span class="material-symbols-outlined">
                                label
                            </span>

                            @(Model.TaskList?.Name ?? "Kategorisiz")
                        </span>
                    </div>

                    <div style="display:flex; align-items:center; gap:10px;">

                        <h1 class="task-title @(Model.IsCompleted ? "completed" : "")">
                            @Model.Title
                        </h1>

                        @if (Model.IsImportant)
                        {
                            <span class="material-symbols-outlined important-star"
                                  title="Önemli görev">
                                star
                            </span>
                        }

                    </div>
                </div>

                <div class="header-actions">

                    <a asp-controller="Task"
                           asp-action="EditTask"
                           asp-route-id="@Model.UserTaskId"
                           class="icon-action"
                           title="Görevi düzenle">
                        <span class="material-symbols-outlined">
                            edit
                        </span>
                    </a>

                    <form asp-controller="Task"
                          asp-action="DeleteTask"
                          method="post"
                          onsubmit="return confirm('Bu görevi silmek istediğinize emin misiniz?');">

                        <input type="hidden"
                               name="id"
                               value="@Model.UserTaskId" />

                        <button type="submit"
                                class="icon-action delete"
                                title="Görevi sil">

                            <span class="material-symbols-outlined">
                                delete
                            </span>

                        </button>

                    </form>

                </div>

            </header>

            <div class="detail-grid">

                <!-- Sol içerik -->
                <main>

                    <div class="description-card">

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            @Model.Description
                        }
                        else
                        {
                            <span class="description-empty">
                                Bu görev için bir not eklenmemiş.
                            </span>
                        }

                    </div>

                    <div class="section-header">

                        <h2 class="section-title">

                            <span class="section-title-icon">
                                <span class="material-symbols-outlined">
                                    checklist
                                </span>
                            </span>

                            Ayrıntılar

                            @if (Model.SubTasks != null && Model.SubTasks.Any())
                            {
                                <span style="color:#8390a1; font-size:12px;">
                                    (@Model.SubTasks.Count)
                                </span>
                            }

                        </h2>

                        <button type="button"
                                id="showSubTaskForm"
                                class="add-detail-button">
                            <span class="material-symbols-outlined">
                                add
                            </span>
                            Ayrıntı ekle
                        </button>

                        <div id="subTaskFormContainer"
                             style="display:none; margin-bottom:15px;">

                            <form asp-controller="Task"
                                  asp-action="CreateSubTask"
                                  method="post"
                                  style="display:flex; align-items:center; gap:9px;">

                                <input type="hidden"
                                       name="UserTaskId"
                                       value="@Model.UserTaskId" />

                                <input type="text"
                                       name="Title"
                                       placeholder="Yeni ayrıntı yazın..."
                                       class="subtask-input"
                                       autocomplete="off"
                                       required />

                                <button type="submit"
                                        class="add-detail-button">
                                    <span class="material-symbols-outlined">
                                        check
                                    </span>
                                    Ekle
                                </button>

                                <button type="button"
                                        id="cancelSubTask"
                                        class="remove-subtask">
                                    <span class="material-symbols-outlined">
                                        close
                                    </span>
                                </button>

                            </form>

                        </div>

                    </div>

                    @if (Model.SubTasks != null && Model.SubTasks.Any())
                    {
                        <div class="subtask-list">

                            @foreach (var subTask in Model.SubTasks
                                                            .OrderBy(x => x.CreatedDate))
                            {
                                <div class="subtask-item">

                                    <!-- Tamamlandı durumunu değiştir -->
                                    <form asp-controller="Task"
                                          asp-action="ToggleSubTaskStatus"
                                          method="post">

                                        <input type="hidden"
                                               name="id"
                                               value="@subTask.SubTaskId" />

                                        <button type="submit"
                                                class="subtask-status-button
                                            @(subTask.IsCompleted ? "completed" : "")"
                                                title="Durumu değiştir">

                                            <span class="material-symbols-outlined">
                                                @(subTask.IsCompleted
                                                    ? "check_circle"
                                                    : "radio_button_unchecked")
                                            </span>

                                        </button>

                                    </form>

                                    <!-- Alt görev başlığı -->
                                    <span class="subtask-text
                                        @(subTask.IsCompleted ? "completed" : "")">

                                        @subTask.Title

                                    </span>

                                    <!-- Alt görevi sil -->
                                    <form asp-controller="Task"
                                          asp-action="DeleteSubTask"
                                          method="post"
                                          onsubmit="return confirm('Bu ayrıntıyı silmek istediğinize emin misiniz?');">

                                        <input type="hidden"
                                               name="id"
                                               value="@subTask.SubTaskId" />

                                        <button type="submit"
                                                class="subtask-delete-button"
                                                title="Ayrıntıyı sil">

                                            <span class="material-symbols-outlined">
                                                delete
                                            </span>

                                        </button>

                                    </form>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="subtask-empty">
                            Bu göreve henüz bir ayrıntı eklenmemiş.
                        </div>
                    }

                </main>

                <!-- Sağ bilgi paneli -->
                <aside class="settings-panel">

                    <h2 class="settings-heading">
                        <span class="material-symbols-outlined">
                            event_note
                        </span>
                        Görev bilgileri
                    </h2>

                    <div class="date-item">

                        <div class="date-icon">
                            <span class="material-symbols-outlined">
                                calendar_today
                            </span>
                        </div>

                        <div class="date-content">
                            <span>Oluşturulma tarihi</span>

                            <strong>
                                @Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                            </strong>
                        </div>

                    </div>

                    <div class="date-item">

                        <div class="date-icon">
                            <span class="material-symbols-outlined">
                                event
                            </span>
                        </div>

                        <div class="date-content">
                            <span>Son tarih</span>

                            @if (Model.DueDate.HasValue)
                            {
                                <strong class="@(isOverdue ? "overdue" : "")">
                                    @Model.DueDate.Value.ToString("dd.MM.yyyy HH:mm")
                                </strong>
                            }
                            else
                            {
                                <strong>Belirlenmedi</strong>
                            }
                        </div>

                    </div>

                    <div class="date-item">

                        <div class="date-icon">
                            <span class="material-symbols-outlined">
                                notifications
                            </span>
                        </div>

                        <div class="date-content">
                            <span>Hatırlatma tarihi</span>

                            <strong>
                                @(Model.ReminderDate.HasValue
                                    ? Model.ReminderDate.Value.ToString("dd.MM.yyyy HH:mm")
                                    : "Belirlenmedi")
                            </strong>
                        </div>

                    </div>

                    @if (Model.IsCompleted && Model.CompletedDate.HasValue)
                    {
                        <div class="date-item">

                            <div class="date-icon"
                                 style="color:#278758; background:#e4f5eb;">
                                <span class="material-symbols-outlined">
                                    task_alt
                                </span>
                            </div>

                            <div class="date-content">
                                <span>Tamamlanma tarihi</span>

                                <strong>
                                    @Model.CompletedDate.Value.ToString("dd.MM.yyyy HH:mm")
                                </strong>
                            </div>

                        </div>
                    }

                    @if (isOverdue)
                    {
                        <div class="overdue-warning">
                            <span class="material-symbols-outlined">
                                warning
                            </span>
                            Bu görevin son tarihi geçti.
                        </div>
                    }

                    <form asp-controller="Task"
                          asp-action="ToggleTaskStatus"
                          method="post">

                        <input type="hidden"
                               name="id"
                               value="@Model.UserTaskId" />

                        <button type="submit"
                                class="complete-button
                            @(Model.IsCompleted ? "completed" : "")">

                            <span class="material-symbols-outlined">
                                @(Model.IsCompleted
                                    ? "restart_alt"
                                    : "check_circle")
                            </span>

                            @(Model.IsCompleted
                                ? "Görevi yeniden aç"
                                : "Görevi tamamla")

                        </button>

                    </form>

                </aside>

            </div>

        </div>

    </div>

</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {

        const showButton =
            document.getElementById("showSubTaskForm");

        const formContainer =
            document.getElementById("subTaskFormContainer");

        const cancelButton =
            document.getElementById("cancelSubTask");

        const titleInput =
            formContainer.querySelector("input[name='Title']");

        showButton.addEventListener("click", function () {
            formContainer.style.display = "block";
            showButton.style.display = "none";
            titleInput.focus();
        });

        cancelButton.addEventListener("click", function () {
            formContainer.style.display = "none";
            showButton.style.display = "inline-flex";
            titleInput.value = "";
        });

    });
</script>