@using IdentityEmailApp.Entities
@model List<UserTask>

@{
    ViewData["Title"] = "Silinen Görevler";
    Layout = "~/Views/Task/Layout.cshtml";
}



<!-- Canvas Header -->
<div class="h-14 border-b border-outline-variant flex items-center justify-between px-6 bg-white/50 backdrop-blur-sm">
    <h2 class="font-headline-md text-headline-md text-on-surface">Silinen Görevlerim</h2>
    <button class="p-2 rounded-full hover:bg-surface-container text-on-surface-variant transition-colors">
        <span class="material-symbols-outlined">more_vert</span>
    </button>
</div>
<!-- Empty State Content -->
@if (Model == null || !Model.Any())
{
    <div class="flex-1 flex flex-col items-center justify-center p-8 text-center">

        <div class="w-48 h-48 mb-8 opacity-80">
            <div class="relative w-full h-full flex items-center justify-center">
                <div class="absolute w-32 h-24 bg-surface-container rounded-lg border border-outline-variant transform -rotate-6"></div>

                <div class="absolute w-32 h-24 bg-white rounded-lg border border-outline-variant transform rotate-3 flex items-center justify-center shadow-sm">
                    <span class="material-symbols-outlined text-4xl text-outline-variant">
                        check_circle
                    </span>
                </div>

                <div class="absolute -top-4 right-8 w-10 h-10 bg-primary-container rounded-full flex items-center justify-center">
                    <span class="material-symbols-outlined text-on-primary-container text-sm">
                        done
                    </span>
                </div>
            </div>
        </div>

        <h3>Silinen göreviniz yok</h3>

        <p>
            Sildiğiniz görevler burada görüntülenir.
        </p>
       
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">

        @foreach (var task in Model)
        {
            var isOverdue =
                task.DueDate.HasValue &&
                task.DueDate.Value < DateTime.Now &&
                !task.IsCompleted;

            <div class="relative bg-white border border-outline-variant
                rounded-2xl p-5 shadow-sm transition-all">

                <!-- Silinen görev etiketi -->
                <div class="absolute top-0 left-0 right-0 h-1
                    bg-red-400 rounded-t-2xl">
                </div>

                <!-- Kategori, silindi rozeti ve yıldız -->
                <div class="flex items-start justify-between gap-3 mb-4">

                    <div class="flex flex-wrap items-center gap-2">

                        <span class="inline-flex items-center gap-1.5 px-3 py-1
                            rounded-full bg-blue-100 text-blue-700
                            text-xs font-semibold">

                            <span class="material-symbols-outlined text-sm">
                                label
                            </span>

                            @(task.TaskList?.Name ?? "Kategorisiz")
                        </span>

                        <span class="inline-flex items-center gap-1 px-3 py-1
                            rounded-full bg-red-50 text-red-600
                            text-xs font-semibold">

                            <span class="material-symbols-outlined text-sm">
                                delete
                            </span>

                            Silindi
                        </span>

                    </div>

                    @if (task.IsImportant)
                    {
                        <span class="material-symbols-outlined
                            text-yellow-500 text-3xl drop-shadow-sm"
                              title="Önemli görev"
                              style="font-variation-settings:
                            'FILL' 1,
                            'wght' 500,
                            'GRAD' 0,
                            'opsz' 32;">
                            star
                        </span>
                    }

                </div>

                <!-- Ana görev -->
                <h3 class="text-xl font-bold text-on-surface leading-snug
                    @(task.IsCompleted
                                            ? "line-through opacity-60"
                                            : "")">
                    @task.Title
                </h3>

                <!-- Açıklama -->
                @if (!string.IsNullOrWhiteSpace(task.Description))
                {
                    <p class="mt-3 text-sm text-on-surface-variant
                        line-clamp-3">
                        @task.Description
                    </p>
                }

                <!-- Alt görevler -->
                @if (task.SubTasks != null && task.SubTasks.Any())
                {
                    <ul class="mt-5 space-y-3">

                        @foreach (var subTask in task.SubTasks)
                        {
                            <li class="flex items-start gap-3 text-sm">

                                <span class="material-symbols-outlined text-xl
                                    @(subTask.IsCompleted
                                                                              ? "text-green-600"
                                                                              : "text-outline")">

                                    @(subTask.IsCompleted
                                        ? "check_circle"
                                        : "radio_button_unchecked")
                                </span>

                                <span class="text-on-surface-variant
                                    @(subTask.IsCompleted
                                                                              ? "line-through opacity-60"
                                                                              : "")">
                                    @subTask.Title
                                </span>

                            </li>
                        }

                    </ul>
                }
                else
                {
                    <p class="mt-4 text-sm italic text-on-surface-variant">
                        Bu göreve ayrıntı eklenmemiş.
                    </p>
                }

                <!-- Tarihler -->
                <div class="mt-6 pt-4 border-t border-outline-variant
                    grid grid-cols-1 sm:grid-cols-2 gap-3">

                    <!-- Oluşturulma tarihi -->
                    <div class="flex items-start gap-2">

                        <span class="material-symbols-outlined text-lg
                            text-on-surface-variant">
                            calendar_today
                        </span>

                        <div>
                            <span class="block text-[11px]
                                text-on-surface-variant">
                                Oluşturulma tarihi
                            </span>

                            <strong class="block mt-0.5 text-xs
                                text-on-surface font-medium">
                                @task.CreatedDate.ToString("dd MMM yyyy HH:mm")
                            </strong>
                        </div>

                    </div>

                    <!-- Bitiş tarihi -->
                    <div class="flex items-start gap-2">

                        <span class="material-symbols-outlined text-lg
                            @(isOverdue
                                                              ? "text-red-600"
                                                              : task.IsCompleted
                                                                  ? "text-green-600"
                                                                  : "text-blue-600")">

                            @(isOverdue
                                ? "event_busy"
                                : task.IsCompleted
                                    ? "event_available"
                                    : "event")
                        </span>

                        <div>
                            <span class="block text-[11px]
                                text-on-surface-variant">
                                Bitiş tarihi
                            </span>

                            @if (task.DueDate.HasValue)
                            {
                                <strong class="block mt-0.5 text-xs
                                    font-medium
                                    @(isOverdue
                                                                                ? "text-red-600"
                                                                                : task.IsCompleted
                                                                                    ? "text-green-600"
                                                                                    : "text-blue-600")">

                                    @task.DueDate.Value.ToString("dd MMM yyyy HH:mm")
                                </strong>
                            }
                            else
                            {
                                <strong class="block mt-0.5 text-xs
                                    font-medium
                                    text-on-surface-variant">
                                    Belirlenmedi
                                </strong>
                            }
                        </div>

                    </div>

                </div>

                <!-- İşlem butonları -->
                <div class="mt-5 pt-4 border-t border-outline-variant
                    flex flex-wrap items-center justify-end gap-2">

                    <!-- Geri yükle -->
                    <form asp-controller="Task"
                          asp-action="RestoreTask"
                          method="post">

                        <input type="hidden"
                               name="id"
                               value="@task.UserTaskId" />

                        <button type="submit"
                                class="inline-flex items-center gap-1.5
                            px-4 py-2 rounded-full bg-green-50
                            border border-green-200 text-green-700
                            text-xs font-semibold
                            hover:bg-green-100 transition-colors">

                            <span class="material-symbols-outlined text-lg">
                                restore
                            </span>

                            Geri Yükle
                        </button>

                    </form>

                    <!-- Kalıcı sil -->
                    <form asp-controller="Task"
                          asp-action="PermanentDeleteTask"
                          method="post"
                          onsubmit="return confirm('Bu görev kalıcı olarak silinecek. Bu işlem geri alınamaz. Devam etmek istiyor musunuz?');">

                        <input type="hidden"
                               name="id"
                               value="@task.UserTaskId" />

                        <button type="submit"
                                class="inline-flex items-center gap-1.5
                            px-4 py-2 rounded-full bg-red-50
                            border border-red-200 text-red-600
                            text-xs font-semibold
                            hover:bg-red-100 transition-colors">

                            <span class="material-symbols-outlined text-lg">
                                delete_forever
                            </span>

                            Kalıcı Sil
                        </button>

                    </form>

                </div>

            </div>
        }

    </div>
}